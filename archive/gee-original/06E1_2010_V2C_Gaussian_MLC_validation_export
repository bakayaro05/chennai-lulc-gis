// ============================================================================
// 5. BUILD GAUSSIAN PARAMETERS FOR ONE CLASS
// ============================================================================

function buildClassParameters(
  classId
) {

  var classSamples =
    training2010.filter(
      ee.Filter.eq(
        'class_id',
        classId
      )
    );


  // --------------------------------------------------------------------------
  // MEAN VECTOR
  //
  // Initially 1 x 9.
  // Transpose -> 9 x 1.
  // --------------------------------------------------------------------------

  var meanValues =
    PREDICTORS.map(
      function(bandName) {

        return classSamples.aggregate_mean(
          bandName
        );

      }
    );


  var meanVector =
    ee.Array([
      meanValues
    ])
    .transpose();


  // --------------------------------------------------------------------------
  // COVARIANCE
  //
  // Each feature gets one nine-element array.
  // covariance() reduces those sample vectors into a 9 x 9 matrix.
  // --------------------------------------------------------------------------

  var samplesWithArray =
    classSamples.makeArray(
      PREDICTORS,
      'mlc_array'
    );


  var covarianceDictionary =
    samplesWithArray.reduceColumns({

      reducer:
        ee.Reducer
          .covariance()
          .setOutputs([
            'covariance'
          ]),

      selectors: [
        'mlc_array'
      ]

    });


  var rawCovariance =
    ee.Array(
      covarianceDictionary.get(
        'covariance'
      )
    );


  // --------------------------------------------------------------------------
  // DIAGONAL REGULARIZATION
  //
  // Sigma_regularized = Sigma + 1e-6 I
  // --------------------------------------------------------------------------

  var identity =
    ee.Array.identity(
      NUM_PREDICTORS
    );


  var regularizedCovariance =
    rawCovariance.add(
      identity.multiply(
        REGULARIZATION
      )
    );


  // --------------------------------------------------------------------------
  // DETERMINANTS
  // --------------------------------------------------------------------------

  var rawDeterminant =
    rawCovariance.matrixDeterminant();


  var regularizedDeterminant =
    regularizedCovariance.matrixDeterminant();


  // --------------------------------------------------------------------------
  // INVERSE
  // --------------------------------------------------------------------------

  var inverseCovariance =
    regularizedCovariance.matrixInverse();


  return ee.Dictionary({

    class_id:
      classId,

    sample_count:
      classSamples.size(),

    mean:
      meanVector,

    raw_covariance:
      rawCovariance,

    covariance:
      regularizedCovariance,

    raw_determinant:
      rawDeterminant,

    determinant:
      regularizedDeterminant,

    inverse:
      inverseCovariance

  });

}


