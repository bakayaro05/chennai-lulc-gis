// 17. CORRECT / INCORRECT COUNTS
// ============================================================================

var predictionsWithCorrect =
  validationPredictions.map(
    function(feature) {

      feature =
        ee.Feature(
          feature
        );


      var actual =
        ee.Number(
          feature.get(
            'class_id'
          )
        );


      var predicted =
        ee.Number(
          feature.get(
            'classification'
          )
        );


      var correct =
        ee.Number(
          ee.Algorithms.If(
            actual.eq(
              predicted
            ),
            1,
            0
          )
        );


      return feature.set(
        'correct',
        correct
      );

    }
  );


var correctCount =
  predictionsWithCorrect

    .filter(
      ee.Filter.eq(
        'correct',
        1
