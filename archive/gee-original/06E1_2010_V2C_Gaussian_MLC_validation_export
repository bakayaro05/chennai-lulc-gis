// ============================================================================
// 8. CREATE 9 x 1 PREDICTOR ARRAY IMAGE
// ============================================================================
//
// stack.select(...).toArray()
//     -> [9]
//
// .toArray(1)
//     -> [9,1]
//
// ============================================================================

var predictorColumn =
  stack2010

    .select(
      PREDICTORS
    )

    .toArray()

    .toArray(1);


// ============================================================================
// 9. GAUSSIAN LOG-LIKELIHOOD SCORE FUNCTION
// ============================================================================

function createScoreImage(
  classParameters,
  scoreBandName
) {

  classParameters =
    ee.Dictionary(
      classParameters
    );


  var meanVector =
    ee.Array(
      classParameters.get(
        'mean'
      )
    );


  var inverseCovariance =
    ee.Array(
      classParameters.get(
        'inverse'
      )
    );


  var determinant =
    ee.Number(
      classParameters.get(
        'determinant'
      )
    )
    .max(
      1e-300
    );


  // --------------------------------------------------------------------------
  // Convert constant matrices to array images
  // --------------------------------------------------------------------------

  var meanImage =
    ee.Image.constant(
      meanVector
    );


  var inverseImage =
    ee.Image.constant(
      inverseCovariance
    );


  // --------------------------------------------------------------------------
  // Difference:
  //
  // d = x - mu
  // --------------------------------------------------------------------------

  var difference =
    predictorColumn.subtract(
      meanImage
    );


  // --------------------------------------------------------------------------
  // Mahalanobis quadratic form:
  //
  // d' Sigma^-1 d
  // --------------------------------------------------------------------------

  var mahalanobisSquared =
    difference

      .arrayTranspose()

      .matrixMultiply(
        inverseImage
      )

      .matrixMultiply(
        difference
      )

      .arrayGet(
        [0, 0]
      );


  // --------------------------------------------------------------------------
  // Gaussian log-likelihood:
  //
  // -0.5 ln|Sigma|
  // -0.5 d' Sigma^-1 d
  //
  // --------------------------------------------------------------------------

  var logDeterminant =
    ee.Image.constant(
      determinant.log()
    );


  var score =
    mahalanobisSquared

      .multiply(
        -0.5
      )

      .add(
        logDeterminant.multiply(
          -0.5
        )
      )

      .rename(
        scoreBandName
      );


  return score;

}


