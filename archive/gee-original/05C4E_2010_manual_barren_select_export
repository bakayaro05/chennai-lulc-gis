// ================================================================
// CHENNAI MULTI-TEMPORAL LULC PROJECT
// SCRIPT 05C4E
//
// SELECT + MATERIALIZE 61 MANUAL BARREN/FALLOW PIXELS
//
// SOURCE:
// Manually reviewed polygon 304.
//
// ELIGIBILITY:
// - clear_count >= 2
// - new pixel, not already in candidate pool
// - nearest native-2010 class = Barren/Fallow
// - class margin >= 0.25
// - >= 5 valid neighbours
// - local agreement >= 5/9
//
// IMPORTANT:
// Historical standardized-distance <= 1.25 is NOT required here,
// because polygon 304 is an independently manually reviewed
// additional Barren/Fallow subtype.
//
// EXACTLY 61 pixels are selected reproducibly.
//
// OUTPUT:
// chennai_2010_manual_barren_05C4E
//
// NO validation.
// NO final training yet.
// NO MLC.
// NO map layers.
// ================================================================


// ================================================================
// 1. REQUIRED IMPORT
// ================================================================

barrenAdd2010;


// ================================================================
// 2. ASSETS
// ================================================================

var STACK_ASSET =
  'projects/assignment-482806/assets/chennai_predictor_stack_2010';

var QA_05A_ASSET =
  'projects/assignment-482806/assets/chennai_transfer_2015_to_2010_QA_05A';

var PASSB_ASSET =
  'projects/assignment-482806/assets/chennai_2010_passB_reQA_05C1';

var RESCUED_ASSET =
  'projects/assignment-482806/assets/chennai_2010_rescued_uncertain_05C2A';

var EXPANSION_ASSET =
  'projects/assignment-482806/assets/chennai_2010_targeted_expansion_05C3A';

var OUTPUT_ASSET =
  'projects/assignment-482806/assets/chennai_2010_manual_barren_05C4E';


// ================================================================
// 3. SETTINGS
// ================================================================

var SCALE = 30;

var BARREN_CLASS_ID = 5;

var REQUIRED_NEW_BARREN = 61;

var SELECTION_SEED = 2010304;

var MARGIN_THRESHOLD = 0.25;

var MIN_CLEAR = 2;

var MIN_LOCAL_VALID = 5;

var MIN_LOCAL_FRACTION = 5 / 9;

var EPSILON = 1e-6;


var PREDICTORS = [

  'blue',
  'green',
  'red',
  'nir',
  'swir1',
  'swir2',
  'NDVI',
  'NDWI',
  'NDBI'

];


var CLASS_IDS =
  [1, 2, 3, 4, 5];


// ================================================================
// 4. LOAD MATERIALIZED DATA
// ================================================================

var stack2010 =
  ee.Image(
    STACK_ASSET
  );


var qa05A =
  ee.FeatureCollection(
    QA_05A_ASSET
  );


var passB =
  ee.FeatureCollection(
    PASSB_ASSET
  );


var rescued =
  ee.FeatureCollection(
    RESCUED_ASSET
  );


var expansion60 =
  ee.FeatureCollection(
    EXPANSION_ASSET
  );


var currentCandidates =
  passB

    .merge(
      rescued
    )

    .merge(
      expansion60
    )

    .distinct(
      [
        'auth_pixel_key'
      ]
    );


var stackProjection =
  stack2010
    .select(
      'blue'
    )
    .projection();


// ================================================================
// 5. EXTRACT ONLY ORIGINAL POLYGON 304
// ================================================================

var parts =
  ee.Geometry(
    barrenAdd2010
  )
  .geometries();


var geometry304 =
  ee.Geometry(
    parts.get(
      3
    )
  );


var polygon304 =
  ee.FeatureCollection([

    ee.Feature(
      geometry304,
      {

        class_id:
          5,

        class_name:
          'Barren/Fallow',

        poly_id:
          304,

        source:
          'manual_2010_barren_304'

      }
    )

  ]);


// ================================================================
// 6. REBUILD 2010-NATIVE SIGNATURES
// ================================================================

var stableAnchors =
  qa05A.filter(
    ee.Filter.eq(
      'transfer_status',
      'STABLE'
    )
  );


var nativeSeeds =
  stack2010
    .select(
      PREDICTORS
    )
    .sampleRegions({

      collection:
        stableAnchors,

      properties: [
        'class_id'
      ],

      scale:
        SCALE,

      projection:
        stackProjection,

      geometries:
        false,

      tileScale:
        4

    });


function buildSignature(classId) {

  var fc =
    nativeSeeds.filter(
      ee.Filter.eq(
        'class_id',
        classId
      )
    );


  var means =
    PREDICTORS.map(
      function(band) {

        return ee.Number(
          fc.aggregate_mean(
            band
          )
        );

      }
    );


  var sds =
    PREDICTORS.map(
      function(band) {

        return ee.Number(
          fc.aggregate_sample_sd(
            band
          )
        )
        .max(
          EPSILON
        );

      }
    );


  return ee.Feature(
    null,
    {

      class_id:
        classId,

      means:
        ee.List(
          means
        ),

      sds:
        ee.List(
          sds
        )

    }
  );

}


var signatures =
  ee.FeatureCollection(
    CLASS_IDS.map(
      buildSignature
    )
  );


// ================================================================
// 7. DISTANCE FUNCTION
// ================================================================

function distanceToClass(
  image,
  classId
) {

  var signature =
    ee.Feature(
      signatures
        .filter(
          ee.Filter.eq(
            'class_id',
            classId
          )
        )
        .first()
    );


  var meanImage =
    ee.Image.constant(
      ee.List(
        signature.get(
          'means'
        )
      )
    )
    .rename(
      PREDICTORS
    );


  var sdImage =
    ee.Image.constant(
      ee.List(
        signature.get(
          'sds'
        )
      )
    )
    .rename(
      PREDICTORS
    )
    .max(
      EPSILON
    );


  return image
    .select(
      PREDICTORS
    )
    .subtract(
      meanImage
    )
    .divide(
      sdImage
    )
    .pow(2)
    .reduce(
      ee.Reducer.mean()
    )
    .sqrt()
    .rename(
      'd' + classId
    );

}


// ================================================================
// 8. FIVE DISTANCE IMAGES
// ================================================================

var d1 = distanceToClass(stack2010, 1);
var d2 = distanceToClass(stack2010, 2);
var d3 = distanceToClass(stack2010, 3);
var d4 = distanceToClass(stack2010, 4);
var d5 = distanceToClass(stack2010, 5);


var distanceImages = [

  d1,
  d2,
  d3,
  d4,
  d5

];


var distanceStack =
  ee.Image.cat(
    distanceImages
  );


// ================================================================
// 9. BEST + SECOND-BEST CLASS
// ================================================================

var bestDist =
  d1.rename(
    'best_dist'
  );


var bestClass =
  ee.Image.constant(
    1
  )
  .rename(
    'best_class'
  )
  .updateMask(
    d1.mask()
  );


var secondDist =
  ee.Image.constant(
    9999
  )
  .rename(
    'second_dist'
  )
  .updateMask(
    d1.mask()
  );


for (
  var i = 1;
  i < CLASS_IDS.length;
  i++
) {

  var currentClass =
    CLASS_IDS[i];


  var currentDistance =
    distanceImages[i];


  var better =
    currentDistance.lt(
      bestDist
    );


  var previousBest =
    bestDist;


  var updatedSecond =
    secondDist.where(
      better,
      previousBest
    );


  var currentAsSecond =
    currentDistance.where(
      better,
      9999
    );


  updatedSecond =
    updatedSecond.min(
      currentAsSecond
    );


  bestDist =
    previousBest
      .where(
        better,
        currentDistance
      )
      .rename(
        'best_dist'
      );


  bestClass =
    bestClass
      .where(
        better,
        currentClass
      )
      .rename(
        'best_class'
      );


  secondDist =
    updatedSecond
      .rename(
        'second_dist'
      );

}


var margin =
  secondDist
    .subtract(
      bestDist
    )
    .rename(
      'margin'
    );


// ================================================================
// 10. LOCAL CONSISTENCY
// ================================================================

var kernel3x3 =
  ee.Kernel.square({

    radius:
      1,

    units:
      'pixels',

    normalize:
      false

  });


var localValidN =
  bestClass
    .reduceNeighborhood({

      reducer:
        ee.Reducer.count(),

      kernel:
        kernel3x3,

      skipMasked:
        true

    })
    .rename(
      'local_valid_n'
    );


var localSameN =
  ee.Image.constant(
    0
  )
  .rename(
    'local_same_n'
  )
  .updateMask(
    bestClass.mask()
  );


CLASS_IDS.forEach(
  function(classId) {

    var neighbourCount =
      bestClass
        .eq(
          classId
        )
        .reduceNeighborhood({

          reducer:
            ee.Reducer.sum(),

          kernel:
            kernel3x3,

          skipMasked:
            true

        });


    localSameN =
      localSameN.where(

        bestClass.eq(
          classId
        ),

        neighbourCount

      );

  }
);


var localFraction =
  localSameN
    .divide(
      localValidN.max(
        1
      )
    )
    .rename(
      'local_fraction'
    );


// ================================================================
// 11. AUTHORITATIVE PIXEL COORDINATES
// ================================================================

var pixelXY =
  ee.Image.pixelCoordinates(
    stackProjection
  )
  .rename(
    [
      'auth_px',
      'auth_py'
    ]
  );


// ================================================================
// 12. QA IMAGE
// ================================================================

var qaImage =
  stack2010
    .select(
      PREDICTORS
    )

    .addBands(
      distanceStack
    )

    .addBands(
      bestClass
    )

    .addBands(
      margin
    )

    .addBands(
      stack2010.select(
        'clear_count'
      )
    )

    .addBands(
      localValidN
    )

    .addBands(
      localFraction
    )

    .addBands(
      pixelXY
    );


// ================================================================
// 13. SAMPLE POLYGON 304
// ================================================================

var samples304 =
  qaImage.sampleRegions({

    collection:
      polygon304,

    properties: [
      'class_id',
      'class_name',
      'poly_id',
      'source'
    ],

    scale:
      SCALE,

    projection:
      stackProjection,

    geometries:
      true,

    tileScale:
      4

  });


// ================================================================
// 14. PIXEL KEY + DEDUP
// ================================================================

samples304 =
  samples304.map(
    function(feature) {

      var px =
        ee.Number(
          feature.get(
            'auth_px'
          )
        );


      var py =
        ee.Number(
          feature.get(
            'auth_py'
          )
        );


      var key =
        px.format(
          '%.0f'
        )
        .cat(
          '_'
        )
        .cat(
          py.format(
            '%.0f'
          )
        );


      return feature.set(
        'auth_pixel_key',
        key
      );

    }
  )
  .distinct(
    [
      'auth_pixel_key'
    ]
  );


// ================================================================
// 15. EXISTING-POOL FLAG
// ================================================================

var currentKeys =
  ee.List(
    currentCandidates.aggregate_array(
      'auth_pixel_key'
    )
  );


samples304 =
  samples304.map(
    function(feature) {

      var duplicate =
        currentKeys.contains(
          feature.get(
            'auth_pixel_key'
          )
        );


      return feature.set(
        'already_exists',

        ee.Number(
          ee.Algorithms.If(
            duplicate,
            1,
            0
          )
        )

      );

    }
  );


// ================================================================
// 16. LEVEL-3 ACCEPTANCE
// ================================================================

var evaluated304 =
  samples304.map(
    function(feature) {

      var pass =
        ee.Number(
          feature.get(
            'clear_count'
          )
        )
        .gte(
          MIN_CLEAR
        )

        .and(
          ee.Number(
            feature.get(
              'already_exists'
            )
          )
          .eq(
            0
          )
        )

        .and(
          ee.Number(
            feature.get(
              'best_class'
            )
          )
          .eq(
            BARREN_CLASS_ID
          )
        )

        .and(
          ee.Number(
            feature.get(
              'margin'
            )
          )
          .gte(
            MARGIN_THRESHOLD
          )
        )

        .and(
          ee.Number(
            feature.get(
              'local_valid_n'
            )
          )
          .gte(
            MIN_LOCAL_VALID
          )
        )

        .and(
          ee.Number(
            feature.get(
              'local_fraction'
            )
          )
          .gte(
            MIN_LOCAL_FRACTION
          )
        );


      return feature.set({

        manual_level3:
          ee.Number(
            ee.Algorithms.If(
              pass,
              1,
              0
            )
          ),

        selection_method:
          'manual304_level3',

        target_year:
          2010

      });

    }
  );


var level3Candidates =
  evaluated304.filter(
    ee.Filter.eq(
      'manual_level3',
      1
    )
  );


// ================================================================
// 17. SELECT EXACTLY 61 REPRODUCIBLY
// ================================================================

var selectedManualBarren =
  level3Candidates

    .randomColumn(
      'manual_selection_random',
      SELECTION_SEED
    )

    .sort(
      'manual_selection_random'
    )

    .limit(
      REQUIRED_NEW_BARREN
    );


// ================================================================
// 18. FINAL QA
// ================================================================

print(
  '========================================'
);

print(
  '05C4E — MANUAL BARREN SELECTION'
);

print(
  '========================================'
);


print(
  ee.Dictionary({

    level3_available:
      level3Candidates.size(),

    required:
      REQUIRED_NEW_BARREN,

    selected:
      selectedManualBarren.size(),

    selected_poly_histogram:
      selectedManualBarren.aggregate_histogram(
        'poly_id'
      )

  })
);


print(
  'Selected class histogram'
);


print(
  selectedManualBarren.aggregate_histogram(
    'class_id'
  )
);


print(
  'Selected mean margin'
);


print(
  selectedManualBarren.aggregate_mean(
    'margin'
  )
);


print(
  'Selected mean local fraction'
);


print(
  selectedManualBarren.aggregate_mean(
    'local_fraction'
  )
);


