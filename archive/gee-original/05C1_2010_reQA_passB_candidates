Export.table.toAsset({

  collection:
    acceptedFinal,

  description:
    'chennai_2010_passB_reQA_05C1',

  assetId:
    OUTPUT_ASSET

});


print(
  '========================================'
);

print(
  '05C1 SCRIPT FINISHED'
);

