// ================================================================
// SHOW SELECTED GROUP
// ================================================================

function showSelectedGroup() {

  var classValue =
    classSelect.getValue();


  var polyValue =
    polySelect.getValue();


  if (
    classValue === null ||
    polyValue === null
  ) {

    return;

  }


  var classId =
    Number(
      classValue
    );


  var polyId =
    Number(
      polyValue
    );


  var selectedGroup =
    transfer05A

      .filter(
        ee.Filter.eq(
          'class_id',
          classId
        )
      )

      .filter(
        ee.Filter.eq(
          'poly_id',
          polyId
        )
      );


  var selectedStable =
    selectedGroup.filter(
      ee.Filter.eq(
        'transfer_status',
        'STABLE'
      )
    );


  var selectedUncertain =
    selectedGroup.filter(
      ee.Filter.eq(
        'transfer_status',
        'UNCERTAIN'
      )
    );


  var selectedChanged =
    selectedGroup.filter(
      ee.Filter.eq(
        'transfer_status',
        'CHANGED'
      )
    );


  selectedStableLayer.setEeObject(

    selectedStable.style({

      color:
        '00ff00',

      pointSize:
        8,

      width:
        2

    })

  );


  selectedUncertainLayer.setEeObject(

    selectedUncertain.style({

      color:
        'ffff00',

      pointSize:
        8,

      width:
        2

    })

  );


  selectedChangedLayer.setEeObject(

    selectedChanged.style({

      color:
        'ff0000',

      pointSize:
        8,

      width:
        2

    })

  );


  Map.centerObject(
    selectedGroup,
    15
  );


  var summary =
    ee.Dictionary({

      class_id:
        classId,

      poly_id:
        polyId,

      total_n:
        selectedGroup.size(),

      stable_n:
        selectedStable.size(),

      uncertain_n:
        selectedUncertain.size(),

      changed_n:
        selectedChanged.size()

    });


  summary.evaluate(
    function(result) {

      summaryLabel.setValue(

        'Class ID: ' +
        result.class_id +

        '\npoly_id: ' +
        result.poly_id +

        '\nTotal points: ' +
        result.total_n +

        '\nStable: ' +
        result.stable_n +

        '\nUncertain: ' +
        result.uncertain_n +

        '\nChanged: ' +
        result.changed_n

      );

    }
  );

}


// ================================================================
// UPDATE POLY_ID LIST WHEN CLASS CHANGES
// ================================================================

function updatePolyOptions() {

  var classValue =
    classSelect.getValue();


  var classId =
    Number(
      classValue
    );


  var polyIds =
    transfer05A

      .filter(
        ee.Filter.eq(
          'class_id',
          classId
        )
      )

      .aggregate_array(
        'poly_id'
      )

      .distinct()

      .sort();


  polyIds.evaluate(
    function(values) {

      var stringValues =
        values.map(
          function(value) {

            return String(
              value
            );

          }
        );


      polySelect.items().reset(
        stringValues
      );


      if (
        stringValues.length > 0
      ) {

        polySelect.setValue(
          stringValues[0],
          true
        );

      }

    }
  );

}


