// ================================================================
// 4. BUILD PER-POLY_ID REVIEW SUMMARY
// ================================================================
//
// One summary row per original source training polygon.
//
// These summaries DO NOT make acceptance decisions.
//
// ================================================================

var groupKeys =
  transfer05A
    .distinct(
      [
        'class_id',
        'poly_id'
      ]
    );


var groupList =
  groupKeys.toList(
    groupKeys.size()
  );


var groupIndices =
  ee.List.sequence(
    0,
    groupKeys.size().subtract(1)
  );


var perPolySummary =
  ee.FeatureCollection(

    groupIndices.map(
      function(index) {

        index =
          ee.Number(index);


        var keyFeature =
          ee.Feature(
            groupList.get(index)
          );


        var classId =
          keyFeature.get(
            'class_id'
          );


        var polyId =
          keyFeature.get(
            'poly_id'
          );


        var group =
          transfer05A

            .filter(
              ee.Filter.eq(
                'class_id',
                classId
              )
            )

            .filter(
              ee.Filter.eq(
                'poly_id',
                polyId
              )
            );


        var stableN =
          group
            .filter(
              ee.Filter.eq(
                'transfer_status',
                'STABLE'
              )
            )
            .size();


        var uncertainN =
          group
            .filter(
              ee.Filter.eq(
                'transfer_status',
                'UNCERTAIN'
              )
            )
            .size();


        var changedN =
          group
            .filter(
              ee.Filter.eq(
                'transfer_status',
                'CHANGED'
              )
            )
            .size();


        var noDataN =
          group
            .filter(
              ee.Filter.eq(
                'transfer_status',
                'NO_DATA'
              )
            )
            .size();


        var totalN =
          group.size();


        var stableFraction =
          ee.Number(
            stableN
          )
          .divide(
            totalN
          );


        return ee.Feature(
          group.geometry().convexHull(30),
          {

            class_id:
              classId,

            class_name:
              keyFeature.get(
                'class_name'
              ),

            poly_id:
              polyId,

            total_n:
              totalN,

            stable_n:
              stableN,

            uncertain_n:
              uncertainN,

            changed_n:
              changedN,

            no_data_n:
              noDataN,

            stable_fraction:
              stableFraction

          }
        );

      }
    )

  )
  .sort(
    'class_id'
  );


