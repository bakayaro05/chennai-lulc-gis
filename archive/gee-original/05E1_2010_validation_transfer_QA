  );


// ================================================================
// 9. ROBUST WITHIN-YEAR NORMALIZATION STATISTICS
// ================================================================
//
// Percentiles are derived separately for each year over the
// SAME fixed Chennai ROI.
//
// robust scale = IQR / 1.349
//
// ================================================================

function getRobustStats(
  image
) {

  return image
    .select(
      PREDICTORS
    )
    .reduceRegion({

      reducer:
        ee.Reducer.percentile(
          [
            25,
            50,
            75
          ]
        ),

      geometry:
        roi,

      scale:
        SCALE,

      crs:
        ANALYSIS_CRS,

      maxPixels:
        1e8,

      tileScale:
        4

    });

}


var stats2015 =
  getRobustStats(
    stack2015
  );


var stats2010 =
  getRobustStats(
    stack2010
  );


// ================================================================
// 10. ROBUST NORMALIZATION FUNCTION
// ================================================================

function robustNormalize(
  image,
  stats
) {

  var medians =
    PREDICTORS.map(
      function(band) {

        return ee.Number(
          stats.get(
            band + '_p50'
          )
        );

      }
    );


  var scales =
    PREDICTORS.map(
      function(band) {

        var p25 =
          ee.Number(
            stats.get(
              band + '_p25'
            )
          );


        var p75 =
          ee.Number(
            stats.get(
              band + '_p75'
            )
          );


        return p75
          .subtract(
            p25
          )
          .divide(
            1.349
          )
          .max(
            EPSILON
          );

      }
    );


  var medianImage =
    ee.Image.constant(
      medians
    )
    .rename(
      PREDICTORS
    );


  var scaleImage =
    ee.Image.constant(
      scales
    )
    .rename(
      PREDICTORS
    );


  return image

    .select(
      PREDICTORS
    )

    .subtract(
      medianImage
    )

    .divide(
      scaleImage
    )

    .rename(
      PREDICTORS
    );

}


var normalized2015 =
  robustNormalize(
    stack2015,
    stats2015
  );


var normalized2010 =
  robustNormalize(
    stack2010,
    stats2010
  );


// ================================================================
// 11. SAMPLE NORMALIZED 2015 VALIDATION REFERENCE
