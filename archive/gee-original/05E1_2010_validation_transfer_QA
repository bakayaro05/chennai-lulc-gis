// ================================================================
// 12. BUILD 2015 VALIDATION-DERIVED CLASS SIGNATURES
// ================================================================
//
// For every class:
//
// mean vector
// sample SD vector
//
// These are calculated in ROBUST NORMALIZED feature space.
//
// ================================================================

function buildValidationSignature(
  classId
) {

  var classSamples =
    validationReference2015.filter(
      ee.Filter.eq(
        'class_id',
        classId
      )
    );


  var means =
    PREDICTORS.map(
      function(band) {

        return ee.Number(
          classSamples.aggregate_mean(
            band
          )
        );

      }
    );


  var sds =
    PREDICTORS.map(
      function(band) {

        return ee.Number(
          classSamples.aggregate_sample_sd(
            band
          )
        )
        .max(
          EPSILON
        );

      }
    );


  return ee.Feature(
    null,
    {

      class_id:
        classId,

      means:
        ee.List(
          means
        ),

      sds:
        ee.List(
          sds
        ),

      n:
        classSamples.size()

    }
  );

}


var validationSignatures =
  ee.FeatureCollection(
    CLASS_IDS.map(
      buildValidationSignature
    )
  );


print(
  '2015 validation-derived normalized signatures'
);


print(
  validationSignatures
);


// ================================================================
// 13. STANDARDIZED DISTANCE TO EACH CLASS
// ================================================================

function distanceToClass(
  normalizedImage,
  classId
) {

  var signature =
    ee.Feature(
      validationSignatures

        .filter(
          ee.Filter.eq(
            'class_id',
            classId
          )
        )

        .first()
    );


  var meanImage =
    ee.Image.constant(
      ee.List(
        signature.get(
          'means'
        )
      )
    )
    .rename(
      PREDICTORS
    );


  var sdImage =
    ee.Image.constant(
      ee.List(
        signature.get(
          'sds'
        )
      )
    )
    .rename(
      PREDICTORS
    )
    .max(
      EPSILON
    );


  return normalizedImage

    .select(
      PREDICTORS
    )

    .subtract(
      meanImage
    )

    .divide(
      sdImage
    )

    .pow(
      2
    )

    .reduce(
      ee.Reducer.mean()
    )

    .sqrt()

    .rename(
      'd' + classId
    );

}


// ================================================================
// 14. 2010 CLASS-DISTANCE IMAGES
// ================================================================

var d1 =
  distanceToClass(
    normalized2010,
    1
  );


var d2 =
  distanceToClass(
    normalized2010,
    2
  );


var d3 =
  distanceToClass(
    normalized2010,
    3
  );


var d4 =
  distanceToClass(
    normalized2010,
    4
  );


var d5 =
  distanceToClass(
    normalized2010,
    5
  );


var distanceImages = [

  d1,
  d2,
  d3,
  d4,
  d5

];


var distanceStack =
  ee.Image.cat(
    distanceImages
  );


// ================================================================
// 15. BEST + SECOND-BEST 2010 CLASS
// ================================================================

var bestDist =
  d1.rename(
    'best_dist'
  );


var bestClass =
  ee.Image.constant(
    1
  )
  .rename(
    'best_class'
  )
  .updateMask(
    d1.mask()
  );


var secondDist =
  ee.Image.constant(
    9999
  )
  .rename(
    'second_dist'
  )
  .updateMask(
    d1.mask()
  );


for (
  var i = 1;
  i < CLASS_IDS.length;
  i++
) {

  var classId =
    CLASS_IDS[i];


  var currentDistance =
    distanceImages[i];


  var better =
    currentDistance.lt(
      bestDist
    );


  var previousBest =
    bestDist;


  var updatedSecond =
    secondDist.where(
      better,
      previousBest
    );


  var currentAsSecond =
    currentDistance.where(
      better,
      9999
    );


  updatedSecond =
    updatedSecond.min(
      currentAsSecond
    );


  bestDist =
    previousBest
      .where(
        better,
        currentDistance
      )
      .rename(
        'best_dist'
      );


  bestClass =
    bestClass
      .where(
        better,
        classId
      )
      .rename(
        'best_class'
      );


  secondDist =
    updatedSecond.rename(
      'second_dist'
    );

}


var margin =
  secondDist

    .subtract(
      bestDist
    )

    .rename(
      'margin'
    );


// ================================================================
// 16. 3 x 3 LOCAL CONSISTENCY
// ================================================================

var kernel3x3 =
  ee.Kernel.square({

    radius:
      1,

    units:
      'pixels',

    normalize:
      false

  });


var localValidN =
  bestClass

    .reduceNeighborhood({

      reducer:
        ee.Reducer.count(),

      kernel:
        kernel3x3,

      skipMasked:
        true

    })

    .rename(
      'local_valid_n'
    );


var localSameN =
  ee.Image.constant(
    0
  )

  .rename(
    'local_same_n'
  )

  .updateMask(
    bestClass.mask()
  );


CLASS_IDS.forEach(
  function(classId) {

    var neighbourCount =
      bestClass

        .eq(
          classId
        )

        .reduceNeighborhood({

          reducer:
            ee.Reducer.sum(),

          kernel:
            kernel3x3,

          skipMasked:
            true

        });


    localSameN =
      localSameN.where(

        bestClass.eq(
          classId
        ),

        neighbourCount

      );

  }
);


var localFraction =
  localSameN

    .divide(
      localValidN.max(
        1
      )
    )

    .rename(
      'local_fraction'
    );


// ================================================================
// 17. 30 m FINAL-TRAINING EXCLUSION GEOMETRY
// ================================================================
//
// The training data is used ONLY here.
//
// Each final 2010 training point receives a 30 m buffer.
//
// ================================================================

var trainingBuffers =
  training2010.map(
    function(feature) {

      return ee.Feature(
        feature
          .geometry()
          .buffer(
            TRAINING_EXCLUSION_METERS
          )
      );

    }
  );


var trainingExclusionGeometry =
  trainingBuffers.geometry();


// ================================================================
// 18. TARGET-YEAR QA IMAGE
// ================================================================

var qaImage2010 =
  distanceStack

    .addBands(
      bestClass
    )

    .addBands(
      bestDist
    )

    .addBands(
      secondDist
    )

    .addBands(
      margin
    )

    .addBands(
      stack2010.select(
        'clear_count'
      )
    )

    .addBands(
      localValidN
    )

    .addBands(
      localFraction
    );


// ================================================================
// 19. SAMPLE 2010 AT THE 2015 VALIDATION LOCATIONS
// ================================================================
//
// unmask(-9999) guarantees that reference locations are retained
// even if 2010 data are missing.
//
// ================================================================

var sampled2010 =
  qaImage2010

    .unmask(
      NO_DATA_VALUE
    )

    .sampleRegions({

      collection:
        validation2015,

      properties: [

        'reference_id',
        'class_id',
        'class_name',
        'poly_id',
        'source'

      ],

      scale:
        SCALE,

      projection:
        stackProjection,

      geometries:
        true,

      tileScale:
        4

    });


print(
  '2010 sampled validation reference count'
);


print(
  sampled2010.size()
);


// ================================================================
// 20. EVALUATE EACH TRANSFERRED VALIDATION POINT
// ================================================================

var evaluatedValidation =
  sampled2010.map(
    function(feature) {

      var classId =
        ee.Number(
          feature.get(
            'class_id'
          )
        );


      var bestClassValue =
        ee.Number(
          feature.get(
            'best_class'
          )
        );


      var marginValue =
        ee.Number(
          feature.get(
            'margin'
          )
        );


      var clearCount =
        ee.Number(
          feature.get(
            'clear_count'
          )
        );


      var localN =
        ee.Number(
          feature.get(
            'local_valid_n'
          )
        );


      var localFrac =
        ee.Number(
          feature.get(
            'local_fraction'
          )
        );


      var ownDistanceDictionary =
        ee.Dictionary({

          '1':
            feature.get(
              'd1'
            ),

          '2':
            feature.get(
              'd2'
            ),

          '3':
            feature.get(
              'd3'
            ),

          '4':
            feature.get(
              'd4'
            ),

          '5':
            feature.get(
              'd5'
            )

        });


      var ownDistance =
        ee.Number(
          ownDistanceDictionary.get(
            classId.format(
              '%.0f'
            )
          )
        );


      // ----------------------------------------------------------
      // DATA AVAILABILITY
      // ----------------------------------------------------------

      var hasData =
        clearCount.neq(
          NO_DATA_VALUE
        )

        .and(
          bestClassValue.neq(
            NO_DATA_VALUE
          )
        )

        .and(
          ownDistance.neq(
            NO_DATA_VALUE
          )
        );


      // ----------------------------------------------------------
      // LOCKED SCREENING FLAGS
      // ----------------------------------------------------------

      var clearOkay =
        clearCount.gte(
          MIN_CLEAR_COUNT
        );


      var predictedOwnClass =
        bestClassValue.eq(
          classId
        );


      var distanceOkay =
        ownDistance.lte(
          DISTANCE_THRESHOLD
        );


      var marginOkay =
        marginValue.gte(
          MARGIN_THRESHOLD
        );


      var localNOkay =
        localN.gte(
          MIN_LOCAL_VALID
        );


      var localFractionOkay =
        localFrac.gte(
          MIN_LOCAL_FRACTION
        );


      var localOkay =
        localNOkay.and(
          localFractionOkay
        );


      var stableCore =
        hasData

          .and(
            clearOkay
          )

          .and(
            predictedOwnClass
          )

          .and(
            distanceOkay
          )

          .and(
            marginOkay
          )

          .and(
            localOkay
          );


      // ----------------------------------------------------------
      // CHANGED FLAG
      //
      // A confidently different nearest class is treated as
      // CHANGED rather than merely uncertain.
      // ----------------------------------------------------------

      var changedCore =
        hasData

          .and(
            clearOkay
          )

          .and(
            predictedOwnClass.not()
          )

          .and(
            marginOkay
          )

          .and(
            localOkay
          );


      // ----------------------------------------------------------
      // 30 m TRAINING EXCLUSION
      // ----------------------------------------------------------

    var trainingExcluded =
  ee.Number(
    ee.Algorithms.If(
      trainingExclusionGeometry.intersects(
        feature.geometry(),
        1
      ),
      1,
      0
    )
  );


      // ----------------------------------------------------------
      // TRANSFER STATUS
      // ----------------------------------------------------------

      var status =
        ee.String(

          ee.Algorithms.If(

            hasData.not(),

            'NO_DATA',

            ee.Algorithms.If(

              stableCore,

              'STABLE',

              ee.Algorithms.If(

                changedCore,

                'CHANGED',

                'UNCERTAIN'

              )

            )

          )

        );


      // ----------------------------------------------------------
      // ELIGIBLE FOR TARGET VALIDATION POOL
      //
      // Must be STABLE
      // AND outside final 2010 training exclusion.
      // ----------------------------------------------------------

     var eligible =
  stableCore

    .and(
      trainingExcluded.eq(
        0
      )
    );


      return feature.set({

        own_distance:
          ownDistance,

        predicted_class:
          bestClassValue,

        transfer_status:
          status,

        flag_has_data:
          ee.Number(
            ee.Algorithms.If(
              hasData,
              1,
              0
            )
          ),

        flag_clear_ok:
          ee.Number(
            ee.Algorithms.If(
              clearOkay,
              1,
              0
            )
          ),

        flag_class_match:
          ee.Number(
            ee.Algorithms.If(
              predictedOwnClass,
              1,
              0
            )
          ),

        flag_distance_ok:
          ee.Number(
            ee.Algorithms.If(
              distanceOkay,
              1,
              0
            )
          ),

        flag_margin_ok:
          ee.Number(
            ee.Algorithms.If(
              marginOkay,
              1,
              0
