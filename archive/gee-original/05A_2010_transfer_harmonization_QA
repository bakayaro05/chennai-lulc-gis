// ------------------------------------------------
// Initial transfer-screening thresholds
//
// These are NOT being used to tune against validation.
// They are the starting thresholds inherited from the
// preceding temporal-transfer framework.
// ------------------------------------------------

var DISTANCE_THRESHOLD = 1.25;

var MARGIN_THRESHOLD = 0.25;


// ------------------------------------------------
// 2010 clear-observation rule
// ------------------------------------------------
//
// 0 observations = NO_DATA
// 1 observation  = usable only as UNCERTAIN
// >=2            = eligible for automatic acceptance
//

var MIN_CLEAR_FOR_AUTO = 2;


// ------------------------------------------------
// Local spatial consistency
// ------------------------------------------------
//
// Candidate class must occupy at least 5 pixels
// of the valid 3x3 neighbourhood.
//
// 5 / 9 = majority.
//
// This is QA for training-candidate purity only.
// It does NOT smooth the eventual classified map.
// ------------------------------------------------

var MIN_LOCAL_FRACTION = 5 / 9;

var MIN_VALID_NEIGHBOURS = 5;


// Numerical protection only.
// This is NOT a scientific distance threshold.

var EPSILON = 1e-6;


// ================================================================
// 2. LANDSAT 5 TM PREPROCESSING — LOCKED METHOD
// ================================================================

function preprocessL5(image) {

  var qa = image.select('QA_PIXEL');

  // Locked L5 QA_PIXEL rejection bits:
  //
  // bit 0 = Fill
  // bit 1 = Dilated cloud
  // bit 3 = Cloud
  // bit 4 = Cloud shadow
  // bit 5 = Snow

  var qaMask = qa.bitwiseAnd(1 << 0).eq(0)
    .and(qa.bitwiseAnd(1 << 1).eq(0))
    .and(qa.bitwiseAnd(1 << 3).eq(0))
    .and(qa.bitwiseAnd(1 << 4).eq(0))
    .and(qa.bitwiseAnd(1 << 5).eq(0));

  var radsatMask =
    image.select('QA_RADSAT').eq(0);


  // Landsat Collection 2 Level 2 SR scaling
  //
  // SR = DN * 0.0000275 - 0.2

  var optical = image
    .select(
      [
        'SR_B1',
        'SR_B2',
        'SR_B3',
        'SR_B4',
        'SR_B5',
        'SR_B7'
      ],
      [
        'blue',
        'green',
        'red',
        'nir',
        'swir1',
        'swir2'
      ]
    )
    .multiply(0.0000275)
    .add(-0.2)
    .updateMask(qaMask)
    .updateMask(radsatMask);


  // ------------------------------------------------
  // Explicit index arithmetic
  // ------------------------------------------------

  var ndvi = optical.select('nir')
    .subtract(optical.select('red'))
    .divide(
      optical.select('nir')
        .add(optical.select('red'))
    )
    .rename('NDVI');


  var ndwi = optical.select('green')
    .subtract(optical.select('nir'))
    .divide(
      optical.select('green')
        .add(optical.select('nir'))
    )
    .rename('NDWI');


  var ndbi = optical.select('swir1')
    .subtract(optical.select('nir'))
    .divide(
      optical.select('swir1')
        .add(optical.select('nir'))
    )
    .rename('NDBI');


  return optical
    .addBands(ndvi)
    .addBands(ndwi)
    .addBands(ndbi)
    .select(PREDICTORS)
    .copyProperties(
      image,
      ['system:time_start']
    );
}


// ================================================================
// 3. LANDSAT 8 OLI PREPROCESSING — LOCKED METHOD
// ================================================================

function preprocessL8(image) {

  var qa = image.select('QA_PIXEL');

  // Locked L8 QA_PIXEL rejection bits:
  //
  // bit 0 = Fill
  // bit 1 = Dilated cloud
  // bit 2 = Cirrus
  // bit 3 = Cloud
  // bit 4 = Cloud shadow
  // bit 5 = Snow

  var qaMask = qa.bitwiseAnd(1 << 0).eq(0)
    .and(qa.bitwiseAnd(1 << 1).eq(0))
    .and(qa.bitwiseAnd(1 << 2).eq(0))
    .and(qa.bitwiseAnd(1 << 3).eq(0))
    .and(qa.bitwiseAnd(1 << 4).eq(0))
    .and(qa.bitwiseAnd(1 << 5).eq(0));

  var radsatMask =
    image.select('QA_RADSAT').eq(0);


  // Landsat Collection 2 Level 2 SR scaling

  var optical = image
    .select(
      [
        'SR_B2',
        'SR_B3',
        'SR_B4',
        'SR_B5',
        'SR_B6',
        'SR_B7'
      ],
      [
        'blue',
        'green',
        'red',
        'nir',
        'swir1',
        'swir2'
      ]
    )
    .multiply(0.0000275)
    .add(-0.2)
    .updateMask(qaMask)
    .updateMask(radsatMask);


  // ------------------------------------------------
  // Explicit index arithmetic
  // ------------------------------------------------

  var ndvi = optical.select('nir')
    .subtract(optical.select('red'))
    .divide(
      optical.select('nir')
        .add(optical.select('red'))
    )
    .rename('NDVI');


  var ndwi = optical.select('green')
    .subtract(optical.select('nir'))
    .divide(
      optical.select('green')
        .add(optical.select('nir'))
    )
    .rename('NDWI');


  var ndbi = optical.select('swir1')
    .subtract(optical.select('nir'))
    .divide(
      optical.select('swir1')
        .add(optical.select('nir'))
    )
    .rename('NDBI');


  return optical
    .addBands(ndvi)
    .addBands(ndwi)
    .addBands(ndbi)
    .select(PREDICTORS)
    .copyProperties(
      image,
      ['system:time_start']
    );
}


