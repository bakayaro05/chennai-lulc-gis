// ================================================================
// 12. DISTANCE FROM 2010 PIXEL TO EACH 2015 CLASS SIGNATURE
// ================================================================

function distanceToClass(
  normalizedImage,
  classId
) {

  var signature =
    ee.Feature(
      signatures2015
        .filter(
          ee.Filter.eq(
            'class_id',
            classId
          )
        )
        .first()
    );


  var meanImage =
    ee.Image.constant(
      ee.List(
        signature.get('means')
      )
    )
    .rename(PREDICTORS);


  var sdImage =
    ee.Image.constant(
      ee.List(
        signature.get('sds')
      )
    )
    .rename(PREDICTORS)
    .max(EPSILON);


  var standardizedDifference =
    normalizedImage
      .select(PREDICTORS)
      .subtract(meanImage)
      .divide(sdImage);


  var distance =
    standardizedDifference
      .pow(2)
      .reduce(
        ee.Reducer.mean()
      )
      .sqrt()
      .rename(
        'd' + classId
      );


  return distance;
}


// ------------------------------------------------
// Create five distance images
// ------------------------------------------------

var d1 =
  distanceToClass(
    z2010,
    1
  );


var d2 =
  distanceToClass(
    z2010,
    2
  );


var d3 =
  distanceToClass(
    z2010,
    3
  );


var d4 =
  distanceToClass(
    z2010,
    4
  );


var d5 =
  distanceToClass(
    z2010,
    5
  );


var distanceStack =
  ee.Image.cat(
    [
      d1,
      d2,
      d3,
      d4,
      d5
    ]
  );


// ================================================================
// 13. FIND BEST AND SECOND-BEST CLASS
// ================================================================

var distanceImages =
  [
    d1,
    d2,
    d3,
    d4,
    d5
  ];


// Start with class 1

var bestDist =
  d1.rename('best_dist');


var bestClass =
  ee.Image.constant(1)
    .rename('best_class')
    .updateMask(
      d1.mask()
    );


var secondDist =
  ee.Image.constant(9999)
    .rename('second_dist')
    .updateMask(
      d1.mask()
    );


// Compare classes 2–5

for (
  var i = 1;
  i < CLASS_IDS.length;
  i++
) {

  var currentClass =
    CLASS_IDS[i];

  var currentDistance =
    distanceImages[i];


  var better =
    currentDistance.lt(
      bestDist
    );


  // Save current best BEFORE replacing it.

  var previousBest =
    bestDist;


  // If current class becomes best,
  // previous best becomes candidate second-best.

  var updatedSecond =
    secondDist.where(
      better,
      previousBest
    );


  // If current class is not best,
  // it may still be second best.

  var currentAsSecond =
    currentDistance.where(
      better,
      9999
    );


  updatedSecond =
    updatedSecond.min(
      currentAsSecond
    );


  // Update best distance and class.

  bestDist =
    previousBest
      .where(
        better,
        currentDistance
      )
      .rename(
        'best_dist'
      );


  bestClass =
    bestClass
      .where(
        better,
        currentClass
      )
      .rename(
        'best_class'
      );


  secondDist =
    updatedSecond.rename(
      'second_dist'
    );
}


// ------------------------------------------------
// Separation margin
// ------------------------------------------------
//
// Larger = better separation from competing class.
//

var margin =
  secondDist
    .subtract(bestDist)
    .rename('margin');


// ================================================================
// 14. LOCAL 3x3 SPATIAL CONSISTENCY
// ================================================================
//
// This does NOT alter classification.
//
// It simply asks:
//
// "Does the automatically selected class agree with
//  most nearby pixels?"
//
// ================================================================

var kernel3x3 =
  ee.Kernel.square({
    radius: 1,
    units: 'pixels',
    normalize: false
  });


// Number of valid neighbours

var localValidN =
  bestClass.reduceNeighborhood({

    reducer:
      ee.Reducer.count(),

    kernel:
      kernel3x3,

    skipMasked:
      true
  })
  .rename(
    'local_valid_n'
  );


// ------------------------------------------------
// Count neighbouring pixels belonging to the
// centre pixel's predicted class.
// ------------------------------------------------

var localSameN =
  ee.Image.constant(0)
    .rename('local_same_n')
    .updateMask(
      bestClass.mask()
    );


CLASS_IDS.forEach(
  function (classId) {

    var classNeighbourCount =
      bestClass
        .eq(classId)
        .reduceNeighborhood({

          reducer:
            ee.Reducer.sum(),

          kernel:
            kernel3x3,

          skipMasked:
            true
        });


    localSameN =
      localSameN.where(
        bestClass.eq(classId),
        classNeighbourCount
      );

  }
);


// ------------------------------------------------
// Local agreement fraction
// ------------------------------------------------

var localFraction =
  localSameN
    .divide(
      localValidN.max(1)
    )
    .rename(
      'local_fraction'
    );


// ================================================================
// 15. BUILD QA IMAGE FOR POINT SCREENING
// ================================================================
//
// Unmask with explicit sentinel values so that
// NO_DATA reference points are not silently dropped.
// ================================================================

var qaImage =
  distanceStack
    .unmask(9999)

    .addBands(
      bestClass.unmask(0)
    )

    .addBands(
      bestDist.unmask(9999)
    )

    .addBands(
      secondDist.unmask(9999)
    )

    .addBands(
      margin.unmask(-9999)
    )

    .addBands(
      clear2010
        .rename('clear_count')
        .unmask(0)
    )

    .addBands(
      localValidN
        .unmask(0)
    )

    .addBands(
      localFraction
        .unmask(0)
    );


// ================================================================
// 16. SAMPLE QA IMAGE AT FINAL 2015 TRAINING LOCATIONS
// ================================================================

var screenedSamples =
  qaImage.sampleRegions({

    collection:
      training2015,

    properties: [
      'class_id',
      'class_name',
      'poly_id'
    ],

    scale:
      SCALE,

    projection:
      ee.Projection(CRS),

    geometries:
      true,

    tileScale:
      4
  });


// ================================================================
// 17. GET ORIGINAL-CLASS DISTANCE
// ================================================================

function getOwnClassDistance(
  feature,
  classId
) {

  return ee.Number(

    ee.Algorithms.If(
      classId.eq(1),

      feature.get('d1'),

      ee.Algorithms.If(
        classId.eq(2),

        feature.get('d2'),

        ee.Algorithms.If(
          classId.eq(3),

          feature.get('d3'),

          ee.Algorithms.If(
            classId.eq(4),

            feature.get('d4'),

            feature.get('d5')
          )
        )
      )
    )
  );
}


// ================================================================
// 18. ASSIGN TRANSFER STATUS
// ================================================================

var screened2010 =
  screenedSamples.map(
    function (feature) {

      var originalClass =
        ee.Number(
          feature.get(
            CLASS_PROPERTY
          )
        );


      var predictedClass =
        ee.Number(
          feature.get(
            'best_class'
          )
        );


      var bestDistance =
        ee.Number(
          feature.get(
            'best_dist'
          )
        );


      var ownDistance =
        getOwnClassDistance(
          feature,
          originalClass
        );


      var classMargin =
        ee.Number(
          feature.get(
            'margin'
          )
        );


      var clearCount =
        ee.Number(
          feature.get(
            'clear_count'
          )
        );


      var localFrac =
        ee.Number(
          feature.get(
            'local_fraction'
          )
        );


      var localN =
        ee.Number(
          feature.get(
            'local_valid_n'
          )
        );


      // ------------------------------------------------
      // NO DATA
      // ------------------------------------------------

      var noData =
        clearCount.lte(0)
          .or(
            predictedClass.eq(0)
          )
          .or(
            ownDistance.gte(9000)
          );


      // ------------------------------------------------
      // Local spatial QA
      // ------------------------------------------------

      var localGood =
        localN
          .gte(
            MIN_VALID_NEIGHBOURS
          )
          .and(
            localFrac.gte(
              MIN_LOCAL_FRACTION
            )
          );


      // ------------------------------------------------
      // AUTO-STABLE
      //
      // Must:
      //   - have >=2 clear observations
      //   - retain original class
      //   - be close enough to class signature
      //   - have sufficient class separation
      //   - pass local spatial QA
      // ------------------------------------------------

      var stable =
        clearCount
          .gte(
            MIN_CLEAR_FOR_AUTO
          )

          .and(
            predictedClass.eq(
              originalClass
            )
          )

          .and(
            ownDistance.lte(
              DISTANCE_THRESHOLD
            )
          )

          .and(
            classMargin.gte(
              MARGIN_THRESHOLD
            )
          )

          .and(
            localGood
          );


      // ------------------------------------------------
      // CONFIDENT CHANGE
      //
      // 2010 confidently resembles another class.
      // ------------------------------------------------

      var changed =
        clearCount
          .gte(
            MIN_CLEAR_FOR_AUTO
          )

          .and(
            predictedClass.neq(
              originalClass
            )
          )

          .and(
            bestDistance.lte(
              DISTANCE_THRESHOLD
            )
          )

          .and(
            classMargin.gte(
              MARGIN_THRESHOLD
            )
          )

          .and(
            localGood
          );


      // ------------------------------------------------
      // Final status
      // ------------------------------------------------

      var status =
        ee.String(

          ee.Algorithms.If(
            noData,

            'NO_DATA',

            ee.Algorithms.If(
              stable,

              'STABLE',

              ee.Algorithms.If(
                changed,

                'CHANGED',

                'UNCERTAIN'
              )
            )
          )
        );


      var autoAccept =
        ee.Number(
          ee.Algorithms.If(
            stable,
            1,
            0
          )
        );


      return feature.set({

        original_class:
          originalClass,

        predicted_class_2010:
          predictedClass,

        own_distance:
          ownDistance,

        transfer_margin:
          classMargin,

        transfer_status:
          status,

        auto_accept:
          autoAccept,

        source_year:
          2015,

        target_year:
          2010,

        transfer_method:
          'robustZ_L8_to_L5_passA'
      });

    }
  );


