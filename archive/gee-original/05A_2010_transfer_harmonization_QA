// ================================================================
// 8. ROBUST WITHIN-YEAR NORMALIZATION
// ================================================================
//
// For each band:
//
// robustZ =
//      (pixel - median)
//      ----------------
//        IQR / 1.349
//
// IQR = P75 - P25
//
// IMPORTANT:
//
// 2015 statistics are calculated from 2015.
//
// 2010 statistics are calculated independently from 2010.
//
// Therefore raw Landsat-8 reflectance is NOT directly
// subtracted from raw Landsat-5 reflectance.
// ================================================================

function robustNormalize(image, yearLabel) {

  var stats = image
    .select(PREDICTORS)
    .reduceRegion({

      reducer: ee.Reducer.percentile(
        [25, 50, 75],
        ['p25', 'p50', 'p75']
      ),

      geometry: ROI.geometry(),

      scale: SCALE,

      crs: CRS,

      maxPixels: 1e9,

      tileScale: 4
    });


  var normalizedBands =
    PREDICTORS.map(function (band) {

      var p25 = ee.Number(
        stats.get(band + '_p25')
      );

      var p50 = ee.Number(
        stats.get(band + '_p50')
      );

      var p75 = ee.Number(
        stats.get(band + '_p75')
      );


      var iqr = p75.subtract(p25);


      // IQR / 1.349 approximates SD for a normal distribution.
      // EPSILON only prevents division by zero.

      var robustScale = iqr
        .divide(1.349)
        .max(EPSILON);


      return image
        .select(band)
        .subtract(p50)
        .divide(robustScale)
        .rename(band);

    });


  var normalized =
    ee.Image.cat(normalizedBands)
      .select(PREDICTORS);


  print(
    yearLabel +
    ' robust-normalization statistics:',
    stats
  );


  return normalized;
}


