function medianProperty(
  collection,
  propertyName
) {

  return collection
    .reduceColumns(
      ee.Reducer.median(),
      [propertyName]
    )
    .get('median');
}


function summarizeClass(
  classId
) {

  var fc =
    screened2010.filter(
      ee.Filter.eq(
        CLASS_PROPERTY,
        classId
      )
    );


  var total =
    fc.size();


  var stable =
    fc.filter(
      ee.Filter.eq(
        'transfer_status',
        'STABLE'
      )
    ).size();


  var uncertain =
    fc.filter(
      ee.Filter.eq(
        'transfer_status',
        'UNCERTAIN'
      )
    ).size();


  var changed =
    fc.filter(
      ee.Filter.eq(
        'transfer_status',
        'CHANGED'
      )
    ).size();


  var noData =
    fc.filter(
      ee.Filter.eq(
        'transfer_status',
        'NO_DATA'
      )
    ).size();


  var stablePct =
    ee.Number(stable)
      .divide(total)
      .multiply(100);


  return ee.Feature(
    null,
    {

      class_id:
        classId,

      class_name:
        CLASS_NAMES[classId - 1],

      input_n:
        total,

      stable_n:
        stable,

      stable_pct:
        stablePct,

      uncertain_n:
        uncertain,

      changed_n:
        changed,

      no_data_n:
        noData,

      median_own_distance:
        medianProperty(
          fc,
          'own_distance'
        ),

      median_margin:
        medianProperty(
          fc,
          'transfer_margin'
        ),

      mean_clear_count_2010:
        fc.aggregate_mean(
          'clear_count'
        ),

      mean_local_fraction:
        fc.aggregate_mean(
          'local_fraction'
        )
    }
  );
}


var classSummary =
