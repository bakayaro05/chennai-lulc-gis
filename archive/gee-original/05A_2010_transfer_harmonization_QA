// ================================================================
// 11. BUILD NORMALIZED 2015 CLASS SIGNATURES
// ================================================================
//
// Each class signature contains:
//
// - 9-band mean vector
// - 9-band sample standard-deviation vector
//
// Distance is later calculated as:
//
// sqrt(
//     mean(
//        ((pixel - classMean) / classSD)^2
//     )
// )
//
// This gives a class-standardized RMS distance.
// ================================================================

function buildClassSignature(classId) {

  var classSamples =
    referenceSamples2015.filter(
      ee.Filter.eq(
        CLASS_PROPERTY,
        classId
      )
    );


  var means =
    PREDICTORS.map(function (band) {

      return ee.Number(
        classSamples.aggregate_mean(
          band
        )
      );

    });


  var sds =
    PREDICTORS.map(function (band) {

      return ee.Number(
        classSamples.aggregate_sample_sd(
          band
        )
      ).max(EPSILON);

    });


  return ee.Feature(
    null,
    {
      class_id: classId,
      class_name:
        CLASS_NAMES[classId - 1],

      n_reference:
        classSamples.size(),

      means:
        ee.List(means),

      sds:
        ee.List(sds)
    }
  );
}


var signatures2015 =
  ee.FeatureCollection(
    CLASS_IDS.map(
      buildClassSignature
    )
  );


