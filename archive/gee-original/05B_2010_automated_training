// ================================================================
// 05B_2010_automated_training
// Chennai Multi-Temporal LULC Project
//
// PURPOSE
// -------
// Automated Pass-B construction of 2010 training candidates.
//
// INPUT:
// 05A conservative 2015 → 2010 temporal-transfer QA asset.
//
// WORKFLOW:
//
// 05A STABLE points
//       ↓
// source-group diversity QA
//       ↓
// sample ORIGINAL 2010 Landsat-5 predictor values
//       ↓
// construct 2010-native class signatures
//       ↓
// expand only 60 m around trusted STABLE anchors
//       ↓
// evaluate every candidate independently using 2010-native signatures
//       ↓
// clear-observation QA
//       ↓
// local spatial-consistency QA
//       ↓
// deduplicate Landsat pixels
//       ↓
// assess whether ≥120 high-confidence candidates/class exist
//       ↓
// create provisional balanced 120/class set where possible
//
// IMPORTANT:
// -------
// This script does NOT:
//   - use validation data
//   - train Gaussian MLC
//   - calculate final areas
//
// DO NOT EXPORT FINAL TRAINING UNTIL THE QA RESULTS ARE REVIEWED.
// ================================================================


// ================================================================
// 1. PROJECT CONSTANTS
// ================================================================

var ROI_ASSET =
  'projects/assignment-482806/assets/chennai_admin_study_area_clean';

var QA_05A_ASSET =
  'projects/assignment-482806/assets/chennai_transfer_2015_to_2010_QA_05A';


var ROI =
  ee.FeatureCollection(
    ROI_ASSET
  );


var qa05A =
  ee.FeatureCollection(
    QA_05A_ASSET
  );


// ------------------------------------------------
// Locked project spatial settings
// ------------------------------------------------

var CRS =
  'EPSG:32644';

var SCALE =
  30;


// ------------------------------------------------
// Locked predictor stack
// ------------------------------------------------

var PREDICTORS = [
  'blue',
  'green',
  'red',
  'nir',
  'swir1',
  'swir2',
  'NDVI',
  'NDWI',
  'NDBI'
];


// ------------------------------------------------
// Locked class schema
// ------------------------------------------------

var CLASS_PROPERTY =
  'class_id';


var CLASS_IDS =
  [1, 2, 3, 4, 5];


var CLASS_NAMES = [
  'Built-up',
  'Vegetation',
  'Water',
  'Agricultural/Open',
  'Barren/Fallow'
];


// ================================================================
// 2. PASS-B SETTINGS
// ================================================================
//
// 05A already acted as the conservative cross-sensor gate.
//
// Pass B operates entirely in 2010 Landsat-5 feature space.
//
// We initially retain the existing project screening gates.
// These are NOT tuned using validation.
// ================================================================

var DISTANCE_THRESHOLD =
  1.25;


var MARGIN_THRESHOLD =
  0.25;


var MIN_CLEAR_FOR_AUTO =
  2;


// ------------------------------------------------
// Local candidate expansion
// ------------------------------------------------
//
// 60 m = two Landsat pixels.
//
// Candidates are generated ONLY close to trusted
// 05A stable anchors.
//
// They still have to independently pass all Pass-B tests.
// ------------------------------------------------

var EXPANSION_RADIUS_M =
  60;


// ------------------------------------------------
// 3 × 3 local spatial QA
// ------------------------------------------------

var MIN_LOCAL_FRACTION =
  5 / 9;


var MIN_VALID_NEIGHBOURS =
  5;


// ------------------------------------------------
// Numerical protection only
// ------------------------------------------------

var EPSILON =
  1e-6;


// ------------------------------------------------
// Desired final training
// ------------------------------------------------

var TARGET_PER_CLASS =
  120;


// ================================================================
// 3. LANDSAT-5 PREPROCESSING
// ================================================================
//
// Locked 2010 methodology.
// ================================================================

function preprocessL5(image) {

  var qa =
    image.select(
      'QA_PIXEL'
    );


  var qaMask =
    qa.bitwiseAnd(1 << 0).eq(0)
      .and(
        qa.bitwiseAnd(1 << 1).eq(0)
      )
      .and(
        qa.bitwiseAnd(1 << 3).eq(0)
      )
      .and(
        qa.bitwiseAnd(1 << 4).eq(0)
      )
      .and(
        qa.bitwiseAnd(1 << 5).eq(0)
      );


  var radsatMask =
    image.select(
      'QA_RADSAT'
    ).eq(0);


  var optical =
    image
      .select(
        [
          'SR_B1',
          'SR_B2',
          'SR_B3',
          'SR_B4',
          'SR_B5',
          'SR_B7'
        ],
        [
          'blue',
          'green',
          'red',
          'nir',
          'swir1',
          'swir2'
        ]
      )
      .multiply(
        0.0000275
      )
      .add(
        -0.2
      )
      .updateMask(
        qaMask
      )
      .updateMask(
        radsatMask
      );


  // ------------------------------------------------
  // Explicit index arithmetic
  // ------------------------------------------------

  var ndvi =
    optical.select('nir')
      .subtract(
        optical.select('red')
      )
      .divide(
        optical.select('nir')
          .add(
            optical.select('red')
          )
      )
      .rename(
        'NDVI'
      );


  var ndwi =
    optical.select('green')
      .subtract(
        optical.select('nir')
      )
      .divide(
        optical.select('green')
          .add(
            optical.select('nir')
          )
      )
      .rename(
        'NDWI'
      );


  var ndbi =
    optical.select('swir1')
      .subtract(
        optical.select('nir')
      )
      .divide(
        optical.select('swir1')
          .add(
            optical.select('nir')
          )
      )
      .rename(
        'NDBI'
      );


  return optical
    .addBands(
      ndvi
    )
    .addBands(
      ndwi
    )
    .addBands(
      ndbi
    )
    .select(
      PREDICTORS
    )
    .copyProperties(
      image,
      ['system:time_start']
    );
}


// ================================================================
// 4. BUILD LOCKED 2010 LANDSAT-5 STACK
// ================================================================

var collection2010 =
  ee.ImageCollection(
    'LANDSAT/LT05/C02/T1_L2'
  )
    .filterBounds(
      ROI
    )
    .filterDate(
      '2010-01-01',
      '2011-01-01'
    )
    .map(
      preprocessL5
    );


var image2010 =
  collection2010
    .median()
    .select(
      PREDICTORS
    )
    .clip(
      ROI
    );


var clear2010 =
  collection2010
    .select(
      'red'
    )
    .count()
    .rename(
      'clear_count'
    )
    .clip(
      ROI
    );


print(
