  '========================================'
);

print(
  '05A STABLE-SEED SOURCE-GROUP DIVERSITY'
);

print(
  '========================================'
);


print(
  seedDiversitySummary
);


// ------------------------------------------------
// Exact poly_id histogram per class
// ------------------------------------------------

CLASS_IDS.forEach(
