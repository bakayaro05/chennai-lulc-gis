// ================================================================
// 21. CLASS-WISE SUFFICIENCY SUMMARY
// ================================================================

function summarizeCandidates(
  classId
) {

  var classAccepted =
    acceptedCandidates.filter(
      ee.Filter.eq(
        CLASS_PROPERTY,
        classId
      )
    );


  var n =
    classAccepted.size();


  var groupIds =
    ee.List(
      classAccepted.aggregate_array(
        'poly_id'
      )
    )
    .distinct();


  var deficit =
    ee.Number(
      TARGET_PER_CLASS
    )
    .subtract(
      n
    )
    .max(
      0
    );


  var sufficient =
    n.gte(
      TARGET_PER_CLASS
    );


  return ee.Feature(
    null,
    {

      class_id:
        classId,

      class_name:
        CLASS_NAMES[
          classId - 1
        ],

      accepted_candidate_n:
        n,

      distinct_poly_id_n:
        groupIds.size(),

      target_n:
        TARGET_PER_CLASS,

      sufficient_120:
        sufficient,

      deficit:
        deficit,

      mean_passB_distance:
        classAccepted.aggregate_mean(
          'passB_distance'
        ),

      mean_passB_margin:
        classAccepted.aggregate_mean(
          'passB_margin'
        ),

      mean_clear_count:
        classAccepted.aggregate_mean(
          'clear_count'
        ),

      mean_local_fraction:
        classAccepted.aggregate_mean(
          'local_fraction'
        )
    }
  );
}


var candidateSummary =
  ee.FeatureCollection(
    CLASS_IDS.map(
      summarizeCandidates
    )
  );


