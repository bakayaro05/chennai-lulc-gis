// ================================================================
// 6. SOURCE-GROUP DIVERSITY QA
// ================================================================
//
// We retain poly_id from the completed 2015 workflow.
//
// This allows us to detect whether a class is being represented
// by only one or two source groups.
// ================================================================

function summarizeSeedClass(
  classId
) {

  var fc =
    stableSeeds.filter(
      ee.Filter.eq(
        CLASS_PROPERTY,
        classId
      )
    );


  var groups =
    ee.List(
      fc.aggregate_array(
        'poly_id'
      )
    )
    .distinct()
    .sort();


  return ee.Feature(
    null,
    {

      class_id:
        classId,

      class_name:
        CLASS_NAMES[
          classId - 1
        ],

      stable_seed_n:
        fc.size(),

      distinct_poly_id_n:
        groups.size(),

      poly_ids:
        groups
    }
  );
}


var seedDiversitySummary =
  ee.FeatureCollection(
    CLASS_IDS.map(
      summarizeSeedClass
    )
  );


