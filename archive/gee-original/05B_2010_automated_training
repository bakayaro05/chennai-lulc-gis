// ================================================================
// 7. SAMPLE ORIGINAL 2010 VALUES AT TRUSTED SEEDS
// ================================================================
//
// IMPORTANT:
//
// These are ORIGINAL Landsat-5 2010 predictors.
//
// The robust cross-sensor normalized space was only needed
// for Pass A.
//
// From this point onward we operate in target-year-native
// 2010 Landsat-5 space.
// ================================================================

var nativeSeedSamples =
  image2010.sampleRegions({

    collection:
      stableSeeds,

    properties: [
      'class_id',
      'class_name',
      'poly_id'
    ],

    scale:
      SCALE,

    projection:
      ee.Projection(
        CRS
      ).atScale(
        SCALE
      ),

    geometries:
      true,

    tileScale:
      4
  });


print(
  '2010-native seed sample total'
);

print(
  nativeSeedSamples.size()
);


print(
  '2010-native seed class histogram'
);

print(
  nativeSeedSamples.aggregate_histogram(
    CLASS_PROPERTY
  )
);


// ================================================================
// 8. BUILD 2010-NATIVE CLASS SIGNATURES
// ================================================================
//
// For each class:
//
// mean vector = original 2010 Landsat-5 predictors
// SD vector   = within-class sample standard deviation
//
// These signatures are therefore fully target-year-native.
// ================================================================

function buildNativeSignature(
  classId
) {

  var classSamples =
    nativeSeedSamples.filter(
      ee.Filter.eq(
        CLASS_PROPERTY,
        classId
      )
    );


  var means =
    PREDICTORS.map(
      function(band) {

        return ee.Number(
          classSamples.aggregate_mean(
            band
          )
        );

      }
    );


  var sds =
    PREDICTORS.map(
      function(band) {

        return ee.Number(
          classSamples.aggregate_sample_sd(
            band
          )
        )
        .max(
          EPSILON
        );

      }
    );


  return ee.Feature(
    null,
    {

      class_id:
        classId,

      class_name:
        CLASS_NAMES[
          classId - 1
        ],

      n_seed:
        classSamples.size(),

      means:
        ee.List(
          means
        ),

      sds:
        ee.List(
          sds
        )
    }
  );
}


var nativeSignatures =
  ee.FeatureCollection(
    CLASS_IDS.map(
      buildNativeSignature
    )
  );


print(
  '========================================'
);

print(
  '2010-NATIVE CLASS SIGNATURES'
);

print(
  '========================================'
);


print(
  nativeSignatures
);


// ================================================================
// 9. DISTANCE TO 2010-NATIVE CLASS
// ================================================================

function distanceToNativeClass(
  image,
  classId
) {

  var signature =
    ee.Feature(
      nativeSignatures
        .filter(
          ee.Filter.eq(
            'class_id',
            classId
          )
        )
        .first()
    );


  var meanImage =
    ee.Image.constant(
      ee.List(
        signature.get(
          'means'
        )
      )
    )
    .rename(
      PREDICTORS
    );


  var sdImage =
    ee.Image.constant(
      ee.List(
        signature.get(
          'sds'
        )
      )
    )
    .rename(
      PREDICTORS
    )
    .max(
      EPSILON
    );


  return image
    .select(
      PREDICTORS
    )
    .subtract(
      meanImage
    )
    .divide(
      sdImage
    )
    .pow(2)
    .reduce(
      ee.Reducer.mean()
    )
    .sqrt()
    .rename(
      'd' + classId
    );
}


// ================================================================
// 10. BUILD FIVE 2010-NATIVE DISTANCE LAYERS
// ================================================================

var d1 =
  distanceToNativeClass(
    image2010,
    1
  );


var d2 =
  distanceToNativeClass(
    image2010,
    2
  );


var d3 =
  distanceToNativeClass(
    image2010,
    3
  );


var d4 =
  distanceToNativeClass(
    image2010,
    4
  );


var d5 =
  distanceToNativeClass(
    image2010,
    5
  );


var distanceImages = [
  d1,
  d2,
  d3,
  d4,
  d5
];


var distanceStack =
  ee.Image.cat(
    distanceImages
  );


// ================================================================
// 11. FIND BEST + SECOND-BEST 2010-NATIVE CLASS
// ================================================================

var bestDist =
  d1.rename(
    'best_dist'
  );


var bestClass =
  ee.Image.constant(
    1
  )
    .rename(
      'best_class'
    )
    .updateMask(
      d1.mask()
    );


var secondDist =
  ee.Image.constant(
    9999
  )
    .rename(
      'second_dist'
    )
    .updateMask(
      d1.mask()
    );


for (
  var i = 1;
  i < CLASS_IDS.length;
  i++
) {

  var currentClass =
    CLASS_IDS[i];


  var currentDistance =
    distanceImages[i];


  var better =
    currentDistance.lt(
      bestDist
    );


  var previousBest =
    bestDist;


  var updatedSecond =
    secondDist.where(
      better,
      previousBest
    );


  var currentAsSecond =
    currentDistance.where(
      better,
      9999
    );


  updatedSecond =
    updatedSecond.min(
      currentAsSecond
    );


  bestDist =
    previousBest
      .where(
        better,
        currentDistance
      )
      .rename(
        'best_dist'
      );


  bestClass =
    bestClass
      .where(
        better,
        currentClass
      )
      .rename(
        'best_class'
      );


  secondDist =
    updatedSecond.rename(
      'second_dist'
    );
}


var margin =
  secondDist
    .subtract(
      bestDist
    )
    .rename(
      'margin'
    );


// ================================================================
// 12. LOCAL 3 × 3 CONSISTENCY FROM 2010-NATIVE MODEL
// ================================================================

var kernel3x3 =
  ee.Kernel.square({

    radius:
      1,

    units:
      'pixels',

    normalize:
      false
  });


var localValidN =
  bestClass
    .reduceNeighborhood({

      reducer:
        ee.Reducer.count(),

      kernel:
        kernel3x3,

      skipMasked:
        true
    })
    .rename(
      'local_valid_n'
    );


var localSameN =
  ee.Image.constant(
    0
  )
    .rename(
      'local_same_n'
    )
    .updateMask(
      bestClass.mask()
    );


CLASS_IDS.forEach(
  function(classId) {

    var classNeighbourCount =
      bestClass
        .eq(
          classId
        )
        .reduceNeighborhood({

          reducer:
            ee.Reducer.sum(),

          kernel:
            kernel3x3,

          skipMasked:
            true
        });


    localSameN =
      localSameN.where(
        bestClass.eq(
          classId
        ),
        classNeighbourCount
      );

  }
);


var localFraction =
  localSameN
    .divide(
      localValidN.max(
        1
      )
    )
    .rename(
      'local_fraction'
    );


// ================================================================
// 13. CREATE SMALL EXPANSION ZONES AROUND STABLE ANCHORS
// ================================================================
//
// We DO NOT search arbitrary pixels over Chennai.
//
// Each stable anchor is expanded only 60 m.
//
// The source class and poly_id are preserved.
// ================================================================

var expansionZones =
  stableSeeds.map(
    function(feature) {

      return ee.Feature(
        feature.geometry()
          .buffer(
            EXPANSION_RADIUS_M
          ),
        {

          class_id:
            feature.get(
              'class_id'
            ),

          class_name:
            feature.get(
              'class_name'
            ),

          poly_id:
            feature.get(
              'poly_id'
            ),

          seed_status:
            '05A_STABLE'
        }
      );

    }
  );


print(
  'Expansion zone count'
);

print(
  expansionZones.size()
);


// ================================================================
// 14. PIXEL COORDINATES FOR DEDUPLICATION
// ================================================================

var pixelXY =
  ee.Image.pixelCoordinates(
    ee.Projection(
      CRS
    ).atScale(
      SCALE
    )
  )
  .rename(
    [
      'px',
      'py'
    ]
  );


// ================================================================
// 15. BUILD PASS-B CANDIDATE IMAGE
// ================================================================
//
// Original 2010 predictors are retained in the sampled features.
//
// Additional QA bands:
// d1...d5
// best_class
// best_dist
// second_dist
// margin
// clear_count
// local_valid_n
// local_fraction
// px / py
// ================================================================

var candidateImage =
  image2010
    .select(
      PREDICTORS
    )

    .addBands(
      distanceStack
    )

    .addBands(
      bestClass
    )

    .addBands(
      bestDist
    )

    .addBands(
      secondDist
    )

    .addBands(
      margin
    )

    .addBands(
      clear2010
    )

    .addBands(
      localValidN
    )

    .addBands(
      localFraction
    )

    .addBands(
      pixelXY
    );


// ================================================================
// 16. SAMPLE ALL PIXELS INSIDE THE LOCAL EXPANSION ZONES
// ================================================================

var candidatePool =
  candidateImage.sampleRegions({

    collection:
      expansionZones,

    properties: [
      'class_id',
      'class_name',
      'poly_id',
      'seed_status'
    ],

    scale:
      SCALE,

    projection:
      ee.Projection(
        CRS
      ).atScale(
        SCALE
      ),

    geometries:
      true,

    tileScale:
      4
  });


print(
  'Raw Pass-B candidate rows before screening/deduplication'
);

print(
  candidatePool.size()
);


// ================================================================
// 17. CREATE UNIQUE PIXEL KEY
// ================================================================
//
// Same physical Landsat pixel may occur in overlapping
// 60 m expansion buffers.
//
// The key lets us remove duplicate accepted pixels later.
// ================================================================

candidatePool =
  candidatePool.map(
    function(feature) {

      var px =
        ee.Number(
          feature.get(
            'px'
          )
        );


      var py =
        ee.Number(
          feature.get(
            'py'
          )
        );


      var key =
        px.format(
          '%.0f'
        )
        .cat(
          '_'
        )
        .cat(
          py.format(
            '%.0f'
          )
        );


      return feature.set(
        'pixel_key',
        key
      );

    }
  );


// ================================================================
// 18. OWN-CLASS DISTANCE HELPER
// ================================================================

function ownClassDistance(
  feature,
  classId
) {

  return ee.Number(

    ee.Algorithms.If(
      classId.eq(1),

      feature.get(
        'd1'
      ),

      ee.Algorithms.If(
        classId.eq(2),

        feature.get(
          'd2'
        ),

        ee.Algorithms.If(
          classId.eq(3),

          feature.get(
            'd3'
          ),

          ee.Algorithms.If(
            classId.eq(4),

            feature.get(
              'd4'
            ),

            feature.get(
              'd5'
            )
          )
        )
      )
    )
  );
}


// ================================================================
// 19. PASS-B AUTOMATIC ACCEPTANCE
// ================================================================
//
// Each expanded candidate must INDEPENDENTLY satisfy:
//
// 1. >= 2 clear observations
// 2. nearest 2010-native class == source class
// 3. own-class distance <= 1.25
// 4. nearest-vs-second margin >= 0.25
// 5. at least 5 valid neighbours
// 6. >= 5/9 local class agreement
//
// No candidate is accepted merely because it is close to a seed.
// ================================================================

var screenedCandidates =
  candidatePool.map(
    function(feature) {

      var sourceClass =
        ee.Number(
          feature.get(
            CLASS_PROPERTY
          )
        );


      var predictedClass =
        ee.Number(
          feature.get(
            'best_class'
          )
        );


      var ownDistance =
        ownClassDistance(
          feature,
          sourceClass
        );


      var classMargin =
        ee.Number(
          feature.get(
            'margin'
          )
        );


      var clearCount =
        ee.Number(
          feature.get(
            'clear_count'
          )
        );


      var localN =
        ee.Number(
          feature.get(
            'local_valid_n'
          )
        );


      var localFrac =
        ee.Number(
          feature.get(
            'local_fraction'
          )
        );


      var passClear =
        clearCount.gte(
          MIN_CLEAR_FOR_AUTO
        );


      var passClass =
        predictedClass.eq(
          sourceClass
        );


      var passDistance =
        ownDistance.lte(
          DISTANCE_THRESHOLD
        );


      var passMargin =
        classMargin.gte(
          MARGIN_THRESHOLD
        );


      var passLocal =
        localN
          .gte(
            MIN_VALID_NEIGHBOURS
          )
          .and(
            localFrac.gte(
              MIN_LOCAL_FRACTION
            )
          );


      var accepted =
        passClear
          .and(
            passClass
          )
          .and(
            passDistance
          )
          .and(
            passMargin
          )
          .and(
            passLocal
          );


      return feature.set({

        passB_source_class:
          sourceClass,

        passB_predicted_class:
          predictedClass,

        passB_distance:
          ownDistance,

        passB_margin:
          classMargin,

        passB_clear_ok:
          passClear,

        passB_class_ok:
          passClass,

        passB_distance_ok:
          passDistance,

        passB_margin_ok:
          passMargin,

        passB_local_ok:
          passLocal,

        passB_auto_accept:
          ee.Number(
            ee.Algorithms.If(
              accepted,
              1,
              0
            )
          ),

        source_year:
          2015,

        target_year:
          2010,

        training_method:
          '05B_2010_native_local_expansion'
      });

    }
  );


// ================================================================
// 20. ACCEPT + DEDUPLICATE
// ================================================================

var acceptedCandidatesRaw =
  screenedCandidates.filter(
    ee.Filter.eq(
      'passB_auto_accept',
      1
    )
  );


// ------------------------------------------------
// Dedupe identical Landsat pixels.
//
// At this stage a pixel is already required to agree with
// its source class, so cross-class duplicate acceptance should
// not occur under a single best-class model.
// ------------------------------------------------

var acceptedCandidates =
  acceptedCandidatesRaw.distinct(
    [
      'pixel_key'
    ]
  );


print(
  '----------------------------------------'
);

print(
  'PASS-B ACCEPTANCE'
);

print(
  '----------------------------------------'
);


print(
  ee.Dictionary({

    accepted_before_dedup:
      acceptedCandidatesRaw.size(),

    accepted_after_dedup:
      acceptedCandidates.size()
  })
);


print(
  'Accepted candidate class histogram'
