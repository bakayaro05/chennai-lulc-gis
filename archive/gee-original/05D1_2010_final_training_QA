  stack2010

    .select(
      PREDICTORS
    )

    .addBands(
      stack2010.select(
        'clear_count'
      )
    )

    .addBands(
      pixelXY
    );


// ================================================================
// 17. FRESHLY SAMPLE ALL FINAL TRAINING PIXELS
// ================================================================

var finalTrainingCandidate =
  finalSamplingImage.sampleRegions({

    collection:
      selectedLabels,

    properties: [

      'class_id',
      'class_name',
      'poly_id',
      'candidate_source',
      'original_auth_pixel_key',
      'final_select_random',
      'final_selection_stage',
      'target_year'

    ],

    scale:
      SCALE,

    projection:
      stackProjection,

    geometries:
      true,

    tileScale:
      4

  });


// ================================================================
// 18. RECREATE FINAL PIXEL KEY + VERIFY SNAP
// ================================================================

finalTrainingCandidate =
  finalTrainingCandidate.map(
    function(feature) {

      var px =
        ee.Number(
          feature.get(
            'final_px'
          )
        );


      var py =
        ee.Number(
          feature.get(
            'final_py'
          )
        );


      var key =
        px.format(
          '%.0f'
        )
        .cat(
          '_'
        )
        .cat(
          py.format(
            '%.0f'
          )
        );


      var originalKey =
        ee.String(
          feature.get(
            'original_auth_pixel_key'
          )
        );


      var keyMatch =
        key.compareTo(
          originalKey
        )
        .eq(
          0
        );


      return feature.set({

        auth_pixel_key:
          key,

        pixel_key_match:
          ee.Number(
            ee.Algorithms.If(
              keyMatch,
              1,
              0
            )
          )

      });

    }
  );


