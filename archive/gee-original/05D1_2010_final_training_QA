// ================================================================
// 9. SELECT ONE QUOTA GROUP
// ================================================================

function selectQuota(
  spec,
  index
) {

  var classId =
    spec.class_id;


  var polyId =
    spec.poly_id;


  var quota =
    spec.quota;


  var seed =
    SEED_BASE + index;


  var available =
    candidatePool

      .filter(
        ee.Filter.eq(
          'class_id',
          classId
        )
      )

      .filter(
        ee.Filter.eq(
          'poly_id',
          polyId
        )
      );


  var selected =
    available

      .randomColumn(
        'final_select_random',
        seed
      )

      .sort(
        'final_select_random'
      )

      .limit(
        quota
      )

      .map(
        function(feature) {

          return feature.set({

            final_training_selected:
              1,

            final_selection_stage:
              '05D1_diversity_aware',

            final_requested_quota:
              quota

          });

        }
      );


  return selected;

}


