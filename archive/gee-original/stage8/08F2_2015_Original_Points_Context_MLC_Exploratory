   'ORIGINAL 2015 MLC',
   true
 );

 Map.addLayer(
   experimentalMap,
   {min: 1, max: 5, palette: palette},
   'EXPERIMENTAL 08F MLC',
   false
 );

 Map.addLayer(
   ROI.style({
