   true
 );

 Map.addLayer(
   strict15,
   {min:1,max:5,palette:palette},
   '2015 STRICT GHSL FUSION',
   false
 );

 Map.addLayer(
   strict15Mask.selfMask(),
   {palette:['00ffff']},
   '2015 NEW BUILT-UP',
   false
 );

 Map.addLayer(
   old25,
   {min:1,max:5,palette:palette},
   '2025 ORIGINAL',
   false
 );

 Map.addLayer(
   conservative25,
   {min:1,max:5,palette:palette},
   '2025 CONSERVATIVE FUSION',
   false
 );

 Map.addLayer(
   extended25,
   {min:1,max:5,palette:palette},
   '2025 EXTENDED FUSION',
   false
 );

 Map.addLayer(
   legacy25Mask.selfMask(),
   {palette:['00ffff']},
   '2025 GAIA + DW ADDITIONS',
   false
 );

 Map.addLayer(
   extra25Mask.selfMask(),
   {palette:['ff00ff']},
   '2025 DW-ONLY ADDITIONS',
   false
 );

 Map.centerObject(roi,10);

