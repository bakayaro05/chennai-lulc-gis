
 // =============================================================
 // CHENNAI LULC - STAGE 08G-5 (FIXED)
 // 2015 GAIA + WORLD SETTLEMENT FOOTPRINT FUSION
 // Read-only comparison: original MLC vs experimental RF vs fusion.
 // NO export, NO retraining, NO changes to original assets.
 // =============================================================

 var ROOT = 'projects/assignment-482806/assets/';
 var roi = ee.FeatureCollection(ROOT + 'chennai_admin_study_area_clean').geometry();
 var baseline = ee.Image(ROOT + 'chennai_mlc_lulc_2015')
   .select(0).rename('baseline');
 var rf2015 = ee.Image(ROOT + 'chennai_2015_08G3_gaia_assisted_RF_experimental_v1')
   .select(0).rename('rf2015');
 var validation = ee.FeatureCollection(ROOT + 'chennai_validation_2015_final');

 var CRS = 'EPSG:32644';
 var GRID = [30, 0, 399060, 0, -30, 1463250];
 var MIN_SETTLEMENT_FRACTION = 0.67;

 // -------------------------------------------------------------
 // 1. GAIA HISTORICAL IMPERVIOUS LAYER
 // -------------------------------------------------------------
 var gaia = ee.Image('Tsinghua/FROM-GLC/GAIA/v10')
   .select('change_year_index').unmask(0);
 var gaiaBy2015 = gaia.gte(4).and(gaia.lte(34));

 // -------------------------------------------------------------
 // 2. WSF2015 (FIXED BAND SELECTION AND PIXEL ENCODING)
 // -------------------------------------------------------------
 var wsfRaw = ee.Image('DLR/WSF/WSF2015/v1');

 // Your EE Console exposes the first band as "WSF"; catalogs can
 // display another band name. Selecting by index handles both.
 // WSF settlement pixels are positive (typically 255), while
 // unmasked background is zero. gt(0) is encoding-robust.

 var wsfBinary10 = wsfRaw.select(0).unmask(0)
   .gt(0).toFloat().rename('wsf_binary_10m');

 // Aggregate 10 m settlement pixels to the exact 30 m study grid.

 var wsfFraction30 = wsfBinary10.reduceResolution({
   reducer: ee.Reducer.mean(),
   maxPixels: 1024
 }).reproject({
   crs: CRS,
   crsTransform: GRID
 }).rename('WSF2015_fraction_30m');

 var highSettlement = wsfFraction30.gte(MIN_SETTLEMENT_FRACTION);

 // -------------------------------------------------------------
 // 3. TARGETED CLASS 4/5 -> BUILT-UP FUSION
 // -------------------------------------------------------------
 var openOrBarren = baseline.eq(4).or(baseline.eq(5));
 var promote = openOrBarren.and(gaiaBy2015).and(highSettlement);
 var fusion = baseline.where(promote, 1).rename('fusion').toByte();

 // -------------------------------------------------------------
 // 4. PAIRED VALIDATION ON THE ORIGINAL 300 POINTS
 // -------------------------------------------------------------
 var paired = baseline.addBands([rf2015, fusion]).sampleRegions({
   collection: validation,
   properties: ['class_id'],
   projection: baseline.projection(),
   tileScale: 8,
   geometries: false
 }).map(function (f) {
   var truth = ee.Number(f.get('class_id'));
   var oldLabel = ee.Number(f.get('baseline'));
   var newLabel = ee.Number(f.get('fusion'));
   return f.set({
     changed: oldLabel.neq(newLabel),
     correctness_delta: newLabel.eq(truth).subtract(oldLabel.eq(truth))
   });
 });

 var ORDER = [1, 2, 3, 4, 5];
 var cmOld = paired.errorMatrix('class_id', 'baseline', ORDER);
 var cmRF = paired.errorMatrix('class_id', 'rf2015', ORDER);
 var cmFusion = paired.errorMatrix('class_id', 'fusion', ORDER);
 var BU = paired.filter(ee.Filter.eq('class_id', 1));
 var notBU = paired.filter(ee.Filter.neq('class_id', 1));

 function truePositives(predictionBand) {
   return BU.filter(ee.Filter.eq(predictionBand, 1)).size();
 }

 function falsePositives(predictionBand) {
   return notBU.filter(ee.Filter.eq(predictionBand, 1)).size();
 }

 // -------------------------------------------------------------
 // 5. CITYWIDE AREA SUMMARIES (COMMON VALID PIXELS)
 // -------------------------------------------------------------
 var commonMask = baseline.mask().and(rf2015.mask()).and(fusion.mask());

 function areaKm2(mask, bandName) {
   return ee.Image.pixelArea().divide(1e6)
     .updateMask(mask).updateMask(commonMask).rename(bandName);
 }

 var areaStack = ee.Image.cat([
   areaKm2(baseline.eq(1), 'original_BU_km2'),
   areaKm2(rf2015.eq(1), 'RF_BU_km2'),
   areaKm2(fusion.eq(1), 'fusion_BU_km2'),
   areaKm2(promote, 'fusion_new_BU_km2'),
   areaKm2(promote.and(baseline.eq(4)), 'new_BU_from_class4_km2'),
   areaKm2(promote.and(baseline.eq(5)), 'new_BU_from_class5_km2'),
   areaKm2(gaiaBy2015.and(openOrBarren), 'GAIA2015_vs_open_barren_km2'),
   areaKm2(highSettlement.and(openOrBarren), 'WSF2015_vs_open_barren_km2'),
   areaKm2(promote, 'GAIA_WSF_agreement_in_open_barren_km2'),
   areaKm2(commonMask, 'common_valid_area_km2')
 ]);

 var areas = areaStack.reduceRegion({
   reducer: ee.Reducer.sum(),
   geometry: roi,
   crs: CRS,
   crsTransform: GRID,
   maxPixels: 1e8,
   tileScale: 8
 });

 // -------------------------------------------------------------
 // 6. CONSOLE QA
 // -------------------------------------------------------------
 print('=================================================');
 print('STAGE 08G-5 FIXED | 2015 GAIA + WSF FUSION');
 print('=================================================');

 print('WSF original band names (first band selected):');
 print(wsfRaw.bandNames());

 print('WSF settlement binary: > 0 = settlement; background = 0');

 print('WSF threshold (fraction of 30m pixel):');
 print(MIN_SETTLEMENT_FRACTION);

 print('Baseline grid:');
 print(baseline.projection());

 print('RF grid:');
 print(rf2015.projection());

 print('Validation count (expect 300):');
 print(paired.size());

 print('ORIGINAL 2015 MLC confusion matrix:');
 print(cmOld);

 print('EXPERIMENTAL 2015 RF confusion matrix:');
 print(cmRF);

 print('NEW GAIA+WSF 2015 fusion confusion matrix:');
 print(cmFusion);

 print('OVERALL ACCURACY:');
 print(ee.Dictionary({
   original: cmOld.accuracy(),
   rf: cmRF.accuracy(),
   fusion: cmFusion.accuracy()
 }));

 print('BUILT-UP RECALL:');
 print(ee.Dictionary({
   original: cmOld.producersAccuracy().get([0, 0]),
   rf: cmRF.producersAccuracy().get([0, 0]),
   fusion: cmFusion.producersAccuracy().get([0, 0])
 }));

 print('BUILT-UP TRUE POSITIVES:');
 print(ee.Dictionary({
   original: truePositives('baseline'),
   rf: truePositives('rf2015'),
   fusion: truePositives('fusion')
 }));

 print('BUILT-UP FALSE POSITIVES:');
 print(ee.Dictionary({
   original: falsePositives('baseline'),
   rf: falsePositives('rf2015'),
   fusion: falsePositives('fusion')
 }));

 print('FUSION vs ORIGINAL PAIRED CHANGES:');
 print(ee.Dictionary({
   changed: paired.filter(ee.Filter.eq('changed', 1)).size(),
   corrected: paired.filter(ee.Filter.eq('correctness_delta', 1)).size(),
   worsened: paired.filter(ee.Filter.eq('correctness_delta', -1)).size()
 }));

 print('CITYWIDE AREAS (km2):');
 print(areas);

 print('GAIA and WSF are remotely sensed evidence, not ground truth.');
 print('Original validation reused. Results are exploratory.');
 print('READ ONLY. NO EXPORTS. ORIGINAL ASSETS UNCHANGED.');

 // -------------------------------------------------------------
 // 7. MAP VISUALIZATION
 // -------------------------------------------------------------
 var palette = ['ff0000', '008000', '0000ff', 'ffff00', 'd2b48c'];

 Map.layers().reset();
 Map.setOptions('SATELLITE');

 Map.addLayer(
   baseline,
   {min:1, max:5, palette:palette},
   '2015 ORIGINAL MLC',
   true
 );

 Map.addLayer(
   fusion,
   {min:1, max:5, palette:palette},
   '2015 GAIA+WSF FUSION',
   false
 );

 Map.addLayer(
   rf2015,
   {min:1, max:5, palette:palette},
   '2015 GAIA-assisted RF',
   false
 );

 Map.addLayer(
   promote.selfMask(),
   {palette:['00ffff']},
   '2015 NEW BUILT-UP FROM FUSION',
   false
 );

 Map.addLayer(
   wsfFraction30,
   {
     min:0,
     max:1,
     palette:['ffffff','ff0000']
   },
   '2015 WSF SETTLEMENT FRACTION (30m)',
   false
 );

 Map.centerObject(roi, 10);

