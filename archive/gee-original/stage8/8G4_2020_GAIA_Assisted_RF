
 // =============================================================
 // CHENNAI LULC — STAGE 08G-4
 // AUTOMATED GAIA-ASSISTED RANDOM FOREST | YEAR 2020
 // Experimental candidate; all original assets remain locked.
 // No manual verification and no SNIC recalculation.
 // =============================================================

 var ROOT = 'projects/assignment-482806/assets/';
 var roi = ee.FeatureCollection(
   ROOT + 'chennai_admin_study_area_clean'
 ).geometry();

 var originalTraining = ee.FeatureCollection(
   ROOT + 'chennai_training_2020_final'
 );

 var originalValidation = ee.FeatureCollection(
   ROOT + 'chennai_validation_2020_final'
 );

 var baseline = ee.Image(
   ROOT + 'chennai_mlc_lulc_2020'
 ).select(0).rename('baseline');

 var grid = baseline.projection();

 var BAND9 = [
   'blue','green','red','nir','swir1','swir2',
   'NDVI','NDWI','NDBI'
 ];

 var PREDICTORS = BAND9.concat([
   'BSI','NDBI_mean5'
 ]);

 var N_PER_GROUP = 150;
 var SEED = 20261022;

 var OUT_ASSET = ROOT +
   'chennai_2020_08G4_gaia_assisted_RF_experimental_v1';

 // =============================================================
 // 1. RECONSTRUCT THE 2020 LANDSAT COMPOSITE
 // =============================================================

 function preprocess(image) {

   var clear = image.select('QA_PIXEL')
     .bitwiseAnd(63).eq(0)
     .and(image.select('QA_RADSAT').eq(0));

   return image.select(
       ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'],
       ['blue','green','red','nir','swir1','swir2']
     )
     .multiply(0.0000275)
     .subtract(0.2)
     .updateMask(clear);
 }

 var scenes = ee.ImageCollection(
   'LANDSAT/LC08/C02/T1_L2'
 )
   .filterBounds(roi)
   .filterDate('2020-01-01','2021-01-01')
   .map(preprocess);

 var median = scenes.median();

 var blue = median.select('blue');
 var red = median.select('red');
 var green = median.select('green');
 var nir = median.select('nir');
 var swir1 = median.select('swir1');

 var spectral = median.addBands([
   nir.subtract(red)
     .divide(nir.add(red))
     .rename('NDVI'),

   green.subtract(nir)
     .divide(green.add(nir))
     .rename('NDWI'),

   swir1.subtract(nir)
     .divide(swir1.add(nir))
     .rename('NDBI'),

   swir1.add(red)
     .subtract(nir)
     .subtract(blue)
     .divide(
       swir1.add(red).add(nir).add(blue)
     )
     .rename('BSI')
 ]).reproject(grid);

 var ndbi5 = spectral.select('NDBI')
   .reduceNeighborhood({
     reducer: ee.Reducer.mean(),
     kernel: ee.Kernel.square({
       radius:2,
       units:'pixels',
       normalize:false
     }),
     skipMasked:true
   })
   .rename('NDBI_mean5');

 var stack = spectral.addBands(ndbi5)
   .select(PREDICTORS)
   .clip(roi);

 // =============================================================
 // 2. GAIA-ASSISTED AUTOMATIC REFERENCE MINING
 // =============================================================

 // GAIA 2015: evidence of established impervious land.
 // GAIA 2018: latest GAIA evidence for non-impervious land.
 // GAIA is NOT included as an RF predictor.

 var gaia = ee.Image(
   'Tsinghua/FROM-GLC/GAIA/v10'
 )
   .select('change_year_index')
   .unmask(0)
   .reproject(grid);

 var by2015 = gaia.gte(4)
   .and(gaia.lte(34));

 var by2018 = gaia.gte(1)
   .and(gaia.lte(34));

 // Exclude a 90m neighbourhood of all original
 // training and validation points from pseudo-training.

 var excluded = originalTraining
   .merge(originalValidation)
   .map(function(f) {
     return ee.Feature(
       f.geometry().buffer(90)
     );
   });

 var nearReference = ee.Image.constant(0)
   .toByte()
   .paint(excluded,1)
   .reproject(grid);

 var eligible = nearReference.eq(0);

 // Four supplementary training groups:
 //
 // 1. GAIA impervious by 2015, 2020 class 4 -> Built-up
 // 2. GAIA impervious by 2015, 2020 class 5 -> Built-up
 // 3. Not GAIA impervious by 2018, class 4 -> class 4
 // 4. Not GAIA impervious by 2018, class 5 -> class 5
 //
 // These are pseudo-labels, not verified ground truth.
 // Some buildings added in 2019-2020 could be included
 // incorrectly among the negative examples.

 var pos4 = by2015.and(baseline.eq(4));
 var pos5 = by2015.and(baseline.eq(5));

 var neg4 = by2018.not().and(baseline.eq(4));
 var neg5 = by2018.not().and(baseline.eq(5));

 var strata = ee.Image.constant(0)
   .toByte()
   .where(pos4,1)
   .where(pos5,2)
   .where(neg4,3)
   .where(neg5,4)
   .rename('stratum');

 strata = strata
   .updateMask(strata.gt(0))
   .updateMask(eligible)
   .clip(roi);

 var pseudo = strata.addBands(stack)
   .stratifiedSample({
     numPoints:0,
     classBand:'stratum',
     region:roi,
     projection:grid,
     classValues:[1,2,3,4],
     classPoints:[
       N_PER_GROUP,
       N_PER_GROUP,
       N_PER_GROUP,
       N_PER_GROUP
     ],
     seed:SEED,
     tileScale:8,
     dropNulls:true,
     geometries:false
   })
   .map(function(f) {

     var group = ee.Number(f.get('stratum'));

     var cid = ee.Number(
       ee.Algorithms.If(
         group.lte(2),
         1,
         ee.Algorithms.If(
           group.eq(3),
           4,
           5
         )
       )
     );

     return f.set({
       class_id:cid,
       rf_label:cid.subtract(1),
       reference_source:'GAIA_assisted_pseudo'
     });
   });

 // =============================================================
 // 3. PRESERVE ORIGINAL 2020 TRAINING LABELS
 // =============================================================

 var manual = stack.sampleRegions({
   collection:originalTraining,
   properties:['class_id'],
   projection:grid,
   tileScale:8,
   geometries:false
 }).map(function(f) {

   return f.set({
     rf_label:ee.Number(
       f.get('class_id')
     ).subtract(1),

     reference_source:'original_training'
   });
 });

 var train = manual.merge(pseudo);

 // =============================================================
 // 4. TRAIN FIVE-CLASS RANDOM FOREST
 // =============================================================

 var classifier = ee.Classifier
   .smileRandomForest({
     numberOfTrees:160,
     minLeafPopulation:3,
     bagFraction:0.7,
     seed:SEED
   })
   .train({
     features:train,
     classProperty:'rf_label',
     inputProperties:PREDICTORS
   });

 var candidate = stack.classify(classifier)
   .add(1)
   .toByte()
   .rename('candidate')
   .updateMask(baseline.mask())
   .clip(roi);

 // =============================================================
 // 5. EXISTING VALIDATION — EXPLORATORY COMPARISON
 // =============================================================

 var checked = baseline.addBands(candidate)
   .sampleRegions({
     collection:originalValidation,
     properties:['class_id'],
     projection:grid,
     tileScale:8,
     geometries:false
   })
   .map(function(f) {

     var actual = ee.Number(f.get('class_id'));

     var oldClass = ee.Number(
       f.get('baseline')
     );

     var newClass = ee.Number(
       f.get('candidate')
     );

     return f.set(
       'correctness_delta',
       newClass.eq(actual).subtract(
         oldClass.eq(actual)
       )
     );

   });

 var ORDER = [1,2,3,4,5];

 var cmOld = checked.errorMatrix(
   'class_id',
   'baseline',
   ORDER
 );

 var cmNew = checked.errorMatrix(
   'class_id',
   'candidate',
   ORDER
 );

 var bu = checked.filter(
   ee.Filter.eq('class_id',1)
 );

 var nonBU = checked.filter(
   ee.Filter.neq('class_id',1)
 );

 // =============================================================
 // 6. CONSOLE RESULTS
 // =============================================================

 print('==========================================');
 print('STAGE 08G-4 | 2020 GAIA-ASSISTED RF');
 print('==========================================');

 print('Landsat scenes (expected 21):');
 print(scenes.size());

 print('Original training (expected 600):');
 print(manual.size());

 print('Original class balance:');
 print(
   manual.aggregate_histogram('class_id')
 );

 print('Pseudo-training groups (target 150 each):');
 print(
   pseudo.aggregate_histogram('stratum')
 );

 print('Total training class balance:');
 print(
   train.aggregate_histogram('class_id')
 );

 print('Validation records (expected 300):');
 print(checked.size());

 print('Original 2020 confusion matrix:');
 print(cmOld);

 print('New RF 2020 confusion matrix:');
 print(cmNew);

 print('Original / RF overall accuracy:');
 print(ee.Dictionary({
   original:cmOld.accuracy(),
   RF:cmNew.accuracy()
 }));

 print('Original / RF Built-up recall:');
 print(ee.Dictionary({
   original:cmOld.producersAccuracy().get([0,0]),
   RF:cmNew.producersAccuracy().get([0,0])
 }));

 print('Built-up true positives:');
 print(ee.Dictionary({
   original:bu.filter(
     ee.Filter.eq('baseline',1)
   ).size(),

   RF:bu.filter(
     ee.Filter.eq('candidate',1)
   ).size()
 }));

 print('Built-up false positives:');
 print(ee.Dictionary({
   original:nonBU.filter(
     ee.Filter.eq('baseline',1)
   ).size(),

   RF:nonBU.filter(
     ee.Filter.eq('candidate',1)
   ).size()
 }));

 print('Paired correct / incorrect changes:');
 print(ee.Dictionary({
   improved:checked.filter(
     ee.Filter.eq('correctness_delta',1)
   ).size(),

   worsened:checked.filter(
     ee.Filter.eq('correctness_delta',-1)
   ).size()
 }));

 print('No original assets modified.');
 print('Do not export until Console QA is checked.');

 // =============================================================
 // 7. MAP DISPLAY
 // =============================================================

 var palette = [
   'ff0000',
   '008000',
   '0000ff',
   'ffff00',
   'd2b48c'
 ];

 Map.layers().reset();
 Map.setOptions('SATELLITE');

 Map.addLayer(
   baseline,
   {min:1,max:5,palette:palette},
   '2020 ORIGINAL MLC',
   true
 );

 Map.addLayer(
   candidate,
   {min:1,max:5,palette:palette},
   '2020 EXPERIMENTAL RF',
   false
 );

 Map.addLayer(
   candidate.eq(1)
     .and(baseline.neq(1))
     .selfMask(),
   {palette:['00ffff']},
   '2020 NEW BUILT-UP',
   false
 );

 Map.addLayer(
   baseline.eq(1)
     .and(candidate.neq(1))
     .selfMask(),
   {palette:['ff00ff']},
   '2020 BUILT-UP LOST',
   false
 );

 Map.centerObject(roi,10);

 // =============================================================
 // 8. EXPERIMENTAL EXPORT TASK
 // =============================================================

 // DO NOT START until sample counts and validation
 // results have been reviewed.
 //
 // Output is a NEW experimental asset only.

 Export.image.toAsset({
   image:candidate,
   description:
     'Chennai_2020_08G4_GAIA_RF_experimental_v1',

   assetId:OUT_ASSET,
   region:roi,

   crs:'EPSG:32644',

   crsTransform:[
     30,0,399060,
     0,-30,1463250
   ],

   maxPixels:1e9,

   pyramidingPolicy:{
     '.default':'mode'
   }
 });

 // =============================================================
 // END STAGE 08G-4
 // =============================================================
