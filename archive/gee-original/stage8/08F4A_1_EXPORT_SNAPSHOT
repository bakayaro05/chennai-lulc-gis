
// ============================================================
// CHENNAI LULC - STAGE 08F-4A / PART 1
// MEMORY-SAFE SNIC SAMPLE SNAPSHOT (NEW ASSET ONLY)
// 2015 X3 parameters frozen. No original asset modification.
// ============================================================

var ROOT = 'projects/assignment-482806/assets/';
var OUTPUT = ROOT + 'chennai_08f4a_X3_point_snapshot_v1';

var roi = ee.FeatureCollection(
  ROOT + 'chennai_admin_study_area_clean'
).geometry();

var training = ee.FeatureCollection(
  ROOT + 'chennai_training_2015_final'
);

var validation = ee.FeatureCollection(
  ROOT + 'chennai_validation_2015_final'
);

var originalMap = ee.Image(
  ROOT + 'chennai_mlc_lulc_2015'
).select(0).rename('baseline');

var grid = originalMap.projection();

var BANDS9 = [
  'blue', 'green', 'red', 'nir', 'swir1', 'swir2',
  'NDVI', 'NDWI', 'NDBI'
];

// ============================================================
// 1. ORIGINAL LANDSAT PREPROCESSING
// ============================================================

function prep(image) {
  var qa = image.select('QA_PIXEL');

  var good = qa.bitwiseAnd(63).eq(0)
    .and(image.select('QA_RADSAT').eq(0));

  return image.select(
      ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'],
      ['blue','green','red','nir','swir1','swir2']
    )
    .multiply(0.0000275)
    .subtract(0.2)
    .updateMask(good)
    .copyProperties(image, ['system:time_start']);
}

function indices(im) {
  var red = im.select('red');
  var green = im.select('green');
  var nir = im.select('nir');
  var swir1 = im.select('swir1');

  return im.addBands([
    nir.subtract(red)
      .divide(nir.add(red))
      .rename('NDVI'),

    green.subtract(nir)
      .divide(green.add(nir))
      .rename('NDWI'),

    swir1.subtract(nir)
      .divide(swir1.add(nir))
      .rename('NDBI')
  ]).select(BANDS9);
}

var scenes = ee.ImageCollection(
  'LANDSAT/LC08/C02/T1_L2'
)
  .filterBounds(roi)
  .filterDate('2015-01-01', '2016-01-01')
  .map(prep);

var spectral = indices(
  scenes.median()
).reproject(grid);

// ============================================================
// 2. RECREATE IDENTICAL X3 SNIC SEGMENTATION
// ============================================================

// Do not change these parameters.
// They are identical to the successful Stage 08F-4 trial.

var snic = ee.Algorithms.Image.Segmentation.SNIC({
  image: spectral,
  size: 5,
  compactness: 0.1,
  connectivity: 8,
  neighborhoodSize: 64
}).reproject(grid);

var segmentRedSD = spectral.select('red')
  .addBands(snic.select('clusters'))
  .reduceConnectedComponents({
    reducer: ee.Reducer.stdDev(),
    labelBand: 'clusters',
    maxSize: 256
  })
  .rename('segment_red_sd');

// ============================================================
// 3. BUILD SAMPLE-ONLY IMAGE
// ============================================================

var sampleImage = spectral
  .addBands(
    snic.select('NDBI_mean')
      .rename('segment_NDBI_mean')
  )
  .addBands(segmentRedSD)
  .addBands(
    snic.select('clusters')
      .rename('segment_id')
  )
  .addBands(originalMap)
  .clip(roi);

// ============================================================
// 4. LABEL ORIGINAL TRAINING AND VALIDATION POINTS
// ============================================================

// Archive the original spectral values for QA.

var trainMarked = training.map(function(f) {
  return ee.Feature(f.geometry(), {
    split: 'training',
    class_id: f.get('class_id'),
    source_index: f.id(),
    source_poly_id: f.get('poly_id'),
    archive_red: f.get('red'),
    archive_NDBI: f.get('NDBI')
  });
});

var validationMarked = validation.map(function(f) {
  return ee.Feature(f.geometry(), {
    split: 'validation',
    class_id: f.get('class_id'),
    source_index: f.id(),
    source_poly_id: f.get('val_poly_id'),
    archive_red: -999,
    archive_NDBI: -999
  });
});

// ============================================================
// 5. SNAPSHOT ONLY THE ORIGINAL 900 REFERENCE POINTS
// ============================================================

// No raster-wide Gaussian classification.
// No repeated confusion-matrix evaluation.
//
// Batch export materializes the expensive SNIC predictors
// once, making the later audit much cheaper.

var samples = sampleImage.sampleRegions({
  collection: trainMarked.merge(validationMarked),

  properties: [
    'split',
    'class_id',
    'source_index',
    'source_poly_id',
    'archive_red',
    'archive_NDBI'
  ],

  projection: grid,

  // Keep small point geometries for the asset table.
  geometries: true,

  tileScale: 16
});

// ============================================================
// 6. CONSOLE QA
// ============================================================

print('==========================================');
print('STAGE 08F-4A | PART 1');
print('ONE-TIME SNIC POINT SNAPSHOT');
print('==========================================');

print('Destination asset:');
print(OUTPUT);

print('Training source count (expected 600):');
print(training.size());

print('Validation source count (expected 300):');
print(validation.size());

print('Landsat scenes (expected 19):');
print(scenes.size());

print('SNIC configuration:');
print('size=5, compactness=0.1, connectivity=8');
print('neighborhoodSize=64, red SD maxSize=256');

print('Start the export from the TASKS tab.');
print('Wait until task status is COMPLETED.');
print('Then run Stage 08F-4A Part 2.');

// ============================================================
// 7. EXPORT NEW TEMPORARY ASSET
// ============================================================

// Important:
// This is a NEW asset.
// The original training, validation and classification
// assets are NOT modified.
//
// If this output asset already exists, do not overwrite it.

Export.table.toAsset({
  collection: samples,
  description: 'Chennai_08F4A_X3_PointSnapshot_v1',
  assetId: OUTPUT
});

// Deliberately no Map layers.
// Avoid extra SNIC computations from map rendering.

// ============================================================
// END STAGE 08F-4A PART 1
// ============================================================
