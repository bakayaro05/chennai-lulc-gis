});

// ================================================================
// 5. ORIGINAL GAUSSIAN CLASS PARAMETERS
//
// Five classes, nine features.
// Covariance regularization: +1e-6 I
// Equal class priors.
// ================================================================

function gaussianParams(classId) {

  var data = training.filter(
    ee.Filter.eq('class_id', classId)
  );

  var mean = ee.Array([
    BANDS.map(function(b) {
      return data.aggregate_mean(b);
    })
  ]).transpose();

  var covariance = ee.Array(

    data.makeArray(
      BANDS,
      'mlc_values'
    ).reduceColumns({

      reducer: ee.Reducer.covariance()
        .setOutputs(['covariance']),

      selectors: ['mlc_values']

    }).get('covariance')

  ).add(
    ee.Array.identity(9).multiply(1e-6)
  );

  return ee.Dictionary({

    mu: mean,

    inverse: covariance.matrixInverse(),

    logdet: ee.Number(
      covariance.matrixDeterminant()
    ).max(1e-300).log()

  });

}

var PARAMETERS = {};

CLASSES.forEach(function(classId) {

  PARAMETERS[classId] = gaussianParams(classId);

});

// ================================================================
// 6. GAUSSIAN SCORE AT ONE SAMPLED PIXEL
// ================================================================

function scorePoint(x, classId) {

  var p = PARAMETERS[classId];

  var delta = x.subtract(
    ee.Array(p.get('mu'))
  );

  var distance2 = delta.transpose()
    .matrixMultiply(
      ee.Array(p.get('inverse'))
    )
    .matrixMultiply(delta)
    .get([0, 0]);

  return ee.Number(distance2)
    .multiply(-0.5)
    .subtract(
      ee.Number(p.get('logdet')).multiply(0.5)
    );

}

// ================================================================
// 7. EVALUATE ALL TEN REVIEWED PIXELS
// ================================================================

var results = sampled.map(function(f) {

  var x = ee.Array(
    ee.List(BANDS).map(function(b) {
      return ee.Number(f.get(b));
    })
  ).reshape([9, 1]);

  var s1 = scorePoint(x, 1);
  var s2 = scorePoint(x, 2);
  var s3 = scorePoint(x, 3);
  var s4 = scorePoint(x, 4);
  var s5 = scorePoint(x, 5);

  var scores = [
    s1, s2, s3, s4, s5
  ];

  var winner = ee.Number(1);
  var best = s1;

  for (var i = 1; i < CLASSES.length; i++) {

    var better = ee.Number(
      scores[i]
    ).gt(best);

    winner = ee.Number(
      ee.Algorithms.If(
        better,
        CLASSES[i],
        winner
      )
    );

    best = best.max(
      ee.Number(scores[i])
    );

  }

  var archived = ee.Number(
    f.get('saved_2015_5class')
  );

  var openScore = s4.max(s5);

  // Positive: Built-up preferred over both open classes.
  // Negative: at least one open class preferred to Built-up.
  // This is NOT a probability or accuracy percentage.

  var margin = s1.subtract(openScore);

  var openWinner = ee.Number(
    ee.Algorithms.If(
      s4.gte(s5),
      4,
      5
    )
  );

  return f.set({

    gaussian_rebuilt_class: winner,

    score_matches_saved: winner.eq(archived),

    score_1_built: s1,

    score_2_vegetation: s2,

    score_3_water: s3,

    score_4_agricultural: s4,

    score_5_barren: s5,

    strongest_open_class: openWinner,

    built_minus_open_margin: margin,

    saved2015_is_open:
      archived.eq(4).or(archived.eq(5)),

    mapped_disagreement_2010_built_2015_open:
      ee.Number(
        f.get('saved_2010_5class')
      ).eq(1).and(
        archived.eq(4).or(archived.eq(5))
      )

  });

}).sort('site_id');

