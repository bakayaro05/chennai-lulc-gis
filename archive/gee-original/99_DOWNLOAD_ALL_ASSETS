// =============================================================
// 3. HELPER FUNCTION FOR VECTOR / TABLE EXPORTS
// =============================================================

function exportVector(assetName) {

  var fc = ee.FeatureCollection(
    PROJECT + assetName
  );

  Export.table.toDrive({
    collection: fc,
    description: 'EXPORT_' + assetName,
    folder: DRIVE_FOLDER,
    fileNamePrefix: assetName,
    fileFormat: 'GeoJSON'
  });

}


