    );


// ============================================================================
// 18. CROSS-CLASS PIXEL CONFLICT QA
// ============================================================================

var uniqueAcceptedPixelKeys =
  acceptedEligible
    .distinct([
      'auth_pixel_key'
    ]);


var pixelJoin =
  ee.Join.saveAll(
    'pixel_matches'
  );


var pixelJoinCondition =
  ee.Filter.equals({

    leftField:
      'auth_pixel_key',

    rightField:
      'auth_pixel_key'

  });


var joinedPixels =
  ee.FeatureCollection(

    pixelJoin.apply(

      uniqueAcceptedPixelKeys,

      acceptedEligible,

      pixelJoinCondition

    )

  );


var pixelConflictQA =
  joinedPixels.map(
    function(feature) {

      var matches =
        ee.FeatureCollection(
          ee.List(
            feature.get(
              'pixel_matches'
            )
          )
        );


      var classList =
        ee.List(
          matches.aggregate_array(
            'class_id'
          )
        )
        .distinct()
        .sort();


      return ee.Feature(
        null,
        {

          auth_pixel_key:
            feature.get(
              'auth_pixel_key'
            ),

          row_n:
            matches.size(),

          distinct_class_n:
            classList.size(),

          classes:
            classList

        }
      );

    }
  );


var crossClassConflictPixels =
