// ============================================================================
// 6. HELPER — SELECT MANUALLY REVIEWED SOURCE GROUPS
// ============================================================================

function selectGroups(
  classId,
  className,
  polyIds,
  reviewStatus,
  macroSite
) {

  return transfer05A

    .filter(
      ee.Filter.eq(
        'class_id',
        classId
      )
    )

    .filter(
      ee.Filter.inList(
        'poly_id',
        polyIds
      )
    )

    .map(
      function(feature) {

        return feature.set({

          class_id:
            classId,

          class_name:
            className,

          manual_review_status:
            reviewStatus,

          macro_site:
            macroSite,

          review_stage:
            '06B_manual_training_review_V2'

        });

      }
    );

}


