//
// ============================================================================

var samplingImage =
  stack2010
    .select(
      predictors.concat([
        'clear_count'
      ])
    )
    .addBands(
      pixelCoordinates
    );


// ============================================================================
// 14. HELPER — SAMPLE REVIEWED SOURCE POINTS
// ============================================================================

function sampleReviewedSources(sourceFC) {

  var sampled =
    samplingImage.sampleRegions({

      collection:
        sourceFC,

      properties: [

        'class_id',
        'class_name',
        'poly_id',

        'transfer_status',

        'manual_review_status',

        'macro_site',

        'review_stage'

      ],

      scale:
        30,

      projection:
        projection2010,

      geometries:
        true,

      tileScale:
        4

    });


  return sampled.map(
    function(feature) {

      var x =
        ee.Number(
          feature.get(
            'pixel_x'
          )
        )
        .format(
          '%.0f'
        );


      var y =
        ee.Number(
          feature.get(
            'pixel_y'
          )
        )
        .format(
          '%.0f'
        );


      var pixelKey =
        ee.String(x)
          .cat('_')
          .cat(y);


      return feature.set({

        auth_pixel_key:
          pixelKey,

        candidate_source:
          '06B_manual_review_V2'

      });

    }
  );

}


