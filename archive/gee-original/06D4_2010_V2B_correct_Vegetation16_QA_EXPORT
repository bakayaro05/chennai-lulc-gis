// ============================================================================
// 5. PIXEL KEY HELPER
// ============================================================================

function addPixelKey(feature) {

  feature =
    ee.Feature(feature);

  var px =
    ee.Number(
      feature.get('px')
    )
    .format('%.6f');

  var py =
    ee.Number(
      feature.get('py')
    )
    .format('%.6f');

  var classId =
    ee.Number(
      feature.get('class_id')
    )
    .int();

  var pixelKey =
    px
      .cat('_')
      .cat(py);

  var pixelClassKey =
    classId
      .format('%d')
      .cat('_')
      .cat(pixelKey);

  return feature.set({

    auth_pixel_key:
      pixelKey,

    pixel_class_key:
      pixelClassKey

  });

}


