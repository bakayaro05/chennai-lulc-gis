// ============================================================================
// DIAGNOSTIC — FIND EXACT SOURCE OF THE 3 VALIDATION PROXIMITY VIOLATIONS
// ============================================================================

function getOverlappingTraining(leftCollection, label) {

  var pairs =
    ee.FeatureCollection(
      ee.Join.inner().apply(
        leftCollection,
        validation,
        within30m
      )
    );

  var trainingPoints =
    ee.FeatureCollection(
      pairs.map(
        function(pair) {

          pair =
            ee.Feature(pair);

          var trainingFeature =
            ee.Feature(
              pair.get('primary')
            );

          var validationFeature =
            ee.Feature(
              pair.get('secondary')
            );

          return trainingFeature.set({

            overlap_test_group:
              label,

            nearby_validation_class:
              validationFeature.get('class_id'),

            nearby_validation_index:
              validationFeature.get('system:index')

          });

        }
      )
    );

  // One training point could theoretically be close to >1 validation point,
  // so reduce to unique training pixels.
  return trainingPoints.distinct([
    'auth_pixel_key'
  ]);
}


