// ============================================================================
// 06D0B_2010_existing_training_reuse_QA_FAST
// ============================================================================
//
// FAST replacement for 06D0.
//
// PURPOSE
// -------
// Test whether existing TRAINING-SIDE 2010 material can supplement the
// manually reviewed 06C2 training pool before drawing any new polygons.
//
// REUSES:
//   05C1 Pass-B re-QA candidates
//   05C2A rescued uncertain candidates
//   05C3A targeted expansion
//   05C4E manual Barren training addition
//
// DOES NOT USE:
//   validation data
//   Built-up poly 11 (PARTIAL)
//   Barren poly 62 (PARTIAL)
//   Barren poly 61 (REJECT)
//
// QA ONLY.
// NO EXPORT.
// NO CLASSIFIER.
// NO BALANCING.
//
// ============================================================================


// ============================================================================
// 1. CONSTANTS
// ============================================================================

var CRS = 'EPSG:32644';
var SCALE = 30;
var TARGET = 120;

var PROJ =
  ee.Projection(CRS)
    .atScale(SCALE);

var PREDICTORS = [
  'blue',
  'green',
  'red',
  'nir',
  'swir1',
  'swir2',
  'NDVI',
  'NDWI',
  'NDBI'
];


// ============================================================================
// 2. ASSETS
// ============================================================================

var STACK_ASSET =
  'projects/assignment-482806/assets/chennai_predictor_stack_2010';

var QA05A_ASSET =
  'projects/assignment-482806/assets/chennai_transfer_2015_to_2010_QA_05A';

var C1_ASSET =
  'projects/assignment-482806/assets/chennai_2010_passB_reQA_05C1';

var C2A_ASSET =
  'projects/assignment-482806/assets/chennai_2010_rescued_uncertain_05C2A';

var C3A_ASSET =
  'projects/assignment-482806/assets/chennai_2010_targeted_expansion_05C3A';

var C4E_ASSET =
  'projects/assignment-482806/assets/chennai_2010_manual_barren_05C4E';


// ============================================================================
// 3. LOAD
// ============================================================================

var stack =
  ee.Image(STACK_ASSET);

var qa05A =
  ee.FeatureCollection(QA05A_ASSET);

var c1 =
  ee.FeatureCollection(C1_ASSET);

var c2a =
  ee.FeatureCollection(C2A_ASSET);

var c3a =
  ee.FeatureCollection(C3A_ASSET);

var c4e =
  ee.FeatureCollection(C4E_ASSET);


// ============================================================================
// 4. AUTHORITATIVE PIXEL GRID
// ============================================================================

var coords =
  ee.Image.pixelCoordinates(PROJ)
    .rename([
      'px',
      'py'
    ]);

var samplingImage =
  stack
    .select(
      PREDICTORS.concat([
        'clear_count'
      ])
    )
    .addBands(coords);


// ============================================================================
// 5. HELPERS
// ============================================================================

function addClassPolyKey(feature) {

  feature =
    ee.Feature(feature);

  var classId =
    ee.Number(
      feature.get('class_id')
    )
    .int();

  var polyId =
    ee.Number(
      feature.get('poly_id')
    )
    .int();

  return feature.set({

    class_id:
      classId,

    poly_id:
      polyId,

    class_poly_key:
      classId
        .format('%d')
        .cat('_')
        .cat(
          polyId.format('%d')
        )

  });

}


function addPixelKey(feature) {

  feature =
    ee.Feature(feature);

  // Pixel coordinates are FLOATS in this projection.
  // Preserve them instead of forcing integer formatting.

  var px =
    ee.Number(
      feature.get('px')
    )
    .format('%.6f');

  var py =
    ee.Number(
      feature.get('py')
    )
    .format('%.6f');

  var classId =
    ee.Number(
      feature.get('class_id')
    )
    .int()
    .format('%d');

  var key =
    px
      .cat('_')
      .cat(py);

  return feature.set({

    auth_pixel_key:
      key,

    pixel_class_key:
      classId
        .cat('_')
        .cat(key)

  });

}


function sampleCollection(collection) {

  return samplingImage

    .sampleRegions({

      collection:
        collection,

      properties: [
        'class_id',
        'poly_id',
        'class_poly_key',
        'reuse_asset'
      ],

      scale:
        SCALE,

      projection:
        PROJ,

      geometries:
        false,

      tileScale:
        8

    })

    .filter(
      ee.Filter.gte(
        'clear_count',
        2
      )
    )

    .map(
      addPixelKey
    );

}


// ============================================================================
// 6. FINAL 06B MANUAL ACCEPT LEDGER
// ============================================================================

var ACCEPT_KEYS = [

  // Built-up
  '1_1',
  '1_3',
  '1_4',
  '1_5',
  '1_6',
  '1_7',
  '1_8',
  '1_9',
  '1_12',

  // Vegetation
  '2_16',
  '2_17',
  '2_25',
  '2_26',

  // Water
  '3_31',
  '3_32',
  '3_35',
  '3_38',
  '3_39',
  '3_201',

  // Agricultural/Open
  '4_46',
  '4_47',
  '4_48',
  '4_51',
  '4_52',
  '4_53',
  '4_55',
  '4_56',
  '4_57',
  '4_59',
  '4_60',
  '4_202',

  // Barren/Fallow
  '5_63',
  '5_64',
  '5_65'
];


// ============================================================================
// 7. RECONSTRUCT 06C2 BASE
// ============================================================================

var baseSource =
  qa05A

    .map(
      addClassPolyKey
    )

    .filter(
      ee.Filter.inList(
        'class_poly_key',
        ACCEPT_KEYS
      )
    )

    .map(
      function(f) {

        return ee.Feature(f)
          .set(
            'reuse_asset',
            '06C2_manual_accept'
          );

      }
    );


var base =
  sampleCollection(
    baseSource
  )

    .distinct([
      'pixel_class_key'
    ]);


// ============================================================================
// 8. BASE QA
// ============================================================================

print(
  '========================================'
);

print(
  '06D0B — REBUILT 06C2 BASE'
);

print(
  '========================================'
);

print(
  ee.Dictionary({

    source_rows:
      baseSource.size(),

    expected_source_rows:
      533,

    clean_unique_pixels:
      base.size(),

    expected_clean_pixels:
      459

  })
);

print(
  'BASE CLASS HISTOGRAM — expected 104/120/46/120/69'
);

print(
  base.aggregate_histogram(
    'class_id'
  )
);


// ============================================================================
// 9. NORMALIZE HISTORICAL AUTOMATED TRAINING ASSETS
// ============================================================================

function prepareHistorical(
  collection,
  label
) {

  return collection

    .map(
      addClassPolyKey
    )

    .map(
      function(f) {

        return ee.Feature(f)
          .set(
            'reuse_asset',
            label
          );

      }
    );

}


var c1Prepared =
  prepareHistorical(
    c1,
    '05C1_passB'
  );

var c2aPrepared =
  prepareHistorical(
    c2a,
    '05C2A_rescued'
  );

var c3aPrepared =
  prepareHistorical(
    c3a,
    '05C3A_targeted60m'
  );


// ============================================================================
// 10. MERGE AUTOMATED TRAINING MATERIAL
// ============================================================================

var automatedRaw =
  c1Prepared
    .merge(c2aPrepared)
    .merge(c3aPrepared);


// ============================================================================
// 11. APPLY CURRENT MANUAL ACCEPT LEDGER
// ============================================================================
//
// This automatically excludes:
//
// Built-up 11 = PARTIAL
// Barren 62   = PARTIAL
// Barren 61   = REJECT
//
// ============================================================================

var automatedApproved =
  automatedRaw.filter(
    ee.Filter.inList(
      'class_poly_key',
      ACCEPT_KEYS
    )
  );


// ============================================================================
// 12. PREPARE OLD MANUAL BARREN TRAINING ADDITION
// ============================================================================
//
// This was training-side material, NOT validation.
//
// Force separate provenance:
// class 5
// poly_id 304
//
// ============================================================================

var c4ePrepared =
  c4e.map(
    function(f) {

      return ee.Feature(f).set({

        class_id:
          5,

        poly_id:
          304,

        class_poly_key:
          '5_304',

        reuse_asset:
          '05C4E_manual_barren'

      });

    }
  );


// ============================================================================
// 13. MERGE ALL REUSE LOCATIONS BEFORE SAMPLING
// ============================================================================
//
// One sampleRegions call instead of several.
//
// ============================================================================

var reuseSource =
  automatedApproved
    .merge(
      c4ePrepared
    );


// ============================================================================
// 14. SAMPLE REUSE ON AUTHORITATIVE STACK — ONCE
// ============================================================================

var reuseSampled =
  sampleCollection(
    reuseSource
  );


// ============================================================================
// 15. SAME-CLASS DEDUP
// ============================================================================

var reuseClassUnique =
  reuseSampled.distinct([
    'pixel_class_key'
  ]);


// ============================================================================
// 16. REMOVE PIXELS ALREADY PRESENT IN 06C2
// ============================================================================

var pixelMatch =
  ee.Filter.equals({

    leftField:
      'auth_pixel_key',

    rightField:
      'auth_pixel_key'

  });


var genuinelyNewReuse =
  ee.FeatureCollection(

    ee.Join.inverted().apply(

      reuseClassUnique,

      base,

      pixelMatch

    )

  );


// ============================================================================
// 17. FAST CROSS-CLASS CONFLICT QA
// ============================================================================
//
// Because same-class duplicates are already removed:
//
// class-unique count == spatial-unique count
//
// means NO pixel is represented by >1 class.
//
// We intentionally avoid the very expensive per-pixel map/filter loop used
// in the previous 06D0.
//
// ============================================================================

var reuseSpatialUnique =
  genuinelyNewReuse.distinct([
    'auth_pixel_key'
  ]);

var reuseClassUniqueN =
  genuinelyNewReuse.size();

var reuseSpatialUniqueN =
  reuseSpatialUnique.size();

var reuseConflictExcess =
  ee.Number(
    reuseClassUniqueN
  )
  .subtract(
    reuseSpatialUniqueN
  );


// ============================================================================
// 18. QA — HISTORICAL REUSE
// ============================================================================

print(
  '========================================'
);

print(
  '06D0B — EXISTING TRAINING REUSE QA'
);

print(
  '========================================'
);

print(
  ee.Dictionary({

    input_05C1:
      c1.size(),

    input_05C2A:
      c2a.size(),

    input_05C3A:
      c3a.size(),

    input_05C4E:
      c4e.size(),

    automated_raw:
      automatedRaw.size(),

    automated_after_manual_accept_filter:
      automatedApproved.size(),

    merged_reuse_source_rows:
      reuseSource.size(),

    clear_ge_2_sampled_rows:
      reuseSampled.size(),

    same_class_unique_pixels:
      reuseClassUnique.size(),

    removed_as_existing_06C2_pixels:
      reuseClassUnique
        .size()
        .subtract(
          genuinelyNewReuse.size()
        ),

    genuinely_new_class_unique_pixels:
      reuseClassUniqueN,

    genuinely_new_spatial_unique_pixels:
      reuseSpatialUniqueN,

    cross_class_conflict_excess_rows:
      reuseConflictExcess

  })
);


// ============================================================================
// 19. CLEAN REUSE HISTOGRAMS
// ============================================================================

print(
  '========================================'
);

print(
  '06D0B — GENUINELY NEW REUSE'
);

print(
  '========================================'
);

print(
  'Reuse class histogram'
);

print(
  genuinelyNewReuse.aggregate_histogram(
    'class_id'
  )
);

print(
  'Reuse source histogram'
);

print(
  genuinelyNewReuse.aggregate_histogram(
    'reuse_asset'
  )
);


// ============================================================================
// 20. CLASS-SPECIFIC REUSE DETAILS
// ============================================================================

[1, 2, 3, 4, 5].forEach(
  function(classId) {

    var fc =
      genuinelyNewReuse.filter(
        ee.Filter.eq(
          'class_id',
          classId
        )
      );

    print(
      ee.Dictionary({

        class_id:
          classId,

        new_reuse_n:
          fc.size(),

        poly_id_histogram:
          fc.aggregate_histogram(
            'poly_id'
          ),

        reuse_asset_histogram:
          fc.aggregate_histogram(
            'reuse_asset'
          )

      })
    );

  }
);


// ============================================================================
// 21. CONSOLIDATE BASE + REUSE
// ============================================================================
//
// If cross_class_conflict_excess_rows = 0, this is a clean candidate pool.
//
// Still NOT final training.
// Still NOT balanced.
//
// ============================================================================

var consolidated =
  base
    .merge(
      genuinelyNewReuse
    )
    .distinct([
      'pixel_class_key'
    ]);


// ============================================================================
// 22. FINAL COUNTS
// ============================================================================

print(
  '========================================'
);

print(
  '06D0B — CONSOLIDATED COUNTS'
);

print(
  '========================================'
);

print(
  ee.Dictionary({

    base_n:
      base.size(),

    genuinely_new_reuse_n:
      genuinelyNewReuse.size(),

    consolidated_n:
      consolidated.size(),

    cross_class_conflict_excess_rows:
      reuseConflictExcess

  })
);


print(
  'CONSOLIDATED CLASS HISTOGRAM'
);

print(
  consolidated.aggregate_histogram(
    'class_id'
  )
);


// ============================================================================
// 23. FEASIBILITY
// ============================================================================

print(
  '========================================'
);

print(
  '06D0B — FINAL FEASIBILITY AFTER SMART REUSE'
);

print(
  '========================================'
);


[1, 2, 3, 4, 5].forEach(
  function(classId) {

    var fc =
      consolidated.filter(
        ee.Filter.eq(
          'class_id',
          classId
        )
      );

    var n =
      fc.size();

    var deficit =
      ee.Number(TARGET)
        .subtract(n)
        .max(0);

    var surplus =
      ee.Number(n)
        .subtract(TARGET)
        .max(0);

    print(
      ee.Dictionary({

        class_id:
          classId,

        available_unique_n:
          n,

        target_n:
          TARGET,

        deficit:
          deficit,

        surplus:
          surplus,

        sufficient:
          n.gte(TARGET),

        distinct_poly_id_n:
          ee.List(
            fc.aggregate_array(
              'poly_id'
            )
          )
          .distinct()
          .size(),

        poly_id_histogram:
          fc.aggregate_histogram(
            'poly_id'
          )

      })
    );

  }
);


