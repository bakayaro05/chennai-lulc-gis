  'NO VALIDATION DATA USED.'
);

print(
  'DO NOT DRAW NEW POLYGONS YET.'
);

print(
  'DO NOT BALANCE TO 120 YET.'
);

print(
  'Critical condition: cross_class_conflict_excess_rows must be 0.'
);

print(
  'Send BASE + REUSE QA + REUSE HISTOGRAMS + CONSOLIDATED COUNTS + FEASIBILITY.'
);

print(
  '========================================'
);