    distinct_pixel_key_n:
      distinctFinalKeys.size(),

    duplicate_pixel_n:
      validationCandidate.size()
        .subtract(
          distinctFinalKeys.size()
        ),

    pixel_key_mismatch_n:
      validationCandidate
        .filter(
          ee.Filter.eq(
            'pixel_key_match',
            0
          )
        )
        .size(),

    training_overlap_30m_n:
      validationCandidate
        .filter(
          ee.Filter.eq(
            'final_training_overlap_30m',
            1
          )
        )
        .size(),

    minimum_clear_count:
