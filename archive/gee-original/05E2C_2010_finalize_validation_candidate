          target_year:
            2010

        }
      );

    }
  );


// ================================================================
// 21. COMBINE AUTO + MANUAL
// ================================================================

var combinedLabels =
  autoLabels

    .merge(
      manualLabels
    )

    .distinct(
      [
        'auth_pixel_key'
      ]
    );


// ================================================================
// 22. RESAMPLE PREDICTORS FRESH FROM AUTHORITATIVE STACK
// ================================================================

var finalPixelXY =
  ee.Image.pixelCoordinates(
    stackProjection
  )
  .rename(
    [
      'final_px',
      'final_py'
    ]
  );


var finalSamplingImage =
  stack2010

    .select(
      PREDICTORS
    )

    .addBands(
      stack2010.select(
        'clear_count'
      )
    )

    .addBands(
      finalPixelXY
    );


var validationCandidate =
  finalSamplingImage.sampleRegions({

    collection:
      combinedLabels,

    properties: [

      'class_id',
      'class_name',
      'poly_id',
      'validation_source',
      'auth_pixel_key',
      'target_year'

    ],

    scale:
      SCALE,

    projection:
      stackProjection,

    geometries:
      true,

    tileScale:
      4

  });


// ================================================================
// 23. VERIFY AUTHORITATIVE PIXEL KEY
// ================================================================

validationCandidate =
  validationCandidate.map(
    function(feature) {

      var px =
        ee.Number(
          feature.get(
            'final_px'
          )
        );


      var py =
        ee.Number(
          feature.get(
            'final_py'
          )
        );


      var newKey =
        px.format(
          '%.0f'
        )
        .cat(
          '_'
        )
        .cat(
          py.format(
            '%.0f'
          )
        );


      var oldKey =
        ee.String(
          feature.get(
            'auth_pixel_key'
          )
        );


      var keyMatch =
        newKey.compareTo(
          oldKey
        )
        .eq(
          0
        );


      return feature.set({

        auth_pixel_key:
          newKey,

        pixel_key_match:
          ee.Number(
            ee.Algorithms.If(
              keyMatch,
              1,
              0
            )
          )

      });

    }
  );


// ================================================================
// 24. FINAL 30 m TRAINING EXCLUSION RECHECK
// ================================================================

validationCandidate =
  validationCandidate.map(
    function(feature) {

      var overlap =
        ee.Number(
          ee.Algorithms.If(

            trainingExclusionGeometry.intersects(
              feature.geometry(),
              1
            ),

            1,

            0

          )
        );


      return feature.set(
        'final_training_overlap_30m',
        overlap
      );

    }
  );


// ================================================================
// 25. FINAL QA
// ================================================================

var finalKeys =
  ee.List(
    validationCandidate.aggregate_array(
      'auth_pixel_key'
    )
  );


var distinctFinalKeys =
  finalKeys.distinct();


var predictorComplete =
  validationCandidate.filter(
    ee.Filter.notNull(
      PREDICTORS
    )
  );


