function selectQuota(
  spec,
  index
) {

  var candidates =
    eligibleManual

      .filter(
        ee.Filter.eq(
          'class_id',
          spec.class_id
        )
      )

      .filter(
        ee.Filter.eq(
          'poly_id',
          spec.poly_id
        )
      );


  return candidates

    .randomColumn(
      'validation_select_random',
      SEED_BASE + index
    )

    .sort(
      'validation_select_random'
    )

    .limit(
      spec.quota
    )

    .map(
      function(feature) {

        return feature.set({

          final_validation_selected:
            1,

          validation_selection_stage:
            '05E2C_manual_diversity'

        });

      }
    );

}


