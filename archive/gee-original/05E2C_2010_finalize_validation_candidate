function geometryToFeatures(
  geometryImport,
  classId,
  className,
  startingPolyId,
  sourceName
) {

  var parts =
    ee.Geometry(
      geometryImport
    )
    .geometries();


  var n =
    parts.size();


  var indices =
    ee.List.sequence(
      0,
      n.subtract(
        1
      )
    );


  return ee.FeatureCollection(

    indices.map(
      function(index) {

        index =
          ee.Number(
            index
          );


        return ee.Feature(
          ee.Geometry(
            parts.get(
              index
            )
          ),
          {

            class_id:
              classId,

            class_name:
              className,

            poly_id:
              ee.Number(
                startingPolyId
              )
              .add(
                index
              ),

            manual_polygon_number:
              index.add(
                1
              ),

            validation_source:
              sourceName,

            target_year:
              2010

          }
        );

      }
    )

  );

}


