// ================================================================
// 8. GAUSSIAN SCORE FUNCTION
// ================================================================
//
// g_i(x) =
//
// -0.5 * [(x-mu)' Sigma^-1 (x-mu)]
// -0.5 * ln(|Sigma|)
//
// Equal priors and common Gaussian normalization constants
// are omitted because they are identical for all classes.
//
// ================================================================

function createScore(
  classParams,
  scoreBandName
) {

  classParams =
    ee.Dictionary(
      classParams
    );


  var meanVector =
    ee.Array(
      classParams.get(
        'mean'
      )
    );


  var inverseCovariance =
    ee.Array(
      classParams.get(
        'inverse'
      )
    );


  var determinant =
    ee.Number(
      classParams.get(
        'determinant'
      )
    );


  // --------------------------------------------------------------
  // PIXEL VECTOR — 9 x 1
  // --------------------------------------------------------------

  var imageVector =
    stack2010

      .select(
        MLC_BANDS
      )

      .toArray()

      .toArray(
        1
      );


  // --------------------------------------------------------------
  // MEAN VECTOR IMAGE
  // --------------------------------------------------------------

  var meanImage =
    ee.Image.constant(
      meanVector
    );


  // --------------------------------------------------------------
  // DIFFERENCE
  // --------------------------------------------------------------

  var difference =
    imageVector.subtract(
      meanImage
    );


  // --------------------------------------------------------------
  // INVERSE COVARIANCE IMAGE
  // --------------------------------------------------------------

  var inverseImage =
    ee.Image.constant(
      inverseCovariance
    );


  // --------------------------------------------------------------
  // MAHALANOBIS QUADRATIC TERM
  // --------------------------------------------------------------

  var mahalanobis =
    difference

      .arrayTranspose()

      .matrixMultiply(
        inverseImage
      )

      .matrixMultiply(
        difference
      )

      .arrayGet(
        [0, 0]
      );


  // --------------------------------------------------------------
  // GAUSSIAN LOG-LIKELIHOOD SCORE
  // --------------------------------------------------------------

  var score =
    mahalanobis

      .multiply(
        -0.5
      )

      .subtract(

        ee.Image.constant(

          determinant
            .log()
            .multiply(
              0.5
            )

        )

      )

      .rename(
        scoreBandName
      );


  return score;

}


