// ================================================================
// 5. BUILD GAUSSIAN PARAMETERS
// ================================================================

function buildClassParameters(
  classId
) {

  var classSamples =
    training2010

      .filter(
        ee.Filter.eq(
          'class_id',
          classId
        )
      )

      .filter(
        ee.Filter.notNull(
          MLC_BANDS
        )
      );


  // --------------------------------------------------------------
  // MEAN VECTOR — 9 x 1
  // --------------------------------------------------------------

  var meanValues =
    MLC_BANDS.map(
      function(bandName) {

        return classSamples.aggregate_mean(
          bandName
        );

      }
    );


  var meanVector =
    ee.Array([
      meanValues
    ])
    .transpose();


  // --------------------------------------------------------------
  // ARRAY PROPERTY FOR COVARIANCE
  // --------------------------------------------------------------

  var arraySamples =
    classSamples.makeArray(
      MLC_BANDS,
      'mlc_vector'
    );


  // --------------------------------------------------------------
  // FULL COVARIANCE MATRIX
  // --------------------------------------------------------------

  var covarianceResult =
    arraySamples.reduceColumns({

      reducer:
        ee.Reducer.covariance(),

      selectors: [
        'mlc_vector'
      ]

    });


  var covariance =
    ee.Array(

      ee.Dictionary(
        covarianceResult
      )
      .values()
      .get(
        0
      )

    );


  // --------------------------------------------------------------
  // REGULARIZATION
  // --------------------------------------------------------------

  var regularizedCovariance =
    covariance.add(

      ee.Array
        .identity(
          NUM_MLC_BANDS
        )
        .multiply(
          MLC_REGULARIZATION
        )

    );


  // --------------------------------------------------------------
  // DETERMINANT + INVERSE
  // --------------------------------------------------------------

  var determinant =
    regularizedCovariance
      .matrixDeterminant();


  var inverse =
    regularizedCovariance
      .matrixInverse();


  return ee.Dictionary({

    class_id:
      classId,

    training_n:
      classSamples.size(),

    mean:
      meanVector,

    determinant:
      determinant,

    inverse:
      inverse

  });

}


