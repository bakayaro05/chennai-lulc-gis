);


print(
  ee.Dictionary({

    current_barren_n:
      CURRENT_BARREN_N,

    target_barren_n:
      BARREN_TARGET,

    barren_needed:
      BARREN_NEEDED,

    available_basic_manual_candidates:
      basicManualCandidates.size(),

    available_strict_auto_pass:
