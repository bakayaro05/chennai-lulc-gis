function sampleCollection(collection) {

  return samplingImage

    .sampleRegions({

      collection:
        collection,

      properties: [
        'class_num',
        'class_key',
        'class_name',
        'poly_num',
        'poly_key',
        'class_poly_key',
        'reuse_asset',
        'pool_origin'
      ],

      scale:
        SCALE,

      projection:
        PROJ,

      geometries:
        true,

      tileScale:
        8

    })

    .filter(
      ee.Filter.gte(
        'clear_count',
        2
      )
    )

    .map(
      addPixelKey
    );

}


