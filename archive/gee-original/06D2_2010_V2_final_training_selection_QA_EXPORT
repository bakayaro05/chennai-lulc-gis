// ============================================================================
// 5. CLASS-NAME HELPER
// ============================================================================

function className(classNum) {

  classNum =
    ee.Number(classNum);

  return ee.String(

    ee.Algorithms.If(
      classNum.eq(1),
      'Built-up',

      ee.Algorithms.If(
        classNum.eq(2),
        'Vegetation',

        ee.Algorithms.If(
          classNum.eq(3),
          'Water',

          ee.Algorithms.If(
            classNum.eq(4),
            'Agricultural/Open',
            'Barren/Fallow'
          )
        )
      )
    )

  );

}


// ============================================================================
// 6. CANONICALIZE SOURCE PROPERTIES
// ============================================================================

function canonicalize(feature) {

  feature =
    ee.Feature(feature);

  var classNum =
    ee.Number.parse(
      ee.String(
        feature.get('class_id')
      )
    )
    .int();

  var polyNum =
    ee.Number.parse(
      ee.String(
        feature.get('poly_id')
      )
    )
    .int();

  var classKey =
    classNum.format('%d');

  var polyKey =
    polyNum.format('%d');

  return feature.set({

    class_num:
      classNum,

    class_key:
      classKey,

    class_name:
      className(classNum),

    poly_num:
      polyNum,

    poly_key:
      polyKey,

    class_poly_key:
      classKey
        .cat('_')
        .cat(polyKey)

  });

}


// ============================================================================
// 7. AUTHORITATIVE PIXEL KEY
// ============================================================================

function addPixelKey(feature) {

  feature =
    ee.Feature(feature);

  var px =
    ee.Number(
      feature.get('px')
    )
    .format('%.6f');

  var py =
    ee.Number(
      feature.get('py')
    )
    .format('%.6f');

  var classKey =
    ee.String(
      feature.get('class_key')
    );

  var pixelKey =
    px
      .cat('_')
      .cat(py);

  return feature.set({

    auth_pixel_key:
      pixelKey,

    pixel_class_key:
      classKey
        .cat('_')
        .cat(pixelKey)

  });

}


// ============================================================================
// 8. AUTHORITATIVE SAMPLING HELPER
