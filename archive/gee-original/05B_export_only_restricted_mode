// ================================================================
// 05B_export_only_restricted_mode
// Chennai Multi-Temporal LULC Project
//
// RESTRICTED-MODE VERSION
//
// PURPOSE
// -------
// Reconstruct ONLY the already-approved 05B accepted-candidate
// computation and immediately export it as an Earth Engine asset.
//
// NO:
//   - Map.addLayer()
//   - large console prints
//   - provisional training selection
//   - validation
//   - MLC
//
// OUTPUT:
// projects/assignment-482806/assets/
// chennai_2010_passB_candidates_05B
//
// ================================================================


// ================================================================
// 1. CONSTANTS
// ================================================================

var ROI_ASSET =
  'projects/assignment-482806/assets/chennai_admin_study_area_clean';

var QA_05A_ASSET =
  'projects/assignment-482806/assets/chennai_transfer_2015_to_2010_QA_05A';


var ROI =
  ee.FeatureCollection(ROI_ASSET);

var qa05A =
  ee.FeatureCollection(QA_05A_ASSET);


var CRS =
  'EPSG:32644';

var SCALE =
  30;


var PREDICTORS = [
  'blue',
  'green',
  'red',
  'nir',
  'swir1',
  'swir2',
  'NDVI',
  'NDWI',
  'NDBI'
];


var CLASS_PROPERTY =
  'class_id';

var CLASS_IDS =
  [1, 2, 3, 4, 5];


var DISTANCE_THRESHOLD =
  1.25;

var MARGIN_THRESHOLD =
  0.25;

var MIN_CLEAR_FOR_AUTO =
  2;

var MIN_LOCAL_FRACTION =
  5 / 9;

var MIN_VALID_NEIGHBOURS =
  5;

var EXPANSION_RADIUS_M =
  60;

var EPSILON =
  1e-6;


// ================================================================
// 2. LOCKED LANDSAT-5 PREPROCESSING
// ================================================================

function preprocessL5(image) {

  var qa =
    image.select('QA_PIXEL');


  var qaMask =
    qa.bitwiseAnd(1 << 0).eq(0)
      .and(
        qa.bitwiseAnd(1 << 1).eq(0)
      )
      .and(
        qa.bitwiseAnd(1 << 3).eq(0)
      )
      .and(
        qa.bitwiseAnd(1 << 4).eq(0)
      )
      .and(
        qa.bitwiseAnd(1 << 5).eq(0)
      );


  var radsatMask =
    image.select('QA_RADSAT')
      .eq(0);


  var optical =
    image
      .select(
        [
          'SR_B1',
          'SR_B2',
          'SR_B3',
          'SR_B4',
          'SR_B5',
          'SR_B7'
        ],
        [
          'blue',
          'green',
          'red',
          'nir',
          'swir1',
          'swir2'
        ]
      )
      .multiply(0.0000275)
      .add(-0.2)
      .updateMask(qaMask)
      .updateMask(radsatMask);


  var ndvi =
    optical.select('nir')
      .subtract(
        optical.select('red')
      )
      .divide(
        optical.select('nir')
          .add(
            optical.select('red')
          )
      )
      .rename('NDVI');


  var ndwi =
    optical.select('green')
      .subtract(
        optical.select('nir')
      )
      .divide(
        optical.select('green')
          .add(
            optical.select('nir')
          )
      )
      .rename('NDWI');


  var ndbi =
    optical.select('swir1')
      .subtract(
        optical.select('nir')
      )
      .divide(
        optical.select('swir1')
          .add(
            optical.select('nir')
          )
      )
      .rename('NDBI');


  return optical
    .addBands(ndvi)
    .addBands(ndwi)
    .addBands(ndbi)
    .select(PREDICTORS)
    .copyProperties(
      image,
      ['system:time_start']
    );
}


// ================================================================
// 3. BUILD 2010 STACK
// ================================================================

var collection2010 =
  ee.ImageCollection(
    'LANDSAT/LT05/C02/T1_L2'
  )
    .filterBounds(ROI)
    .filterDate(
      '2010-01-01',
      '2011-01-01'
    )
    .map(preprocessL5);


var image2010 =
  collection2010
    .median()
    .select(PREDICTORS)
    .clip(ROI);


var clear2010 =
  collection2010
    .select('red')
    .count()
    .rename('clear_count')
    .clip(ROI);


// ================================================================
// 4. LOAD ONLY 05A STABLE SEEDS
// ================================================================

var stableSeeds =
  qa05A.filter(
    ee.Filter.eq(
      'transfer_status',
      'STABLE'
    )
  );


// ================================================================
// 5. SAMPLE ORIGINAL 2010 VALUES AT STABLE SEEDS
// ================================================================

var nativeSeedSamples =
  image2010.sampleRegions({

    collection:
      stableSeeds,

    properties: [
      'class_id',
      'class_name',
      'poly_id'
    ],

    scale:
      SCALE,

    projection:
      ee.Projection(CRS)
        .atScale(SCALE),

    geometries:
      true,

    tileScale:
      4
  });


// ================================================================
// 6. BUILD 2010-NATIVE SIGNATURES
// ================================================================

function buildNativeSignature(classId) {

  var classSamples =
    nativeSeedSamples.filter(
      ee.Filter.eq(
        CLASS_PROPERTY,
        classId
      )
    );


  var means =
    PREDICTORS.map(
      function(band) {

        return ee.Number(
          classSamples.aggregate_mean(
            band
          )
        );

      }
    );


  var sds =
    PREDICTORS.map(
      function(band) {

        return ee.Number(
          classSamples.aggregate_sample_sd(
            band
          )
        )
        .max(EPSILON);

      }
    );


  return ee.Feature(
    null,
    {

      class_id:
        classId,

      means:
        ee.List(means),

      sds:
        ee.List(sds)
    }
  );
}


var nativeSignatures =
  ee.FeatureCollection(
    CLASS_IDS.map(
      buildNativeSignature
    )
  );


// ================================================================
// 7. 2010-NATIVE CLASS DISTANCE
// ================================================================

function distanceToNativeClass(
  image,
  classId
) {

  var signature =
    ee.Feature(
      nativeSignatures
        .filter(
          ee.Filter.eq(
            'class_id',
            classId
          )
        )
        .first()
    );


  var meanImage =
    ee.Image.constant(
      ee.List(
        signature.get('means')
      )
    )
    .rename(PREDICTORS);


  var sdImage =
    ee.Image.constant(
      ee.List(
        signature.get('sds')
      )
    )
    .rename(PREDICTORS)
    .max(EPSILON);


  return image
    .select(PREDICTORS)
    .subtract(meanImage)
    .divide(sdImage)
    .pow(2)
    .reduce(
      ee.Reducer.mean()
    )
    .sqrt()
    .rename(
      'd' + classId
    );
}


// ================================================================
// 8. DISTANCE STACK
// ================================================================

var d1 =
  distanceToNativeClass(
    image2010,
    1
  );

var d2 =
  distanceToNativeClass(
    image2010,
    2
  );

var d3 =
  distanceToNativeClass(
    image2010,
    3
  );

var d4 =
  distanceToNativeClass(
    image2010,
    4
  );

var d5 =
  distanceToNativeClass(
    image2010,
    5
  );


var distanceImages = [
  d1,
  d2,
  d3,
  d4,
  d5
];


var distanceStack =
  ee.Image.cat(
    distanceImages
  );


// ================================================================
// 9. BEST + SECOND-BEST CLASS
// ================================================================

var bestDist =
  d1.rename('best_dist');


var bestClass =
  ee.Image.constant(1)
    .rename('best_class')
    .updateMask(
      d1.mask()
    );


var secondDist =
  ee.Image.constant(9999)
    .rename('second_dist')
    .updateMask(
      d1.mask()
    );


for (
  var i = 1;
  i < CLASS_IDS.length;
  i++
) {

  var currentClass =
    CLASS_IDS[i];


  var currentDistance =
    distanceImages[i];


  var better =
    currentDistance.lt(
      bestDist
    );


  var previousBest =
    bestDist;


  var updatedSecond =
    secondDist.where(
      better,
      previousBest
    );


  var currentAsSecond =
    currentDistance.where(
      better,
      9999
    );


  updatedSecond =
    updatedSecond.min(
      currentAsSecond
    );


  bestDist =
    previousBest
      .where(
        better,
        currentDistance
      )
      .rename('best_dist');


  bestClass =
    bestClass
      .where(
        better,
        currentClass
      )
      .rename('best_class');


  secondDist =
    updatedSecond.rename(
      'second_dist'
    );
}


var margin =
  secondDist
    .subtract(bestDist)
    .rename('margin');


// ================================================================
// 10. LOCAL 3 × 3 CONSISTENCY
// ================================================================

var kernel3x3 =
  ee.Kernel.square({

    radius:
      1,

    units:
      'pixels',

    normalize:
      false
  });


var localValidN =
  bestClass
    .reduceNeighborhood({

      reducer:
        ee.Reducer.count(),

      kernel:
        kernel3x3,

      skipMasked:
        true
    })
    .rename(
      'local_valid_n'
    );


var localSameN =
  ee.Image.constant(0)
    .rename('local_same_n')
    .updateMask(
      bestClass.mask()
    );


CLASS_IDS.forEach(
  function(classId) {

    var neighbourCount =
      bestClass
        .eq(classId)
        .reduceNeighborhood({

          reducer:
            ee.Reducer.sum(),

          kernel:
            kernel3x3,

          skipMasked:
            true
        });


    localSameN =
      localSameN.where(
        bestClass.eq(classId),
        neighbourCount
      );

  }
);


var localFraction =
  localSameN
    .divide(
      localValidN.max(1)
    )
    .rename(
      'local_fraction'
    );


// ================================================================
// 11. EXPANSION ZONES
// ================================================================

var expansionZones =
  stableSeeds.map(
    function(feature) {

      return ee.Feature(
        feature.geometry()
          .buffer(
            EXPANSION_RADIUS_M
          ),
        {

          class_id:
            feature.get(
              'class_id'
            ),

          class_name:
            feature.get(
              'class_name'
            ),

          poly_id:
            feature.get(
              'poly_id'
            ),

          seed_status:
            '05A_STABLE'
        }
      );

    }
  );


// ================================================================
// 12. PIXEL COORDINATES
// ================================================================

var pixelXY =
  ee.Image.pixelCoordinates(
    ee.Projection(CRS)
      .atScale(SCALE)
  )
  .rename(
    [
      'px',
      'py'
    ]
  );


// ================================================================
// 13. CANDIDATE IMAGE
// ================================================================

var candidateImage =
  image2010
    .select(PREDICTORS)

    .addBands(
      distanceStack
    )

    .addBands(
      bestClass
    )

    .addBands(
      bestDist
    )

    .addBands(
      secondDist
    )

    .addBands(
      margin
    )

    .addBands(
      clear2010
    )

    .addBands(
      localValidN
    )

    .addBands(
      localFraction
    )

    .addBands(
      pixelXY
    );


// ================================================================
// 14. SAMPLE LOCAL CANDIDATES
// ================================================================

var candidatePool =
  candidateImage.sampleRegions({

    collection:
      expansionZones,

    properties: [
      'class_id',
      'class_name',
      'poly_id',
      'seed_status'
    ],

    scale:
      SCALE,

    projection:
      ee.Projection(CRS)
        .atScale(SCALE),

    geometries:
      true,

    tileScale:
      4
  });


// ================================================================
// 15. UNIQUE PIXEL KEY
// ================================================================

candidatePool =
  candidatePool.map(
    function(feature) {

      var px =
        ee.Number(
          feature.get('px')
        );


      var py =
        ee.Number(
          feature.get('py')
        );


      var key =
        px.format('%.0f')
          .cat('_')
          .cat(
            py.format('%.0f')
          );


      return feature.set(
        'pixel_key',
        key
      );

    }
  );


// ================================================================
// 16. OWN-CLASS DISTANCE HELPER
// ================================================================

function ownClassDistance(
  feature,
  classId
) {

  return ee.Number(

    ee.Algorithms.If(
      classId.eq(1),

      feature.get('d1'),

      ee.Algorithms.If(
        classId.eq(2),

        feature.get('d2'),

        ee.Algorithms.If(
          classId.eq(3),

          feature.get('d3'),

          ee.Algorithms.If(
            classId.eq(4),

            feature.get('d4'),

            feature.get('d5')
          )
        )
      )
    )
  );
}


// ================================================================
// 17. PASS-B ACCEPTANCE
// ================================================================

var screenedCandidates =
  candidatePool.map(
    function(feature) {

      var sourceClass =
        ee.Number(
          feature.get(
            CLASS_PROPERTY
          )
        );


      var predictedClass =
        ee.Number(
          feature.get(
            'best_class'
          )
        );


      var ownDistance =
        ownClassDistance(
          feature,
          sourceClass
        );


      var classMargin =
        ee.Number(
          feature.get(
            'margin'
          )
        );


      var clearCount =
        ee.Number(
          feature.get(
            'clear_count'
          )
        );


      var localN =
        ee.Number(
          feature.get(
            'local_valid_n'
          )
        );


      var localFrac =
        ee.Number(
          feature.get(
            'local_fraction'
          )
        );


      var accepted =
        clearCount
          .gte(
            MIN_CLEAR_FOR_AUTO
          )

          .and(
            predictedClass.eq(
              sourceClass
            )
          )

          .and(
            ownDistance.lte(
              DISTANCE_THRESHOLD
            )
          )

          .and(
            classMargin.gte(
              MARGIN_THRESHOLD
            )
          )

          .and(
            localN.gte(
              MIN_VALID_NEIGHBOURS
            )
          )

          .and(
            localFrac.gte(
              MIN_LOCAL_FRACTION
            )
          );


      return feature.set({

        passB_source_class:
          sourceClass,

        passB_predicted_class:
          predictedClass,

        passB_distance:
          ownDistance,

        passB_margin:
          classMargin,

        passB_auto_accept:
          ee.Number(
            ee.Algorithms.If(
              accepted,
              1,
              0
            )
          ),

        source_year:
          2015,

        target_year:
          2010,

        training_method:
          '05B_2010_native_local_expansion'
      });

    }
  );


// ================================================================
// 18. ACCEPT + DEDUPLICATE
// ================================================================

var acceptedCandidates =
  screenedCandidates
    .filter(
      ee.Filter.eq(
        'passB_auto_accept',
        1
      )
    )
    .distinct(
      [
        'pixel_key'
      ]
    );


// ================================================================
// 19. ONLY ACTION: EXPORT MATERIALIZED CANDIDATE TABLE
// ================================================================

Export.table.toAsset({

  collection:
    acceptedCandidates,

  description:
    'chennai_2010_passB_candidates_05B',

  assetId:
    'projects/assignment-482806/assets/chennai_2010_passB_candidates_05B'
});


