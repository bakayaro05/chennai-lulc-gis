// ================================================================
// 5. BUILD GAUSSIAN PARAMETERS FOR ONE CLASS
// ================================================================
//
// Important Earth Engine detail:
//
// ee.Reducer.covariance() requires ONE array-valued input.
//
// Therefore:
//
// 9 scalar predictor properties
//      ↓
// FeatureCollection.makeArray()
//      ↓
// one property: mlc_vector
//      ↓
// Reducer.covariance()
//
// ================================================================

function buildMlcClassParameters(
  classId
) {

  // --------------------------------------------------------------
  // LOCKED CLASS TRAINING SAMPLES
  // --------------------------------------------------------------

  var classSamples =
    finalTraining2010

      .filter(
        ee.Filter.eq(
          'class_id',
          classId
        )
      )

      .filter(
        ee.Filter.notNull(
          MLC_BANDS
        )
      );


  var trainingN =
    classSamples.size();


  // --------------------------------------------------------------
  // 9-DIMENSIONAL MEAN VECTOR
  //
  // Shape explicitly becomes 9 x 1.
  // --------------------------------------------------------------

  var meanValues =
    MLC_BANDS.map(
      function(bandName) {

        return classSamples.aggregate_mean(
          bandName
        );

      }
    );


  var meanVector =
    ee.Array([
      meanValues
    ])
    .transpose();


  // --------------------------------------------------------------
  // CONVERT THE 9 SCALAR PROPERTIES TO ONE ARRAY PROPERTY
  // --------------------------------------------------------------

  var arraySamples =
    classSamples.makeArray(
      MLC_BANDS,
      'mlc_vector'
    );


  // --------------------------------------------------------------
  // FULL SAMPLE COVARIANCE MATRIX
  //
  // The covariance reducer receives ONE selector:
  // mlc_vector
  // --------------------------------------------------------------

  var covarianceResult =
    arraySamples.reduceColumns({

      reducer:
        ee.Reducer.covariance(),

      selectors: [
        'mlc_vector'
      ]

    });


  // There is only one output from the reducer.
  // values().get(0) avoids depending on the reducer output key name.

  var covariance =
    ee.Array(

      ee.Dictionary(
        covarianceResult
      )
      .values()
      .get(
        0
      )

    );


  // --------------------------------------------------------------
  // DIAGONAL COVARIANCE REGULARIZATION
  //
  // Sigma_reg = Sigma + lambda I
  //
  // lambda = 1e-6
  // --------------------------------------------------------------

  var identity =
    ee.Array.identity(
      NUM_MLC_BANDS
    );


  var regularizedCovariance =
    covariance.add(

      identity.multiply(
        MLC_REGULARIZATION
      )

    );


  // --------------------------------------------------------------
  // DETERMINANT
  // --------------------------------------------------------------

  var determinant =
    regularizedCovariance
      .matrixDeterminant();


  // --------------------------------------------------------------
  // INVERSE
  // --------------------------------------------------------------

  var inverse =
    regularizedCovariance
      .matrixInverse();


  // --------------------------------------------------------------
  // RETURN PARAMETERS
  // --------------------------------------------------------------

  return ee.Dictionary({

    class_id:
      classId,

    class_name:
      CLASS_NAMES[
        classId - 1
      ],

    training_n:
      trainingN,

    mean:
      meanVector,

    covariance:
      regularizedCovariance,

    determinant:
      determinant,

    inverse:
      inverse

  });

}


