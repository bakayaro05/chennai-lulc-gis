// ================================================================
// 8. CREATE GAUSSIAN LOG-LIKELIHOOD SCORE IMAGE
// ================================================================
//
// For equal priors:
//
// g_i(x) =
//
// -0.5 * [(x - mu_i)' Sigma_i^-1 (x - mu_i)]
// -0.5 * ln(|Sigma_i|)
//
// Omitted terms:
//
// -(p/2) ln(2*pi)
// ln(1/5)
//
// They are identical for every class and therefore cannot alter
// the class selected by argmax.
//
// scoreBandName MUST be a normal JavaScript string:
//
// 'score_1'
// 'score_2'
// ...
//
// ================================================================

function createMlcScoreImage(
  classParams,
  scoreBandName
) {

  classParams =
    ee.Dictionary(
      classParams
    );


  // --------------------------------------------------------------
  // CLASS MEAN
  // --------------------------------------------------------------

  var meanVector =
    ee.Array(
      classParams.get(
        'mean'
      )
    );


  // --------------------------------------------------------------
  // INVERSE COVARIANCE
  // --------------------------------------------------------------

  var inverseCovariance =
    ee.Array(
      classParams.get(
        'inverse'
      )
    );


  // --------------------------------------------------------------
  // COVARIANCE DETERMINANT
  // --------------------------------------------------------------

  var determinant =
    ee.Number(
      classParams.get(
        'determinant'
      )
    );


  // --------------------------------------------------------------
  // IMAGE PIXEL -> 9 x 1 ARRAY VECTOR
  // --------------------------------------------------------------

  var imageVector =
    stack2010

      .select(
        MLC_BANDS
      )

      .toArray()

      .toArray(
        1
      );


  // --------------------------------------------------------------
  // MEAN -> ARRAY IMAGE
  // --------------------------------------------------------------

  var meanImage =
    ee.Image.constant(
      meanVector
    );


  // --------------------------------------------------------------
  // x - mu
  // --------------------------------------------------------------

  var difference =
    imageVector.subtract(
      meanImage
    );


  // --------------------------------------------------------------
  // Sigma^-1 -> ARRAY IMAGE
  // --------------------------------------------------------------

  var inverseImage =
    ee.Image.constant(
      inverseCovariance
    );


  // --------------------------------------------------------------
  // MAHALANOBIS QUADRATIC TERM
  //
  // (x - mu)' Sigma^-1 (x - mu)
  // --------------------------------------------------------------

  var transposeDifference =
    difference.arrayTranspose();


  var mahalanobis =
    transposeDifference

      .matrixMultiply(
        inverseImage
      )

      .matrixMultiply(
        difference
      )

      .arrayGet(
        [0, 0]
      );


  // --------------------------------------------------------------
  // GAUSSIAN LOG-LIKELIHOOD DISCRIMINANT
  // --------------------------------------------------------------

  var logDeterminantPenalty =
    ee.Image.constant(

      determinant
        .log()
        .multiply(
          0.5
        )

    );


  var score =
    mahalanobis

      .multiply(
        -0.5
      )

      .subtract(
        logDeterminantPenalty
      )

      .rename(
        scoreBandName
      );


  return score;

}


