  'Gaussian score bands'
);


print(
  mlcScoreStack.bandNames()
);


// ================================================================
// 12. ARGMAX -> FINAL CLASSIFICATION
// ================================================================
//
// Score stack order:
//
// score_1 -> array index 0
// score_2 -> array index 1
// score_3 -> array index 2
// score_4 -> array index 3
// score_5 -> array index 4
//
// arrayArgmax returns 0-4.
//
// +1 converts to locked class IDs 1-5.
//
// ================================================================

var classified2010 =
  mlcScoreStack

    .toArray()

    .arrayArgmax()

    .arrayGet(
      [0]
    )

    .add(
      1
    )

    .rename(
      'classification'
    )

    .toInt8()

    .clip(
      roi
    );


