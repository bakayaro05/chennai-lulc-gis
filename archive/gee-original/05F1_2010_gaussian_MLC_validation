// ================================================================
//
// IMPORTANT:
// Band names are CLIENT-SIDE literals.
// No ee.String / Number.format is used.
//
// ================================================================

var score1 =
  createMlcScoreImage(
    mlcParams.get(0),
    'score_1'
  );


var score2 =
  createMlcScoreImage(
    mlcParams.get(1),
    'score_2'
  );


var score3 =
  createMlcScoreImage(
    mlcParams.get(2),
    'score_3'
  );


var score4 =
  createMlcScoreImage(
    mlcParams.get(3),
    'score_4'
  );


var score5 =
  createMlcScoreImage(
    mlcParams.get(4),
    'score_5'
  );


// ================================================================
// 10. STACK FIVE GAUSSIAN SCORE BANDS
// ================================================================

var mlcScoreStack =
  score1

    .addBands(
      score2
    )

    .addBands(
      score3
    )

    .addBands(
      score4
    )

    .addBands(
      score5
    );


