
 // ==============================================================
 // STAGE 05A.2 - MEMORY-SAFE MONTHLY SPECTRAL EXTRACTION
 // Chennai vs Thanjavur, Landsat 8, 2020
 // READ ONLY: no classifier training or asset changes.
 // ==============================================================

 var ROOT = 'projects/assignment-482806/assets/';

 var CHENNAI_ROI = ee.FeatureCollection(
   ROOT + 'chennai_admin_study_area_clean'
 ).geometry();

 var THANJAVUR_ROI = ee.FeatureCollection(
   ROOT + 'tnj_city_trace_pilot_roi_2020'
 ).geometry();

 var CHENNAI_TRAIN = ee.FeatureCollection(
   ROOT + 'chennai_training_2020_final'
 );

 var THANJAVUR_REFERENCE = ee.FeatureCollection(
   ROOT + 'tnj_2020_reference_112_final_v1'
 );

 var CRS = 'EPSG:32644';
 var SCALE = 30;

 var BANDS = [
   'blue', 'green', 'red',
   'nir', 'swir1', 'swir2'
 ];

 var MISSING = -9999;

 // ==============================================================
 // 1. IDENTICAL LANDSAT 8 PREPROCESSING TO FROZEN BASELINE
 // ==============================================================

 function preprocess(image) {

   var qa = image.select('QA_PIXEL');
   var saturation = image.select('QA_RADSAT');

   var clear = qa.bitwiseAnd(1 << 0).eq(0)
     .and(qa.bitwiseAnd(1 << 1).eq(0))
     .and(qa.bitwiseAnd(1 << 2).eq(0))
     .and(qa.bitwiseAnd(1 << 3).eq(0))
     .and(qa.bitwiseAnd(1 << 4).eq(0))
     .and(qa.bitwiseAnd(1 << 5).eq(0))
     .and(saturation.eq(0));

   return image.select(
     [
       'SR_B2', 'SR_B3', 'SR_B4',
       'SR_B5', 'SR_B6', 'SR_B7'
     ],
     BANDS
   )
   .multiply(0.0000275)
   .add(-0.2)
   .updateMask(clear)
   .copyProperties(image, [
     'system:time_start'
   ]);
 }

 function landsatFor(roi) {

   return ee.ImageCollection(
     'LANDSAT/LC08/C02/T1_L2'
   )
   .filterBounds(roi)
   .filterDate(
     '2020-01-01',
     '2021-01-01'
   )
   .map(preprocess);
 }

 // Keep a fully masked image as fallback,
 // including months with zero available scenes.

 var EMPTY = ee.Image.constant([
   0, 0, 0, 0, 0, 0
 ])
 .rename(BANDS)
 .updateMask(ee.Image.constant(0));

 // ==============================================================
 // 2. BUILD 12 MONTHLY SPECTRAL MEASUREMENTS
 // ==============================================================

 function monthlyStack(collection) {

   var outputs = [];

   for (var month = 1; month <= 12; month++) {

     var start = ee.Date.fromYMD(
       2020, month, 1
     );

     var end = start.advance(
       1, 'month'
     );

     var monthly = collection.filterDate(
       start, end
     );

     var median = ee.ImageCollection
       .fromImages([EMPTY])
       .merge(monthly)
       .median()
       .select(BANDS);

     var nir = median.select('nir');
     var red = median.select('red');
     var green = median.select('green');
     var swir1 = median.select('swir1');

     // Match original 2020 index formulas.

     var ndvi = nir.subtract(red)
       .divide(nir.add(red));

     var ndwi = green.subtract(nir)
       .divide(green.add(nir));

     var ndbi = swir1.subtract(nir)
       .divide(swir1.add(nir));

     // Count clear observations at each pixel.
     // This differs from the total scene count.

     var count = ee.ImageCollection
       .fromImages([EMPTY])
       .merge(monthly)
       .select('red')
       .count();

     var prefix =
       'm' + (month < 10 ? '0' : '') + month;

     outputs.push(
       ndvi.rename(prefix + '_NDVI')
         .toFloat()
         .unmask(MISSING, false)
     );

     outputs.push(
       ndwi.rename(prefix + '_NDWI')
         .toFloat()
         .unmask(MISSING, false)
     );

     outputs.push(
       ndbi.rename(prefix + '_NDBI')
         .toFloat()
         .unmask(MISSING, false)
     );

     outputs.push(
       count.rename(prefix + '_clear_count')
         .toFloat()
         .unmask(0, false)
     );
   }

   return ee.Image.cat(outputs);
 }

 // ==============================================================
 // 3. GENERATE SOURCE AND TARGET STACKS
 // ==============================================================

 var sourceCollection = landsatFor(
   CHENNAI_ROI
 );

 var targetCollection = landsatFor(
   THANJAVUR_ROI
 );

 var sourceStack = monthlyStack(
   sourceCollection
 );

 var targetStack = monthlyStack(
   targetCollection
 );

 // ==============================================================
 // 4. PRESERVE ORIGINAL CLASS LABELS
 // ==============================================================

 var sourcePoints = CHENNAI_TRAIN.map(
   function(f) {

     return f.set({
       diagnostic_class: f.get('class_id'),
       site: 'Chennai',
       point_id: ee.String('CH_')
         .cat(
           ee.String(f.get('system:index'))
         )
     });
   }
 );

 var targetPoints = THANJAVUR_REFERENCE.map(
   function(f) {

     return f.set({
       diagnostic_class:
         f.get('reference_class'),
       site: 'Thanjavur'
     });
   }
 );

 // ==============================================================
 // 5. EXTRACT MONTHLY VALUES AT CHENNAI TRAINING POINTS
 // ==============================================================

 var sourceSamples = sourceStack.sampleRegions({

   collection: sourcePoints,

   properties: [
     'point_id',
     'diagnostic_class',
     'site'
   ],

   projection: ee.Projection(CRS),

   scale: SCALE,

   geometries: false,

   tileScale: 8

 });

 // ==============================================================
 // 6. EXTRACT MONTHLY VALUES AT THANJAVUR REFERENCE POINTS
 // ==============================================================

 var targetSamples = targetStack.sampleRegions({

   collection: targetPoints,

   properties: [
     'point_id',
     'diagnostic_class',
     'site'
   ],

   projection: ee.Projection(CRS),

   scale: SCALE,

   geometries: false,

   tileScale: 8

 });

 // ==============================================================
 // 7. LIGHTWEIGHT QUALITY ASSURANCE
 // ==============================================================

 print('===================================');
 print('STAGE 05A.2 V2 - SAFE EXTRACTION');
 print('===================================');

 print('Chennai Landsat scene count:');
 print(sourceCollection.size());

 print('Thanjavur Landsat scene count:');
 print(targetCollection.size());

 print('Chennai sampled records - target 600:');
 print(sourceSamples.size());

 print('Thanjavur sampled records - expect 112:');
 print(targetSamples.size());

 print('Monthly predictor band count - expect 48:');
 print(sourceStack.bandNames().size());

 print('Each month includes:');
 print('NDVI, NDWI, NDBI, clear_count');

 print('MISSING = -9999 indicates no valid index value.');

 print('No classwise statistical aggregation');
 print('is executed in this script.');

 // ==============================================================
 // 8. EXPORT TO GOOGLE DRIVE
 // ==============================================================

 Export.table.toDrive({

   collection: sourceSamples,

   description:
     'TNJ05A2_V2_CHENNAI_2020_MONTHLY_POINTS',

   fileNamePrefix:
     'TNJ05A2_V2_CHENNAI_2020_MONTHLY_POINTS',

   fileFormat: 'CSV'

 });

 Export.table.toDrive({

   collection: targetSamples,

   description:
     'TNJ05A2_V2_THANJAVUR_2020_MONTHLY_POINTS',

   fileNamePrefix:
     'TNJ05A2_V2_THANJAVUR_2020_MONTHLY_POINTS',

   fileFormat: 'CSV'

 });

