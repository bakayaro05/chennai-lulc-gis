 // 10. FINAL INSTRUCTIONS
 // ============================================================

 print('==========================================');
 print('STAGE 03C SCRIPT FINISHED');
 print('==========================================');

 print('Review console results before exporting.');
 print('Expected total: 252.');
 print('Expected manual count: approximately 51.');
 print('Manual labels have not been overwritten.');
 print('Automatic candidates are unverified.');
 print('Start the NEW export task if QA passes.');
