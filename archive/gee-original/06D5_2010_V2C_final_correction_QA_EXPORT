// ============================================================================

function addPixelKey(feature) {

  feature =
    ee.Feature(feature);

  var px =
    ee.Number(
      feature.get('px')
    )
    .format('%.6f');

  var py =
    ee.Number(
      feature.get('py')
    )
    .format('%.6f');

  var classId =
    ee.Number(
      feature.get('class_id')
    )
    .int();

  var pixelKey =
    px
      .cat('_')
      .cat(py);

  return feature.set({

    auth_pixel_key:
      pixelKey,

    pixel_class_key:
      classId
        .format('%d')
        .cat('_')
        .cat(pixelKey)

  });

}


function canonicalizeSource(feature) {

  feature =
    ee.Feature(feature);

  var classId =
    ee.Number.parse(
      ee.String(
        feature.get('class_id')
      )
    )
    .int();

  var polyId =
    ee.Number.parse(
      ee.String(
        feature.get('poly_id')
      )
    )
    .int();

  return feature.set({

    class_id:
      classId,

    poly_id:
      polyId

  });

}


function sampleCandidates(
  source,
  sourceName
) {

  var prepared =
    source.map(
      function(feature) {

        feature =
          canonicalizeSource(feature);

        return feature.set(
          'candidate_source',
          sourceName
        );

      }
    );


  return samplingImage
    .sampleRegions({

      collection:
        prepared,

      properties: [
        'class_id',
        'poly_id',
        'candidate_source'
      ],

      scale:
        SCALE,

      projection:
        PROJ,

      geometries:
        true,

      tileScale:
        8

    })

    .filter(
      ee.Filter.gte(
        'clear_count',
        2
      )
    )

    .map(
      addPixelKey
    )

    .distinct([
      'pixel_class_key'
    ]);

}


var samePixel =
  ee.Filter.equals({

    leftField:
      'auth_pixel_key',

    rightField:
      'auth_pixel_key'

  });


var within30m =
  ee.Filter.withinDistance({

    distance:
      FINAL_VALIDATION_EXCLUSION_M,

    leftField:
      '.geo',

    rightField:
      '.geo',

    maxError:
      1

  });


var within60m =
  ee.Filter.withinDistance({

    distance:
      REPLACEMENT_SAFETY_M,

    leftField:
      '.geo',

    rightField:
      '.geo',

    maxError:
      1

  });


function removeExistingPixels(
  candidates,
  training
) {

  return ee.FeatureCollection(

    ee.Join.inverted().apply(

      candidates,

      training,

      samePixel

    )

  );

}


function excludeValidation60m(
  candidates
) {

  return ee.FeatureCollection(

    ee.Join.inverted().apply(

      candidates,

      validation,

      within60m

    )

  );

}


function selectRandom(
  collection,
  n,
  seed
) {

  return collection

    .randomColumn(
      'replacement_random',
      seed
    )

    .sort(
      'replacement_random'
    )

    .limit(n);

}


