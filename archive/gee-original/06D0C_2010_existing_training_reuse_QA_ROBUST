// ============================================================================
// 5. CANONICAL PROPERTY HELPER
// ============================================================================
//
// IMPORTANT:
//
// Do NOT use the original numeric class_id / poly_id as histogram keys.
//
// Historical assets may contain:
//
//    Integer 5
//    Float   5.0
//
// Both display as dictionary key "5", causing:
//
//    Conflicting or duplicate keys in histogram: 5
//
// Therefore create:
//
//    class_num  -> canonical integer for filtering
//    class_key  -> canonical STRING for histogram
//
//    poly_num   -> canonical integer
//    poly_key   -> canonical STRING for histogram
//
// ============================================================================

function canonicalize(feature) {

  feature =
    ee.Feature(feature);

  var classNum =
    ee.Number.parse(
      ee.String(
        feature.get('class_id')
      )
    )
    .int();

  var polyNum =
    ee.Number.parse(
      ee.String(
        feature.get('poly_id')
      )
    )
    .int();

  var classKey =
    classNum.format('%d');

  var polyKey =
    polyNum.format('%d');

  var classPolyKey =
    classKey
      .cat('_')
      .cat(polyKey);

  return feature.set({

    class_num:
      classNum,

    class_key:
      classKey,

    poly_num:
      polyNum,

    poly_key:
      polyKey,

    class_poly_key:
      classPolyKey

  });

}


// ============================================================================
// 6. AUTHORITATIVE PIXEL-KEY HELPER
// ============================================================================
//
// Pixel coordinates may be floating-point values such as:
//
//    48117.5
//
// So DO NOT format them using %d.
//
// ============================================================================

function addPixelKey(feature) {

  feature =
    ee.Feature(feature);

  var px =
    ee.Number(
      feature.get('px')
    )
    .format('%.6f');

  var py =
    ee.Number(
      feature.get('py')
    )
    .format('%.6f');

  var classKey =
    ee.String(
      feature.get('class_key')
    );

  var pixelKey =
    px
      .cat('_')
      .cat(py);

  var pixelClassKey =
    classKey
      .cat('_')
      .cat(pixelKey);

  return feature.set({

    auth_pixel_key:
      pixelKey,

    pixel_class_key:
      pixelClassKey

  });

}


// ============================================================================
// 7. SAMPLING HELPER
// ============================================================================

function sampleCollection(collection) {

  return samplingImage
    .sampleRegions({

      collection:
        collection,

      properties: [
        'class_num',
        'class_key',
        'poly_num',
        'poly_key',
        'class_poly_key',
        'reuse_asset'
      ],

      scale:
        SCALE,

      projection:
        PROJ,

      geometries:
        false,

      tileScale:
        8

    })

    .filter(
      ee.Filter.gte(
        'clear_count',
        2
      )
    )

    .map(
      addPixelKey
    );

}


