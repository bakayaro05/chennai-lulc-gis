// ============================================================================

var TARGET_PER_CLASS =
  120;


var classIds =
  ee.List([
    1,
    2,
    3,
    4,
    5
  ]);


var classNames =
  ee.Dictionary({

    '1':
      'Built-up',

    '2':
      'Vegetation',

    '3':
      'Water',

    '4':
      'Agricultural/Open',

    '5':
      'Barren/Fallow'

  });


var feasibility =
  ee.FeatureCollection(

    classIds.map(
      function(classId) {

        classId =
          ee.Number(
            classId
          );


        var acceptedN =
          acceptedCandidatePool

            .filter(
              ee.Filter.eq(
                'class_id',
                classId
              )
            )

            .size();


        var partialN =
          partialEligible

            .filter(
              ee.Filter.eq(
                'class_id',
                classId
              )
            )

            .distinct([
              'auth_pixel_key',
              'class_id'
            ])

            .size();


        var deficitAcceptedOnly =
          ee.Number(
            TARGET_PER_CLASS
          )
          .subtract(
            acceptedN
          )
          .max(
            0
          );


        var theoreticalWithPartial =
          ee.Number(
            acceptedN
          )
          .add(
            partialN
          );


        var residualDeficit =
          ee.Number(
            TARGET_PER_CLASS
          )
          .subtract(
            theoreticalWithPartial
          )
          .max(
            0
          );


        return ee.Feature(
          null,
          {

            class_id:
              classId,

            class_name:
              classNames.get(
                classId.format()
              ),

            target_n:
              TARGET_PER_CLASS,

            accepted_clean_unique_n:
              acceptedN,

            deficit_using_accepted_only:
              deficitAcceptedOnly,

            partial_available_unique_n:
              partialN,

            theoretical_max_with_all_partial:
              theoreticalWithPartial,

            residual_deficit_if_all_partial_used:
              residualDeficit

          }
        );

      }
    )

  );


print(
