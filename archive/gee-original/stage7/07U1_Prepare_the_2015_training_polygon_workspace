
// ============================================================
// CHENNAI LULC — STAGE 07U1
// 2015 V2 TRAINING-DIGITIZATION PREPARATION
// READ-ONLY GEE REVIEW + ONE GOOGLE DRIVE KML EXPORT
// No classifier training; no GEE asset modification.
// ============================================================

var ROOT = 'projects/assignment-482806/assets/';
var CRS = 'EPSG:32644';
var SCALE = 30;

var roiFC = ee.FeatureCollection(
  ROOT + 'chennai_admin_study_area_clean'
);
var roi = roiFC.geometry();

var originalTraining = ee.FeatureCollection(
  ROOT + 'chennai_training_2015_final'
);
var validation = ee.FeatureCollection(
  ROOT + 'chennai_validation_2015_final'
);

var classified2015 = ee.Image(
  ROOT + 'chennai_mlc_lulc_2015'
).select('classification');

var classified2010 = ee.Image(
  ROOT + 'chennai_mlc_lulc_2010_L5L7_manual_exp_v1'
).select('classification');

// ------------------------------------------------------------
// 1. CREATE 60-METRE VALIDATION EXCLUSION ZONES
// ------------------------------------------------------------

var validationExclusions = validation.map(function(f) {
  var id = ee.String(f.get('system:index'));

  return ee.Feature(f.geometry().buffer(60, 1), {
    name: ee.String('2015_VALIDATION_EXCLUDE_').cat(id),
    class_id: f.get('class_id'),
    radius_m: 60
  });
});

// ------------------------------------------------------------
// 2. REBUILD 2015 LANDSAT 8 DISPLAY COMPOSITE
// ------------------------------------------------------------

function prep2015(im) {
  var qa = im.select('QA_PIXEL');
  var sat = im.select('QA_RADSAT');

  var clear = qa.bitwiseAnd(1 << 0).eq(0)
    .and(qa.bitwiseAnd(1 << 1).eq(0))
    .and(qa.bitwiseAnd(1 << 2).eq(0))
    .and(qa.bitwiseAnd(1 << 3).eq(0))
    .and(qa.bitwiseAnd(1 << 4).eq(0))
    .and(qa.bitwiseAnd(1 << 5).eq(0))
    .and(sat.eq(0));

  return im.select(
    ['SR_B2', 'SR_B3', 'SR_B4',
     'SR_B5', 'SR_B6', 'SR_B7'],
    ['blue', 'green', 'red',
     'nir', 'swir1', 'swir2']
  )
  .multiply(0.0000275)
  .add(-0.2)
  .updateMask(clear);
}

var scenes2015 = ee.ImageCollection(
  'LANDSAT/LC08/C02/T1_L2'
)
.filterBounds(roi)
.filterDate('2015-01-01', '2016-01-01');

var rgb2015 = scenes2015
  .map(prep2015)
  .median()
  .clip(roi);

// ------------------------------------------------------------
// 3. CROSS-YEAR DISAGREEMENT OVERLAYS
// Diagnostic only, NOT reference labels.
// ------------------------------------------------------------

var disagreement14 = classified2010.eq(1)
  .and(classified2015.eq(4))
  .selfMask();

var disagreement15 = classified2010.eq(1)
  .and(classified2015.eq(5))
  .selfMask();

var exclusionImage = ee.Image()
  .byte()
  .paint(validationExclusions, 1)
  .selfMask();

// ------------------------------------------------------------
// 4. QUALITY CHECKS
// ------------------------------------------------------------

print('========================================');
print('07U1 — 2015 TRAINING POLYGON PREPARATION');
print('========================================');

print('Study area (km2, EPSG:32644):');
print(
  roi.area(1, ee.Projection(CRS)).divide(1e6)
);

print('2015 L8 scenes (expected 19):');
print(scenes2015.size());

print('Original training points (expected 600):');
print(originalTraining.size());

print('Independent validation points (expected 300):');
print(validation.size());

print('Validation exclusion polygons (expected 300):');
print(validationExclusions.size());

print('Original training class counts:');
print(
  originalTraining.aggregate_histogram('class_id')
);

print('No prior labels or rasters will be changed.');

// ------------------------------------------------------------
// 5. MAP WORKSPACE
// ------------------------------------------------------------

Map.layers().reset();
Map.setOptions('SATELLITE');
Map.centerObject(roi, 10);

Map.addLayer(
  rgb2015,
  {
    bands: ['red', 'green', 'blue'],
    min: 0.02,
    max: 0.30
  },
  '2015 L8 historical RGB',
  true
);

Map.addLayer(
  classified2015,
  {
    min: 1,
    max: 5,
    palette: [
      'ff0000', '008000', '0000ff',
      'ffff00', 'd2b48c'
    ]
  },
  '2015 baseline MLC',
  false
);

Map.addLayer(
  disagreement14,
  {palette: ['ff00ff']},
  'DIAGNOSTIC ONLY: 2010 Built -> 2015 Agri',
  false
);

Map.addLayer(
  disagreement15,
  {palette: ['ffa500']},
  'DIAGNOSTIC ONLY: 2010 Built -> 2015 Vacant',
  false
);

Map.addLayer(
  exclusionImage,
  {palette: ['ff4444']},
  '2015 validation 60m NO-TRAIN ZONES',
  true,
  0.6
);

Map.addLayer(
  originalTraining.style({
    color: '00ffff',
    pointSize: 2
  }),
  {},
  '2015 original training points',
  false
);

Map.addLayer(
  roiFC.style({
    color: 'ffffff',
    fillColor: '00000000',
    width: 2
  }),
  {},
  'LOCKED Chennai study area',
  true
);

// ------------------------------------------------------------
// 6. EXPORT VALIDATION EXCLUSIONS TO GOOGLE EARTH PRO
// ------------------------------------------------------------

Export.table.toDrive({
  collection: validationExclusions,
  description: 'Chennai_2015_Validation_60m_Exclusions_KML',
  fileNamePrefix: 'Chennai_2015_Validation_60m_Exclusions',
  fileFormat: 'KML',
  selectors: ['name', 'class_id', 'radius_m']
});

print('========================================');
print('ONE GOOGLE DRIVE KML TASK CREATED');
print('========================================');

print('Export exclusions and load into Google Earth Pro.');
print('Draw NEW 2015 polygons outside those zones.');
print('No GEE classification or asset exports created.');

print('========================================');
print('END STAGE 07U1');
print('========================================');
