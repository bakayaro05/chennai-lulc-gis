// 1 — INPUT AND FIXED METHOD
var ROOT = 'projects/assignment-482806/assets/';

var training = ee.FeatureCollection(
  ROOT + 'chennai_training_2010_manual_final_v1'
);

var REGULARIZATION = 1e-6;

var BANDS_9 = [
  'blue', 'green', 'red',
  'nir', 'swir1', 'swir2',
  'NDVI', 'NDWI', 'NDBI'
];

var BANDS_6 = [
  'blue', 'green', 'red',
  'nir', 'swir1', 'swir2'
];

var BANDS_3 = [
  'NDVI', 'NDWI', 'NDBI'
];

var CLASS_NAMES = {
  2: 'Vegetation',
  4: 'Agricultural',
  5: 'Vacant_Open'
};

var CLASS_IDS = [2, 4, 5];

var PAIRS = [
  {
    a: 2,
    b: 4,
    label: '2_vs_4_Vegetation_Agriculture'
  },
  {
    a: 2,
    b: 5,
    label: '2_vs_5_Vegetation_VacantOpen'
  },
  {
    a: 4,
    b: 5,
    label: '4_vs_5_Agriculture_VacantOpen'
  }
];

var FEATURE_SETS = [
  {name: 'all_9', bands: BANDS_9},
  {name: 'raw_6', bands: BANDS_6},
  {name: 'indices_3', bands: BANDS_3}
];

