// F. RETAIN OLD SAMPLES WITH POLYGON BALANCING
// =============================================================

function retainedOldClass(classId) {

  var cl = oldTraining.filter(
    ee.Filter.eq('class_id', classId)
  );

  var maxPer = OLD_PER_POLYGON_CAP[classId];

  var sourceIds = cl.aggregate_array(
    'poly_id'
  ).distinct();

  var capped = ee.FeatureCollection(
    sourceIds.iterate(function(pid, acc) {

      var part = cl.filter(
        ee.Filter.eq('poly_id', pid)
      )
      .randomColumn(
        'old_poly_random',
        2015081
      )
      .sort('old_poly_random')
      .limit(maxPer);

      return ee.FeatureCollection(acc)
        .merge(part);

    }, emptyFC)
  );

  return capped
    .randomColumn(
      'old_total_random',
      2015109
    )
    .sort('old_total_random')
    .limit(OLD_TO_KEEP[classId]);

}

var retained = retainedOldClass(1)
  .merge(retainedOldClass(2))
  .merge(retainedOldClass(3))
  .merge(retainedOldClass(4))
  .merge(retainedOldClass(5));

var finalTraining = retained.merge(
