// E. GENERATE NEW TRAINING PIXELS
// =============================================================

var emptyFC = ee.FeatureCollection([]);

var newPoints = ee.FeatureCollection(
  newPolys.iterate(function(obj, acc) {

    var poly = ee.Feature(obj);

    var label = ee.Number(
      poly.get('class_id')
    );

    var perPoly = ee.Number(
      ee.Dictionary({
        '1': NEW_PER_POLYGON[1],
        '4': NEW_PER_POLYGON[4],
        '5': NEW_PER_POLYGON[5]
      }).get(
        label.format('%.0f')
      )
    );

    // Inward buffer reduces boundary/mixed-pixel sampling.

    var core = poly.geometry().buffer(-15, 1);

    var selected = stack.sample({
      region: core,
      projection: PROJECTION,
      scale: SCALE,
      geometries: true,
      tileScale: 8,
      dropNulls: true
    })
    .randomColumn(
      'new_selection_random',
      2015007
    )
    .sort('new_selection_random')
    .limit(perPoly);

    selected = selected.map(function(pt) {

      return ee.Feature(pt)
        .set('class_id', label)
        .set('class_name', poly.get('class_name'))
        .set('poly_id', poly.get('poly_id'))
        .set('source', '2015_V2A_historical_native');

    });

    return ee.FeatureCollection(acc)
      .merge(selected);

  }, emptyFC)
);

