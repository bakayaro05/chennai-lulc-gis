// =============================================================
// G. TRUE GAUSSIAN MAXIMUM LIKELIHOOD CLASSIFIER
// =============================================================

// Nine predictor dimensions.
// Equal class priors.
// Class-specific mean and covariance.
// Regularization = 1e-6 * identity matrix.

function parameters(classId) {

  var members = finalTraining.filter(
    ee.Filter.eq('class_id', classId)
  );

  var mean = ee.Array([
    BANDS.map(function(b) {

      return members.aggregate_mean(b);

    })
  ]).transpose();

  var reduced = members
    .makeArray(BANDS, 'mlc_array')
    .reduceColumns({
      reducer: ee.Reducer.covariance()
        .setOutputs(['covariance']),
      selectors: ['mlc_array']
    });

  var cov = ee.Array(
    reduced.get('covariance')
  ).add(
    ee.Array.identity(9)
      .multiply(1e-6)
  );

  return ee.Dictionary({
    mean: mean,
    inverse: cov.matrixInverse(),
    determinant: cov.matrixDeterminant()
  });

}

var x = stack.toArray().toArray(1);

function classScore(params, name) {

  params = ee.Dictionary(params);

  var meanImage = ee.Image.constant(
    ee.Array(params.get('mean'))
  );

  var inverseImage = ee.Image.constant(
    ee.Array(params.get('inverse'))
  );

  var det = ee.Number(
    params.get('determinant')
  ).max(1e-300);

  var delta = x.subtract(
    meanImage
  );

  var d2 = delta.arrayTranspose()
    .matrixMultiply(inverseImage)
    .matrixMultiply(delta)
    .arrayGet([0, 0]);

  return d2.multiply(-0.5)
    .add(
      ee.Image.constant(
        det.log()
      ).multiply(-0.5)
    )
    .rename(name);

}

var scores = classScore(
  parameters(1), 'score_1'
)
.addBands(
  classScore(parameters(2), 'score_2')
)
.addBands(
  classScore(parameters(3), 'score_3')
)
.addBands(
  classScore(parameters(4), 'score_4')
)
.addBands(
  classScore(parameters(5), 'score_5')
);

var classified = scores
  .toArray()
  .arrayArgmax()
  .arrayGet([0])
  .add(1)
  .rename('classification')
  .toInt8()
  .clip(roi);

