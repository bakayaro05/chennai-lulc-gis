// B. RECONSTRUCT 2015 LANDSAT 8 PREDICTOR STACK
// =============================================================

function maskScaleL8(im) {

  var qa = im.select('QA_PIXEL');
  var rad = im.select('QA_RADSAT');

  var mask = qa.bitwiseAnd(1 << 0).eq(0)
    .and(qa.bitwiseAnd(1 << 1).eq(0))
    .and(qa.bitwiseAnd(1 << 2).eq(0))
    .and(qa.bitwiseAnd(1 << 3).eq(0))
    .and(qa.bitwiseAnd(1 << 4).eq(0))
    .and(qa.bitwiseAnd(1 << 5).eq(0))
    .and(rad.eq(0));

  return im.select(
    [
      'SR_B2',
      'SR_B3',
      'SR_B4',
      'SR_B5',
      'SR_B6',
      'SR_B7'
    ],
    [
      'blue',
      'green',
      'red',
      'nir',
      'swir1',
      'swir2'
    ]
  )
  .multiply(0.0000275)
  .add(-0.2)
  .updateMask(mask);

}

function addIndices(im) {

  var green = im.select('green');
  var red = im.select('red');
  var nir = im.select('nir');
  var swir = im.select('swir1');

  return im.addBands([
    nir.subtract(red)
      .divide(nir.add(red))
      .rename('NDVI'),

    green.subtract(nir)
      .divide(green.add(nir))
      .rename('NDWI'),

    swir.subtract(nir)
      .divide(swir.add(nir))
      .rename('NDBI')
  ]);

}

var l8 = ee.ImageCollection(
  'LANDSAT/LC08/C02/T1_L2'
)
.filterBounds(roi)
.filterDate('2015-01-01', '2016-01-01')
.map(maskScaleL8);

var stack = addIndices(
  l8.median().clip(roi)
).select(BANDS);

// =============================================================
// C. VERIFY RECONSTRUCTED STACK AGAINST ARCHIVED TRAINING
// =============================================================

var oldWithArchive = oldTraining.map(function(f) {

