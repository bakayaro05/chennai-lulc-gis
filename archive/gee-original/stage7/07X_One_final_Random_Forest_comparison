var YEAR = 2010;

var ROOT = 'projects/assignment-482806/assets/';
var CRS = 'EPSG:32644';
var GRID = ee.Projection(
  CRS, [30, 0, 399060, 0, -30, 1463250]
);
var SCALE = 30;
var CLASSES = [1, 2, 3, 4, 5];

var BANDS = [
  'blue', 'green', 'red',
  'nir', 'swir1', 'swir2',
  'NDVI', 'NDWI', 'NDBI'
];

var is2015 = YEAR === 2015;

// CRITICAL FIX:
// 2015: numeric polygon IDs
// 2010: string site IDs
var SITE_FIELD = is2015 ? 'poly_id' : 'site_id';

var roi = ee.FeatureCollection(
  ROOT + 'chennai_admin_study_area_clean'
).geometry();

var training = ee.FeatureCollection(
  ROOT + (is2015
    ? 'chennai_training_2015_final'
    : 'chennai_training_2010_L5L7_manual_exp_v1')
);

var validation = ee.FeatureCollection(
  ROOT + (is2015
    ? 'chennai_validation_2015_final'
    : 'chennai_validation_2010_final')
);

var original = ee.Image(
  ROOT + (is2015
    ? 'chennai_mlc_lulc_2015'
    : 'chennai_mlc_lulc_2010_L5L7_manual_exp_v1')
).select('classification');

// ============================================================
// A. NINE-BAND PREDICTOR STACK
// ============================================================

function prepL8(image) {

  var qa = image.select('QA_PIXEL');
  var sat = image.select('QA_RADSAT');

  var clear = qa.bitwiseAnd(1 << 0).eq(0)
    .and(qa.bitwiseAnd(1 << 1).eq(0))
    .and(qa.bitwiseAnd(1 << 2).eq(0))
    .and(qa.bitwiseAnd(1 << 3).eq(0))
    .and(qa.bitwiseAnd(1 << 4).eq(0))
    .and(qa.bitwiseAnd(1 << 5).eq(0))
    .and(sat.eq(0));

  return image.select(
    [
      'SR_B2', 'SR_B3', 'SR_B4',
      'SR_B5', 'SR_B6', 'SR_B7'
    ],
    [
      'blue', 'green', 'red',
      'nir', 'swir1', 'swir2'
    ]
  )
  .multiply(0.0000275)
  .add(-0.2)
  .updateMask(clear);

}

function addIndices(image) {

  var red = image.select('red');
  var green = image.select('green');
  var nir = image.select('nir');
  var swir1 = image.select('swir1');

  return image.addBands([

    nir.subtract(red)
      .divide(nir.add(red))
      .rename('NDVI'),

    green.subtract(nir)
      .divide(green.add(nir))
      .rename('NDWI'),

    swir1.subtract(nir)
      .divide(swir1.add(nir))
      .rename('NDBI')

  ]);

}

var stack = is2015

  ? addIndices(
      ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
        .filterBounds(roi)
        .filterDate('2015-01-01', '2016-01-01')
        .map(prepL8)
        .median()
    )
    .select(BANDS)
    .clip(roi)

  : ee.Image(
      ROOT + 'chennai_predictor_stack_2010_L5L7_exp_v1'
    ).select(BANDS);

// ============================================================
// B. RANDOM FOREST
// ============================================================

function makeRF() {

  return ee.Classifier.smileRandomForest({

    numberOfTrees: 150,
    variablesPerSplit: 3,
    minLeafPopulation: 3,
    bagFraction: 0.7,
    seed: 20261013

  });

}

var rf = makeRF().train({

  features: training,
  classProperty: 'class_id',
  inputProperties: BANDS

});

// ============================================================
// C. VALIDATION: RANDOM FOREST AND ORIGINAL MLC
// ============================================================

var holdout = stack.sampleRegions({

  collection: validation,
  properties: ['class_id'],
  projection: GRID,
  scale: SCALE,
  geometries: false,
  tileScale: 8

});

var rfPred = holdout.classify(
  rf, 'classification'
);

var rfCM = rfPred.errorMatrix(
  'class_id',
  'classification',
  CLASSES
);

var baselinePred = original.sampleRegions({

  collection: validation,
  properties: ['class_id'],
  projection: GRID,
  scale: SCALE,
  geometries: false,
  tileScale: 8

});

var baselineCM = baselinePred.errorMatrix(
  'class_id',
  'classification',
  CLASSES
);

// ============================================================
// D. FIXED SITE-HELD-OUT 5-FOLD CROSS-VALIDATION
//
// Critical correction:
// 2015 uses poly_id.
// 2010 uses site_id.
//
// Never convert the string site_id to ee.Number.
// All pixels from a source site receive the same fold.
// Fold assignments are distributed within each class.
// ============================================================

function assignClassFolds(classId) {

  var subset = training.filter(
    ee.Filter.eq('class_id', classId)
  );

  var siteIds = ee.List(
    subset.aggregate_array(SITE_FIELD)
  )
  .distinct()
  .sort();

  return subset.map(function(feature) {

    // Works for both numeric IDs and string IDs.
    var position = siteIds.indexOf(
      feature.get(SITE_FIELD)
    );

    var fold = ee.Number(position).mod(5);

    return feature.set(
      'site_fold',
      fold
    );

  });

}

var withFolds = ee.FeatureCollection([]);

CLASSES.forEach(function(classId) {

  withFolds = withFolds.merge(
    assignClassFolds(classId)
  );

});

var groupedCV = ee.FeatureCollection(

  ee.List.sequence(0, 4).iterate(
    function(foldNo, accumulator) {

      foldNo = ee.Number(foldNo);

      var cvTrain = withFolds.filter(
        ee.Filter.neq('site_fold', foldNo)
      );

      var cvTest = withFolds.filter(
        ee.Filter.eq('site_fold', foldNo)
      );

      var foldModel = makeRF().train({

        features: cvTrain,
        classProperty: 'class_id',
        inputProperties: BANDS

      });

      var foldPredictions = cvTest.classify(
        foldModel,
        'classification'
      );

      return ee.FeatureCollection(accumulator)
        .merge(foldPredictions);

    },
    ee.FeatureCollection([])
  )

);

var cvCM = groupedCV.errorMatrix(
  'class_id',
  'classification',
  CLASSES
);

