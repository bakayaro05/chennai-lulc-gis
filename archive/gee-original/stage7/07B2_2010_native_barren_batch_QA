   print('Keep independent validation areas untouched.');
   print('Save script and re-run after drawing.');
 } else {
   // ---------- G. REGISTER SITE GEOMETRIES ----------
   var features = activeSites.map(function(s) {
     return ee.Feature(s.geometry, {
       class_id: CLASS_ID,
       class_name: 'Barren/Fallow',
       site_id: s.id,
       review_status: s.status,
       historical_date: s.historical_date,
       notes: s.notes,
       source: '2010_native_07B2_candidate',
       target_year: 2010
     });
   });
   var sites = ee.FeatureCollection(features);
   var siteIndex = sites.map(function(f) {
     f = ee.Feature(f);
     var xy = ee.List(f.geometry().centroid(1).coordinates());
     var search = ee.Number(xy.get(1)).format('%.7f')
       .cat(', ').cat(ee.Number(xy.get(0)).format('%.7f'));
     return f.set({
       'area_km2': f.geometry().area(1).divide(1e6),
       'google_earth_lat_lon': search
     });
   });
   Map.addLayer(sites.style({
     color:'FFEA00',fillColor:'FFEA0022',width:2
   }), {}, 'New 2010 site polygons', true);

   // ---------- H. 30 M PIXEL SAMPLING, WITH EXTRA QA BANDS ----------
   var gridXY = ee.Image.pixelCoordinates(PROJ)
     .rename(['grid_x','grid_y']);
   var qaImage = stack2010.addBands(clearCount).addBands(gridXY);
   var allSamples = qaImage.sampleRegions({
     collection: sites,
     properties:[
       'class_id','class_name','site_id','review_status',
       'historical_date','notes','source','target_year'
     ],
     projection:PROJ, scale:SCALE, geometries:true, tileScale:8
   });

   // Filter using actual sampled 2010 pixel centres, not polygon centroids.
   var invalidNearValidation = allSamples.filterBounds(forbidden);
   var separatedSamples = allSamples.filter(
     ee.Filter.bounds(forbidden).not());
   var keyed = separatedSamples.map(function(f) {
     f = ee.Feature(f);
     var key = ee.Number(f.get('grid_x')).format('%.6f')
       .cat('_').cat(ee.Number(f.get('grid_y')).format('%.6f'));
     return f.set('grid_key_07B2', key);
   });
   var uniquePixels = keyed.distinct(['grid_key_07B2']);
   var rawSiteCounts = uniquePixels.aggregate_histogram('site_id');
   var potentialBySite = ee.Dictionary(rawSiteCounts).values().map(
     function(n) { return ee.Number(n).min(SITE_CAP_FOR_PLANNING); }
   );
   var possibleWithSiteCap = ee.Number(ee.Algorithms.If(
     ee.List(potentialBySite).size().gt(0),
     ee.List(potentialBySite).reduce(ee.Reducer.sum()),
     0
   ));
   var reviewedPixels = uniquePixels.filter(
     ee.Filter.eq('review_status','REVIEWED_SITE'));
   var observationConcern = uniquePixels.filter(
     ee.Filter.lt('clear_obs_2010',2));

   // ---------- I. BATCH CONSOLE QA ----------
   print('========================================');
   print('DRAWN SITE INVENTORY (DATES / SIZES / SEARCH COORDINATES)');
   print(siteIndex.select([
     'site_id','review_status','historical_date','notes',
     'area_km2','google_earth_lat_lon'
   ]));
   print('Candidate count BEFORE validation exclusion:');
   print(allSamples.size());
   print('Candidate pixels inside conservative validation zone:');
   print(invalidNearValidation.size());
   print('Candidate count after exclusion, BEFORE dedup:');
   print(keyed.size());
   print('Distinct 30 m candidate pixels AFTER dedup:');
   print(uniquePixels.size());
   print('Repeated grid pixels removed:');
   print(keyed.size().subtract(uniquePixels.size()));
   print('Distinct candidate pixels PER SITE:');
   print(rawSiteCounts);
   print('Candidate pixels from REVIEWED_SITE polygons (not final approvals):');
   print(reviewedPixels.size());
   print('Candidates with fewer than 2 clear Landsat observations:');
   print(observationConcern.size());
   print('Distribution of clear Landsat observations:');
   print(uniquePixels.aggregate_histogram('clear_obs_2010'));
   print('Candidate NDVI summary (diagnostic, NOT a class threshold):');
   print(uniquePixels.aggregate_stats('NDVI'));
   print('Candidate NDBI summary:');
   print(uniquePixels.aggregate_stats('NDBI'));
   print('Candidate NDWI summary:');
   print(uniquePixels.aggregate_stats('NDWI'));
   print('Planning cap per site (not a sample selector):');
   print(SITE_CAP_FOR_PLANNING);
   print('Potential coverage with per-site cap:');
   print(possibleWithSiteCap);
   print('Remaining gap versus 120 with that cap:');
   print(ee.Number(TARGET_PIXELS).subtract(possibleWithSiteCap).max(0));
   print('========================================');
   print('HARD GATES BEFORE 07C:');
   print('1) Verify true 2010 class at each site using historical images.');
   print('2) Compare Class 4 vs Class 5 under same five-year legend.');
   print('3) Remove mixed pixels, weak coverage and site overlaps.');
   print('4) Keep geographic diversity; counts alone are NOT approval.');
   print('5) Audit all five classes, then construct balanced V2 training.');
   print('NO ASSET EXPORT AND NO MLC PERFORMED.');

   Map.addLayer(uniquePixels.style({
     color:'00FFFF',pointSize:4,width:1
   }), {}, 'NEW 2010 candidate PIXEL CENTRES', true);
   Map.addLayer(invalidNearValidation.style({
     color:'FF0000',pointSize:6,width:1
   }), {}, 'Excluded samples near validation', false);
   Map.addLayer(observationConcern.style({
     color:'FF8800',pointSize:6,width:1
   }), {}, 'Review: fewer than 2 clear scenes', false);
   Map.centerObject(sites);
 }

