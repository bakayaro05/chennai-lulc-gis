 // ---------- E. CLEAR-OBSERVATION QA (NOT A PREDICTOR) ----------
 // Reconstruct count with the locked Landsat-5 QA_PIXEL + QA_RADSAT
 // rules. Does NOT change the saved nine-band predictor stack.
 function countableClearL5(image) {
   var qa = image.select('QA_PIXEL');
   var sat = image.select('QA_RADSAT');
   var clear = qa.bitwiseAnd(1 << 0).eq(0)
     .and(qa.bitwiseAnd(1 << 1).eq(0))
     .and(qa.bitwiseAnd(1 << 3).eq(0))
     .and(qa.bitwiseAnd(1 << 4).eq(0))
     .and(qa.bitwiseAnd(1 << 5).eq(0))
     .and(sat.eq(0));
   return image.select('SR_B3').updateMask(clear);
 }
 var scenes2010 = ee.ImageCollection('LANDSAT/LT05/C02/T1_L2')
   .filterBounds(roi).filterDate('2010-01-01','2011-01-01');
 var clearCount = scenes2010.map(countableClearL5).count()
   .rename('clear_obs_2010').clip(roi);
 Map.addLayer(clearCount, {min:0,max:7,
   palette:['AA0000','E69F00','FFFF80','4DAF4A','125A28']
 }, '2010 clear observations (QA only)', false);

 // ---------- F. FIND DRAWN SITE IMPORTS ----------
 var activeSites = SITE_CONFIG.filter(function(s) {
   return s.geometry !== null;
 });
 print('========================================');
 print('07B2 | 2010 NATIVE BARREN/FALLOW SITE AUDIT');
 print('2010 Landsat source scene count:');
 print(scenes2010.size());
