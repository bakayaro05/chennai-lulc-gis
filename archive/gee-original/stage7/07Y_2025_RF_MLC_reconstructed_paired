// ============================================================
// A. RECONSTRUCT THE 2025 LANDSAT 8 + 9 PREDICTOR STACK
// ============================================================

function prepareOLI(im) {

  var qa = im.select('QA_PIXEL');
  var sat = im.select('QA_RADSAT');

  var clear = qa.bitwiseAnd(1).eq(0)
    .and(qa.bitwiseAnd(1 << 1).eq(0))
    .and(qa.bitwiseAnd(1 << 2).eq(0))
    .and(qa.bitwiseAnd(1 << 3).eq(0))
    .and(qa.bitwiseAnd(1 << 4).eq(0))
    .and(qa.bitwiseAnd(1 << 5).eq(0))
    .and(sat.eq(0));

  return im.select(
    ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'],
    ['blue','green','red','nir','swir1','swir2']
  )
  .multiply(0.0000275)
  .add(-0.2)
  .updateMask(clear);
}

function addIndices(im) {

  var red = im.select('red');
  var green = im.select('green');
  var nir = im.select('nir');
  var swir = im.select('swir1');

  return im.addBands([
    nir.subtract(red)
      .divide(nir.add(red))
      .rename('NDVI'),

    green.subtract(nir)
      .divide(green.add(nir))
      .rename('NDWI'),

    swir.subtract(nir)
      .divide(swir.add(nir))
      .rename('NDBI')
  ]);
}

var l8 = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
  .filterBounds(roi)
  .filterDate('2025-01-01','2026-01-01');

var l9 = ee.ImageCollection('LANDSAT/LC09/C02/T1_L2')
  .filterBounds(roi)
  .filterDate('2025-01-01','2026-01-01');

var stack = addIndices(
  l8.merge(l9)
    .map(prepareOLI)
    .median()
)
.select(BANDS)
.clip(roi);

