// ============================================================
// B. GENERATE TRAINING AND VALIDATION PIXEL POOLS
// ============================================================

// Each sampled pixel retains the source polygon identifier.
// Pixel coordinates identify duplicate pixel locations.

function samplePool(polygons, label) {

  var keyedPolys = polygons.map(function(f) {
    return f.set(
      'site_key',
      ee.String(f.get('system:index'))
    );
  });

  var bandsAndGrid = stack.addBands(
    ee.Image.pixelCoordinates(GRID)
      .rename(['grid_x','grid_y'])
  );

  return bandsAndGrid.sampleRegions({
    collection: keyedPolys,
    properties: ['class_id','site_key'],
    projection: GRID,
    scale: 30,
    geometries: true,
    tileScale: 8
  })
  .map(function(f) {

    return f.set(
      'grid_key',
      ee.Number(f.get('grid_x'))
        .format('%.0f')
        .cat('_')
        .cat(
          ee.Number(f.get('grid_y'))
            .format('%.0f')
        )
    );

  })
  .distinct(['grid_key']);
}

var trainingPool = samplePool(
  trainingPolys,
  'training'
);

var validationPool = samplePool(
  validationPolys,
  'validation'
);

