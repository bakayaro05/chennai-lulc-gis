// E. RANDOM FOREST CLASSIFIER
// ============================================================

// Same settings as Stage 07X.

function makeRF() {

  return ee.Classifier.smileRandomForest({
    numberOfTrees: 150,
    variablesPerSplit: 3,
    minLeafPopulation: 3,
    bagFraction: 0.7,
    seed: 20261013
  });

}

var rf = makeRF().train({
  features: training,
  classProperty: 'class_id',
  inputProperties: BANDS
});

var rfPred = validation.classify(
  rf,
  'classification'
);

var rfCM = rfPred.errorMatrix(
  'class_id',
  'classification',
  CLASS_IDS
);

// ============================================================
// F. TRUE GAUSSIAN MAXIMUM LIKELIHOOD CLASSIFIER
// ============================================================

// Nine-dimensional class-specific means and covariances.
// Equal class priors.
// Regularization = 1e-6 * identity matrix.

var D = BANDS.length;

function gaussianParams(c) {

  var members = training.filter(
    ee.Filter.eq('class_id', c)
  );

  var mu = ee.Array([
    BANDS.map(function(b) {
      return members.aggregate_mean(b);
    })
  ]).transpose();

  var cov = ee.Array(
    members.makeArray(BANDS, 'v')
      .reduceColumns({
        reducer: ee.Reducer.covariance()
          .setOutputs(['covariance']),
        selectors: ['v']
      })
      .get('covariance')
  )
  .add(
    ee.Array.identity(D).multiply(1e-6)
  );

  return ee.Dictionary({
    mean: mu,
    inverse: cov.matrixInverse(),
    determinant: cov.matrixDeterminant()
  });

}

var x = stack.toArray().toArray(1);

function score(params, name) {

  params = ee.Dictionary(params);

  var delta = x.subtract(
    ee.Image.constant(
      ee.Array(params.get('mean'))
    )
  );

  var inv = ee.Image.constant(
    ee.Array(params.get('inverse'))
  );

  var sq = delta
    .arrayTranspose()
    .matrixMultiply(inv)
    .matrixMultiply(delta)
    .arrayGet([0,0]);

  var logDet = ee.Number(
    params.get('determinant')
  )
  .max(1e-300)
  .log();

  return sq
    .multiply(-0.5)
    .add(
      ee.Image.constant(logDet)
        .multiply(-0.5)
    )
    .rename(name);
}

var scores = score(
  gaussianParams(1), 's1'
)
.addBands(
  score(gaussianParams(2), 's2')
)
.addBands(
  score(gaussianParams(3), 's3')
)
.addBands(
  score(gaussianParams(4), 's4')
)
.addBands(
  score(gaussianParams(5), 's5')
);

var mlc = scores
  .toArray()
  .arrayArgmax()
  .arrayGet([0])
  .add(1)
  .toInt8()
  .rename('classification');

// ============================================================
// G. VALIDATE GAUSSIAN MLC
// ============================================================

var mlcPred = mlc.sampleRegions({
  collection: validation,
  properties: ['class_id'],
  projection: GRID,
  scale: 30,
  geometries: false,
  tileScale: 8
});

var mlcCM = mlcPred.errorMatrix(
  'class_id',
  'classification',
  CLASS_IDS
);

// ============================================================
// H. GROUPED RANDOM FOREST CROSS-VALIDATION
// ============================================================

// All pixels from one source training polygon remain
// in the same fold.

function withSiteFolds(c) {

  var subset = training.filter(
    ee.Filter.eq('class_id', c)
  );

  var sites = ee.List(
    subset.aggregate_array('site_key')
  )
  .distinct()
  .sort();

  return subset.map(function(f) {

    return f.set(
      'site_fold',
      ee.Number(
        sites.indexOf(f.get('site_key'))
      ).mod(5)
    );

  });

}

var folded = ee.FeatureCollection([]);

CLASS_IDS.forEach(function(c) {

  folded = folded.merge(
    withSiteFolds(c)
  );

});

var cvPred = ee.FeatureCollection(

  ee.List.sequence(0,4).iterate(

    function(v,acc) {

      v = ee.Number(v);

      var tr = folded.filter(
        ee.Filter.neq('site_fold', v)
      );

      var te = folded.filter(
        ee.Filter.eq('site_fold', v)
      );

      var model = makeRF().train({
        features: tr,
        classProperty: 'class_id',
        inputProperties: BANDS
      });

      return ee.FeatureCollection(acc).merge(
        te.classify(
          model,
          'classification'
        )
      );

    },

    ee.FeatureCollection([])

  )

);

var cvCM = cvPred.errorMatrix(
  'class_id',
  'classification',
  CLASS_IDS
);

