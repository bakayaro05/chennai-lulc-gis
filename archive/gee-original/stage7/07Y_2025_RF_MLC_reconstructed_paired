// ============================================================
// C. BALANCED SAMPLING
// ============================================================

// Approximate the original seeds:
// Training = 42
// Validation = 84
//
// This is a new paired comparison, not an exact reproduction
// of the original 2025 sampling sequence.

function takeByClass(pool, perClass, seed, randomName) {

  var result = ee.FeatureCollection([]);

  CLASS_IDS.forEach(function(c) {

    result = result.merge(
      pool
        .filter(ee.Filter.eq('class_id', c))
        .randomColumn(randomName, seed)
        .sort(randomName)
        .limit(perClass)
    );

  });

  return result;
}

var training = takeByClass(
  trainingPool,
  120,
  42,
  'selection_random'
);

