// ============================================================
// 1. PROJECT SETTINGS
// ============================================================

var ROOT =
  'projects/assignment-482806/assets/';

var CRS = 'EPSG:32644';

var SCALE = 30;

var BANDS = [
  'blue',
  'green',
  'red',
  'nir',
  'swir1',
  'swir2',
  'NDVI',
  'NDWI',
  'NDBI'
];


// ============================================================
// 2. LOAD LOCKED ASSETS
// ============================================================

var roiFC = ee.FeatureCollection(
  ROOT + 'chennai_admin_study_area_clean'
);

var roi = roiFC.geometry();

var stack2010 = ee.Image(
  ROOT + 'chennai_predictor_stack_2010'
)
.select(BANDS)
.clip(roi);

var source2015 = ee.FeatureCollection(
  ROOT + 'chennai_training_2015_final'
);

var validationPolygons2010 = ee.FeatureCollection(
  ROOT +
  'chennai_validation_polygons_2010_manual_master'
);


// ============================================================
// 3. MANUALLY APPROVED POLYGON ID LEDGER
// ============================================================
//
// These are the recovered approvals.
//
// Built-up ID 11 remains excluded (partial review).
//
// Barren/Fallow approval list remains unconfirmed.
//
// Do not automatically approve additional IDs.
//
// ============================================================

var APPROVED = {

  1: [
    1, 3, 4, 5, 6, 7, 8, 9, 12
  ],

  2: [
    16, 17, 25
  ],

  3: [
    31, 32, 35, 38, 39, 201
  ],

  4: [
    46, 47, 51, 52, 53, 55, 56, 57, 58
  ],

  5: []

};


// Agricultural/Open IDs within one known macro-site.
// These are not seven independent geographic sites.

var AGRI_MACRO = [
  47, 51, 52, 53, 55, 56, 58
];


// ============================================================
// 4. BUILD EE APPROVAL DICTIONARY
// ============================================================

var approvedDictionary = ee.Dictionary({

  '1': APPROVED[1],

  '2': APPROVED[2],

  '3': APPROVED[3],

  '4': APPROVED[4],

  '5': APPROVED[5]

});


// ============================================================
// 5. TAG SOURCE TRAINING LOCATIONS
// ============================================================
//
// FIX:
// ee.List.contains() returns a Boolean.
//
// Do not pass that directly into ee.Number.and().
//
// Instead use ee.Algorithms.If().
//
// ============================================================

function tagSource(feature) {

  feature = ee.Feature(feature);

  var id = ee.Number(
    feature.get('class_id')
  );

  var pid = ee.Number(
    feature.get('poly_id')
  );

  var classKey = id.format('%d');

  var approvedIds = ee.List(
    approvedDictionary.get(classKey)
  );

  var isApproved = approvedIds.contains(pid);

  // FIXED CONDITIONAL

  var isAgriMacro = ee.Algorithms.If(

    id.eq(4),

    ee.List(AGRI_MACRO).contains(pid),

    false

  );

  var reviewStatus = ee.Algorithms.If(

    isApproved,

    'APPROVED_LOCATION',

    'NEEDS_MANUAL_REVIEW'

  );

  var siteGroup = ee.Algorithms.If(

    isAgriMacro,

    'AGRI_MACRO_SITE',

    pid.format('%d')

  );

  return feature.set({

    'review_status_07A': reviewStatus,

    'site_group_07A': siteGroup,

    'source_year_07A': 2015

  });

}


// ============================================================
// 6. APPLY MANUAL APPROVAL LEDGER
// ============================================================

var labelledSources = source2015

  .filter(
    ee.Filter.notNull([
      'class_id',
      'poly_id'
    ])
  )

  .map(tagSource);


var approvedSources = labelledSources.filter(

  ee.Filter.eq(
    'review_status_07A',
    'APPROVED_LOCATION'
  )

);


var needsReviewSources = labelledSources.filter(

  ee.Filter.eq(
    'review_status_07A',
    'NEEDS_MANUAL_REVIEW'
  )

);


// ============================================================
// 7. VALIDATION EXCLUSION — CORRECTED
// ============================================================
//
// Exclude training source points that intersect the
// independent 2010 validation polygons or their 30 m buffer.
//
// ============================================================

var validationExclusion = validationPolygons2010
  .geometry()
  .buffer(30, 1);

var outsideValidation = approvedSources.filter(

  ee.Filter.bounds(validationExclusion).not()

);

// ============================================================
// 8. SAMPLE 2010 PREDICTOR VALUES
// ============================================================
//
// Re-sample original locations using the 2010 stack.
//
// Do not transfer 2015 reflectance or indices.
//
// ============================================================

var sampled2010 = stack2010.sampleRegions({

  collection: outsideValidation,

  properties: [
    'class_id',
    'class_name',
    'poly_id',
    'review_status_07A',
    'site_group_07A',
    'source_year_07A'
  ],

  projection: ee.Projection(CRS),

  scale: SCALE,

  geometries: true,

  tileScale: 8

});


// ============================================================
// 9. GRID COORDINATE BANDS
// ============================================================
//
// Identify samples falling on identical 30 m grid cells.
//
// ============================================================

var gridProjection = ee.Projection(CRS)
  .atScale(SCALE);

var coordinates = ee.Image.pixelCoordinates(
  gridProjection
)
.rename([
  'grid_x',
  'grid_y'
]);


var stackWithGrid = stack2010.addBands(
  coordinates
);


// ============================================================
// 10. SAMPLE WITH GRID COORDINATES
// ============================================================

var withGrid = stackWithGrid.sampleRegions({

  collection: outsideValidation,

  properties: [
    'class_id',
    'class_name',
    'poly_id',
    'review_status_07A',
    'site_group_07A'
  ],

  projection: gridProjection,

  scale: SCALE,

  geometries: true,

  tileScale: 8

});

  
// ============================================================
// 11. GENERATE UNIQUE GRID KEYS
// FIXED VERSION 3 — FLOAT-SAFE
// ============================================================
//
// Earth Engine pixel coordinates may contain decimals.
//
// Example:
// grid_x = 47479.5
//
// Using format('%d') causes a type error.
//
// Use format('%.6f') to preserve decimal coordinates.
//
// This avoids unintentionally merging different
// grid coordinates through integer rounding.
//
// ============================================================

var withGridKeys = withGrid.map(function(feature) {

  feature = ee.Feature(feature);

  var gridX = ee.Number(
    feature.get('grid_x')
  );

  var gridY = ee.Number(
    feature.get('grid_y')
  );

  // FLOAT-SAFE COORDINATE FORMATTING

  var gridKey = gridX

    .format('%.6f')

    .cat('_')

    .cat(
      gridY.format('%.6f')
    );

  return feature.set({

    'grid_key_07A': gridKey

  });

});


// ============================================================
// 12. IDENTIFY UNIQUE GRID LOCATIONS
// ============================================================
//
// Keep this section after Section 11.
//
// This is only a candidate-level duplicate audit.
//
// Do not use distinctGrid as final training until
// class conflicts and source-site diversity are checked.
//
// ============================================================

var distinctGrid = withGridKeys.distinct([
  'grid_key_07A'
]);

var duplicateCount = withGridKeys.size()

  .subtract(
    distinctGrid.size()
  );


// ============================================================
// 12. IDENTIFY UNIQUE GRID LOCATIONS
// ============================================================
//
// Audit duplicate samples.
//
// This is NOT final training selection.
//
// If conflicting classes share a grid pixel,
// those locations require manual inspection.
//
// ============================================================

var distinctGrid = withGridKeys.distinct([
  'grid_key_07A'
]);

var duplicateCount = withGridKeys.size()

  .subtract(
    distinctGrid.size()
  );


