// 6. LANDSAT 8 VERSUS LANDSAT 7 AVAILABILITY
// Only clear-observation counts are calculated.
// No bands from different sensors are merged.

var start = '2015-01-01';
var end = '2016-01-01';

var l8 = ee.ImageCollection(
  'LANDSAT/LC08/C02/T1_L2'
)
.filterBounds(roi)
.filterDate(start, end);

var l7 = ee.ImageCollection(
  'LANDSAT/LE07/C02/T1_L2'
)
.filterBounds(roi)
.filterDate(start, end);


// Same project QA masking principles.
// L7 dropped-pixel flag is excluded.
// L8 cirrus flag is also excluded.

function clearCountFlag(image, sensor) {

  var qa = image.select('QA_PIXEL');
  var sat = image.select('QA_RADSAT');

  var ok = qa.bitwiseAnd(1 << 0).eq(0)
    .and(qa.bitwiseAnd(1 << 1).eq(0))
    .and(qa.bitwiseAnd(1 << 3).eq(0))
    .and(qa.bitwiseAnd(1 << 4).eq(0))
    .and(qa.bitwiseAnd(1 << 5).eq(0))
    .and(sat.eq(0));

  if (sensor === 'L8') {

    ok = ok.and(
      qa.bitwiseAnd(1 << 2).eq(0)
    );

  } else {

    ok = ok.and(
      sat.bitwiseAnd(1 << 9).eq(0)
    );

  }

  var srBand = sensor === 'L8'
    ? 'SR_B4'
    : 'SR_B3';

  return ee.Image.constant(1)
    .rename('clear')
    .updateMask(ok)
    .updateMask(
      image.select(srBand).mask()
    );

}

var l8Flags = l8.map(function(im) {
  return clearCountFlag(im, 'L8');
});

var l7Flags = l7.map(function(im) {
  return clearCountFlag(im, 'L7');
});

var n8 = l8Flags.count()
  .unmask(0)
  .clip(roi)
  .rename('L8_count');

var n7 = l7Flags.count()
  .unmask(0)
  .clip(roi)
  .rename('L7_count');

var together = l8Flags.merge(l7Flags)
  .count()
  .unmask(0)
  .clip(roi)
  .rename('L8_L7_count');


// 7. COVERAGE STATISTICS

var coverage = ee.Image.cat([

  n8,
  n7,
  together,

  n8.gte(3)
    .toFloat()
    .rename('L8_3plus_fraction'),

  together.gte(3)
    .toFloat()
    .rename('Combined_3plus_fraction'),

  n8.lte(1)
    .toFloat()
    .rename('L8_0or1_fraction'),

  together.lte(1)
    .toFloat()
    .rename('Combined_0or1_fraction'),

  n7.gt(0)
    .toFloat()
    .rename('Fraction_with_L7_observations')

]).reduceRegion({

  reducer: ee.Reducer.mean(),
  geometry: roi,
  crs: CRS,
  scale: SCALE,
  maxPixels: 1e9,
  tileScale: 8

});

var percentiles = ee.Image.cat([
  n8,
  n7,
  together
]).reduceRegion({

  reducer: ee.Reducer.percentile([
    10, 25, 50, 75, 90
  ]),

  geometry: roi,
  crs: CRS,
  scale: SCALE,
  maxPixels: 1e9,
  tileScale: 8

});

