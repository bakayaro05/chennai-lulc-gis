var ROOT = 'projects/assignment-482806/assets/';

var GRID = ee.Projection(
  'EPSG:32644',
  [30, 0, 399060, 0, -30, 1463250]
);

var roi = ee.FeatureCollection(
  ROOT + 'chennai_admin_study_area_clean'
).geometry();

var training = ee.FeatureCollection(
  ROOT + 'chennai_training_2010_L5L7_manual_exp_v1'
);

var validation = ee.FeatureCollection(
  ROOT + 'chennai_validation_2010_final'
);

var stack = ee.Image(
  ROOT + 'chennai_predictor_stack_2010_L5L7_exp_v1'
).select([
  'blue', 'green', 'red',
  'nir', 'swir1', 'swir2',
  'NDVI', 'NDWI', 'NDBI'
]);

var classification = ee.Image(
  ROOT + 'chennai_mlc_lulc_2010_L5L7_manual_exp_v1'
).select('classification').rename('predicted');

// =============================================================
// A. TRAINING CLASS SIGNATURES
// =============================================================

function classProfile(classId) {

  var subset = training.filter(
    ee.Filter.eq('class_id', classId)
  );

  return ee.Feature(null, {
    class_id: classId,
    sample_count: subset.size(),
    source_sites:
      subset.aggregate_count_distinct('site_id'),
    NDVI_mean: subset.aggregate_mean('NDVI'),
    NDBI_mean: subset.aggregate_mean('NDBI'),
    NDWI_mean: subset.aggregate_mean('NDWI'),
    red_mean: subset.aggregate_mean('red'),
    swir1_mean: subset.aggregate_mean('swir1')
  });

}

var classProfiles = ee.FeatureCollection([
  classProfile(1),
  classProfile(4),
  classProfile(5)
]);

// =============================================================
// B. INDIVIDUAL TRAINING SITE PROFILES
// =============================================================

function siteProfiles(classId) {

  var subset = training.filter(
    ee.Filter.eq('class_id', classId)
  );

  var ids = ee.List(
    subset.aggregate_array('site_id')
  ).distinct().sort();

  return ee.FeatureCollection(ids.map(function(id) {

    var site = subset.filter(
      ee.Filter.eq('site_id', id)
    );

    return ee.Feature(null, {
      site_id: id,
      class_id: classId,
      samples: site.size(),
      NDVI_mean: site.aggregate_mean('NDVI'),
      NDBI_mean: site.aggregate_mean('NDBI'),
      NDWI_mean: site.aggregate_mean('NDWI'),
      red_mean: site.aggregate_mean('red'),
      swir1_mean: site.aggregate_mean('swir1')
    });

  }));

}

var agriculturalSites = siteProfiles(4);
var vacantSites = siteProfiles(5);

// =============================================================
// C. PREDICT EXISTING VALIDATION LOCATIONS
// =============================================================

var validationPred = stack
  .addBands(classification)
  .sampleRegions({
    collection: validation,
    properties: ['class_id'],
    projection: GRID,
    scale: 30,
    geometries: true,
    tileScale: 8
  })
  .map(function(f) {

    var coords = ee.List(
      f.geometry()
       .transform('EPSG:4326', 1)
       .coordinates()
    );

    return f.set({
      longitude: coords.get(0),
      latitude: coords.get(1)
    });

  });

var cm = validationPred.errorMatrix(
  'class_id',
  'predicted',
  [1, 2, 3, 4, 5]
);

// =============================================================
// D. CHOOSE HISTORICAL REVIEW CANDIDATES
//
// These are EXISTING validation locations.
// Do not move them into training or change their labels
// based on classifier predictions.
// =============================================================

function reviewCases(actualClass, mappedClass) {

  return validationPred
    .filter(ee.Filter.eq('class_id', actualClass))
    .filter(ee.Filter.eq('predicted', mappedClass))
    .randomColumn(
      'audit_random',
      20101018,
      'uniform',
      ['latitude', 'longitude']
    )
    .sort('audit_random')
    .limit(5)
    .select([
      'class_id',
      'predicted',
      'latitude',
      'longitude',
      'NDVI',
      'NDBI',
      'NDWI'
    ]);

}

var vacantToAgri = reviewCases(5, 4);
var vacantToVegetation = reviewCases(5, 2);
var agriToVacant = reviewCases(4, 5);
var agriToBuilt = reviewCases(4, 1);

