 // CHENNAI LULC — STAGE 07Z2
 // 2010 CLASS 4 vs CLASS 5 SPECTRAL SEPARABILITY TEST
 //
 // CLASS 4: Recognizable agricultural land / fields.
 // CLASS 5: Unused open land, INCLUDING green/weedy/shrubby plots.
 //          NOT necessarily dry soil, and NOT farmland.
 //
 // Existing 2010 Landsat 5+7 nine-band stack.
 // Read-only; no exports, training changes or relabelling.
 // =====================================================================

var ROOT = 'projects/assignment-482806/assets/';

var GRID = ee.Projection(
  'EPSG:32644',
  [30, 0, 399060, 0, -30, 1463250]
);

var BANDS9 = [
  'blue', 'green', 'red',
  'nir', 'swir1', 'swir2',
  'NDVI', 'NDWI', 'NDBI'
];

var trainingAll = ee.FeatureCollection(
  ROOT + 'chennai_training_2010_L5L7_manual_exp_v1'
);

var validationAll = ee.FeatureCollection(
  ROOT + 'chennai_validation_2010_final'
);

var stack = ee.Image(
  ROOT + 'chennai_predictor_stack_2010_L5L7_exp_v1'
).select(BANDS9);

var originalMLC = ee.Image(
  ROOT + 'chennai_mlc_lulc_2010_L5L7_manual_exp_v1'
).select('classification');

var train45 = trainingAll.filter(
  ee.Filter.inList('class_id', [4, 5])
);

var val45 = validationAll.filter(
  ee.Filter.inList('class_id', [4, 5])
