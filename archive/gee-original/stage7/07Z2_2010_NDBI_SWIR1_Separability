// IMPORTANT:
// Binary accuracy is CONDITIONAL on actual class being 4 or 5.
// This does not estimate accuracy across all five classes.

tests.forEach(function(t) {

  var pred = binaryMLC(
    t.bands,
    t.name
  ).sampleRegions({
    collection: val45,
    properties: ['class_id'],
    projection: GRID,
    scale: 30,
    geometries: false,
    tileScale: 8
  });

  var cm = pred.errorMatrix(
    'class_id',
    t.name,
    [4, 5]
  );

  print('------------------------------------------------');

  print('BINARY GAUSSIAN MLC — ' + t.name);

  print('Predictors: ' + t.bands.join(', '));

  print('Evaluated points (expected 120):');
  print(pred.size());

  print('Confusion matrix [4,5]:');
  print(cm);

  print('Two-class accuracy (%):');
  print(
    ee.Number(cm.accuracy())
      .multiply(100)
  );

  print('Class 4 and Class 5 producer accuracies:');
  print(cm.producersAccuracy());

});

