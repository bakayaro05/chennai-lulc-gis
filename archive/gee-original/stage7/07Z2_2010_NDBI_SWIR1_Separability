var valSpectra = stack.sampleRegions({
  collection: val45,
  properties: ['class_id'],
  projection: GRID,
  scale: 30,
  geometries: false,
  tileScale: 8
});

// =============================================================
// A. SPECTRAL PROFILES
// =============================================================

function summaryFor(data, classId, source) {

  var sub = data.filter(
    ee.Filter.eq('class_id', classId)
  );

  var fields = ['NDVI', 'NDBI', 'swir1'];

  var output = ee.Dictionary({
    source: source,
    class_id: classId,
    count: sub.size()
  });

  fields.forEach(function(b) {

    var percentiles = sub.reduceColumns({
      reducer: ee.Reducer.percentile([25, 50, 75]),
      selectors: [b]
    });

    output = output
      .set(b + '_mean', sub.aggregate_mean(b))
      .set(b + '_sd', sub.aggregate_total_sd(b))
      .set(b + '_p25', percentiles.get('p25'))
      .set(b + '_median', percentiles.get('p50'))
      .set(b + '_p75', percentiles.get('p75'));

  });

  return ee.Feature(null, output);
}

var profiles = ee.FeatureCollection([
  summaryFor(train45, 4, 'training'),
  summaryFor(train45, 5, 'training'),
  summaryFor(valSpectra, 4, 'validation'),
  summaryFor(valSpectra, 5, 'validation')
]);

// Standardized difference between class means.
// Larger values suggest greater univariate separation,
// but do not guarantee distinguishable individual pixels.

function standardizedDifference(b) {

  var a = train45.filter(
    ee.Filter.eq('class_id', 4)
  );

  var v = train45.filter(
    ee.Filter.eq('class_id', 5)
  );

  var ma = ee.Number(a.aggregate_mean(b));
  var mv = ee.Number(v.aggregate_mean(b));

  var sa = ee.Number(a.aggregate_total_sd(b));
  var sv = ee.Number(v.aggregate_total_sd(b));

  var pooled = sa.pow(2)
    .add(sv.pow(2))
    .divide(2)
    .sqrt();

  return ee.Feature(null, {
    band: b,
    mean_4: ma,
    mean_5: mv,
    pooled_sd: pooled,
    absolute_standardized_difference:
      ma.subtract(mv).abs()
        .divide(pooled.max(1e-12))
  });
}

var separability = ee.FeatureCollection([
  standardizedDifference('NDVI'),
  standardizedDifference('NDBI'),
  standardizedDifference('swir1')
]);

// =============================================================
// B. GAUSSIAN PARAMETERS FOR TWO CLASSES
// =============================================================

function params(classId, bands) {

  var subset = train45.filter(
    ee.Filter.eq('class_id', classId)
  );

  var mu = ee.Array([
    bands.map(function(b) {
      return subset.aggregate_mean(b);
    })
  ]).transpose();

  var cov = ee.Array(

    subset.makeArray(bands, 'values')
      .reduceColumns({
        reducer: ee.Reducer.covariance()
          .setOutputs(['covariance']),
        selectors: ['values']
      })
      .get('covariance')

  ).add(
    ee.Array.identity(bands.length)
      .multiply(1e-6)
  );

  return ee.Dictionary({
    mu: mu,
    inverse: cov.matrixInverse(),
    determinant: cov.matrixDeterminant()
  });

}

// =============================================================
// C. GAUSSIAN LOG-LIKELIHOOD
// =============================================================

function gaussianScore(x, p) {

  p = ee.Dictionary(p);

  var mu = ee.Image.constant(
    ee.Array(p.get('mu'))
  );

  var inv = ee.Image.constant(
    ee.Array(p.get('inverse'))
  );

  var determinant = ee.Number(
    p.get('determinant')
  ).max(1e-300);

  var delta = x.subtract(mu);

  var d2 = delta
    .arrayTranspose()
    .matrixMultiply(inv)
    .matrixMultiply(delta)
    .arrayGet([0, 0]);

  return d2.multiply(-0.5)
    .subtract(
      ee.Image.constant(
        determinant.log()
      ).multiply(0.5)
    );

}

// =============================================================
// D. BINARY CLASS 4 / CLASS 5 GAUSSIAN MLC
// =============================================================

function binaryMLC(bands, outputBand) {

  var x = stack.select(bands)
    .toArray()
    .toArray(1);

  var score4 = gaussianScore(
    x, params(4, bands)
  );

  var score5 = gaussianScore(
    x, params(5, bands)
  );

  var valid = stack.select(bands)
    .mask()
    .reduce(ee.Reducer.min());

  return ee.Image.constant(5)
    .where(score4.gte(score5), 4)
    .updateMask(valid)
    .rename(outputBand)
    .toByte();

}

