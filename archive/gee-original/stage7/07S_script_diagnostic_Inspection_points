// 1. Assign IDs to the existing selected points.
// Stable for the current deterministic Stage 07S selection.

var sortedAudit = auditPoints.sort('system:index');

var auditList = sortedAudit.toList(sortedAudit.size());

var indexedAudit = ee.FeatureCollection(
  ee.List.sequence(0, sortedAudit.size().subtract(1))
    .map(function(i) {

      i = ee.Number(i);

      var f = ee.Feature(auditList.get(i));

      var id = ee.String('AUDIT_')
        .cat(i.add(1).format('%02d'));

      return f.set('audit_id', id);

    })
);

// 2. Print IDs and coordinates.

print('========================================');
print('STAGE 07S — AUDIT POINT IDENTIFICATION');
print('========================================');

print('Audit points with IDs:');
print(
  indexedAudit.select([
    'audit_id',
    'transition',
    'class_2010',
    'class_2015',
    'latitude',
    'longitude'
  ]).sort('audit_id')
);

// 3. Create a small map identification panel.

var identifyPanel = ui.Panel({
  style: {
    position: 'bottom-left',
    width: '340px',
    padding: '8px'
  }
});

identifyPanel.add(
  ui.Label({
    value: 'Chennai Historical Audit — Point Identifier',
    style: {
      fontWeight: 'bold',
      fontSize: '14px'
    }
  })
);

var resultLabel = ui.Label(
  'Click near a coloured audit point to identify it.'
);

identifyPanel.add(resultLabel);

Map.add(identifyPanel);

// 4. Click-based point identification.
//
// A 40-metre search radius helps select an audit point
// without identifying unrelated pixels.

Map.onClick(function(coords) {

  resultLabel.setValue('Searching for audit point...');

  var clicked = ee.Geometry.Point([
    coords.lon,
    coords.lat
  ]);

  var nearby = indexedAudit.filterBounds(
    clicked.buffer(40)
  );

  nearby.size().evaluate(function(count) {

    if (count === 0) {

      resultLabel.setValue(
        'No audit point within 40 m. Zoom in and click nearer.'
      );

      return;
    }

    var nearest = nearby.map(function(f) {

      return ee.Feature(f).set(
        'click_distance_m',
        f.geometry().distance(clicked, 1)
      );

    }).sort('click_distance_m').first();

    nearest.toDictionary([
      'audit_id',
      'transition',
      'class_2010',
      'class_2015',
      'latitude',
      'longitude',
      'click_distance_m'
    ]).evaluate(function(info) {

      if (!info) {
        resultLabel.setValue('Could not identify point.');
        return;
      }

      resultLabel.setValue(
        'ID: ' + info.audit_id +
        '\nTransition: ' + info.transition +
        '\n2010 Class: ' + info.class_2010 +
        '\n2015 Class: ' + info.class_2015 +
        '\nLatitude: ' + info.latitude +
        '\nLongitude: ' + info.longitude +
        '\nDistance from click: ' +
        Number(info.click_distance_m).toFixed(1) + ' m'
      );

    });

  });

});

// 5. Display the same audit points on the map.

Map.addLayer(
  indexedAudit.style({
    color: 'FFFFFF',
    pointSize: 4
  }),
  {},
  'ALL 35 AUDIT POINTS — IDENTIFIABLE',
  false
);

print('Click near a point on the map to display its audit ID.');
print('No saved assets have been modified.');

