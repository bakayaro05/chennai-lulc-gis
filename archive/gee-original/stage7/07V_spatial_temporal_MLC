 // ================================================================
 // G. ACTUAL 15-DIMENSIONAL GAUSSIAN MLC
 // ================================================================

 function parametersFor(classId) {

   var members = train15.filter(
     ee.Filter.eq('class_id', classId)
   );

   var mean = ee.Array([

     PREDICTORS.map(function(b) {
       return members.aggregate_mean(b);
     })

   ]).transpose();

   var covariance = ee.Array(

     members.makeArray(
       PREDICTORS,
       'features_array'
     )
     .reduceColumns({

       reducer: ee.Reducer.covariance()
         .setOutputs(['covariance']),

       selectors: ['features_array']

     })
     .get('covariance')

   )
   .add(
     ee.Array.identity(D).multiply(1e-6)
   );

   return ee.Dictionary({
     mean: mean,
     inverse: covariance.matrixInverse(),
     determinant: covariance.matrixDeterminant()
   });
 }

 var x = enriched
   .select(PREDICTORS)
   .toArray()
   .toArray(1);

 function gaussianScore(params, outputBand) {

   params = ee.Dictionary(params);

   var mu = ee.Image.constant(
     ee.Array(params.get('mean'))
   );

   var inverse = ee.Image.constant(
     ee.Array(params.get('inverse'))
   );

   var determinant = ee.Number(
     params.get('determinant')
   ).max(1e-300);

   var delta = x.subtract(mu);

   var mahalanobis = delta
     .arrayTranspose()
     .matrixMultiply(inverse)
     .matrixMultiply(delta)
     .arrayGet([0, 0]);

   return mahalanobis
     .multiply(-0.5)
     .add(
       ee.Image.constant(
         determinant.log()
       ).multiply(-0.5)
     )
     .rename(outputBand);

 }

 var scoreStack = gaussianScore(
   parametersFor(1), 'score_1'
 )
 .addBands(
   gaussianScore(parametersFor(2), 'score_2')
 )
 .addBands(
   gaussianScore(parametersFor(3), 'score_3')
 )
 .addBands(
   gaussianScore(parametersFor(4), 'score_4')
 )
 .addBands(
   gaussianScore(parametersFor(5), 'score_5')
 );

 var experimentalMLC = scoreStack
   .toArray()
   .arrayArgmax()
   .arrayGet([0])
   .add(1)
   .toInt8()
   .rename('classification');

 // ================================================================
