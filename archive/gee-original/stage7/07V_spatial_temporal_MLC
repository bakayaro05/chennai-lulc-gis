 // ====================================================================

 var TEST_YEAR = 2010;

 var ROOT = 'projects/assignment-482806/assets/';
 var CRS = 'EPSG:32644';
 var TRANSFORM = [30, 0, 399060, 0, -30, 1463250];
 var GRID = ee.Projection(CRS, TRANSFORM);
 var SCALE = 30;
 var CLASS_IDS = [1, 2, 3, 4, 5];

 var BASE = [
   'blue', 'green', 'red',
   'nir', 'swir1', 'swir2',
   'NDVI', 'NDWI', 'NDBI'
 ];

 var EXTRA = [
   'NDVI_nb3_mean', 'NDBI_nb3_mean',
   'NDVI_nb3_sd', 'NDBI_nb3_sd',
   'NDVI_time_sd', 'NDBI_time_sd'
 ];

 var PREDICTORS = BASE.concat(EXTRA);
 var D = PREDICTORS.length;

 var ROI = ee.FeatureCollection(
   ROOT + 'chennai_admin_study_area_clean'
 ).geometry();

 // ================================================================
 // A. LOAD ORIGINAL TRAINING, VALIDATION AND CLASSIFICATIONS
 // ================================================================

 var is2015 = (TEST_YEAR === 2015);

 var training = ee.FeatureCollection(ROOT + (
   is2015
     ? 'chennai_training_2015_final'
     : 'chennai_training_2010_L5L7_manual_exp_v1'
 ));

 var validation = ee.FeatureCollection(ROOT + (
   is2015
     ? 'chennai_validation_2015_final'
     : 'chennai_validation_2010_final'
 ));

 var originalMap = ee.Image(ROOT + (
   is2015
     ? 'chennai_mlc_lulc_2015'
     : 'chennai_mlc_lulc_2010_L5L7_manual_exp_v1'
 )).select('classification');

 // ================================================================
 // B. LANDSAT PREPROCESSING
 // ================================================================

 function prepareSR(img, isOLI) {

   var qa = img.select('QA_PIXEL');
   var sat = img.select('QA_RADSAT');

   var clear = qa.bitwiseAnd(1 << 0).eq(0)
     .and(qa.bitwiseAnd(1 << 1).eq(0))
     .and(qa.bitwiseAnd(1 << 3).eq(0))
     .and(qa.bitwiseAnd(1 << 4).eq(0))
     .and(qa.bitwiseAnd(1 << 5).eq(0))
     .and(sat.eq(0));

   if (isOLI) {
     clear = clear.and(
       qa.bitwiseAnd(1 << 2).eq(0)
     );
   }

   // QA_RADSAT == 0 also removes L7 dropped pixels.

   var inputBands = isOLI
     ? [
         'SR_B2', 'SR_B3', 'SR_B4',
         'SR_B5', 'SR_B6', 'SR_B7'
       ]
     : [
         'SR_B1', 'SR_B2', 'SR_B3',
         'SR_B4', 'SR_B5', 'SR_B7'
       ];

   return img.select(
     inputBands,
     ['blue', 'green', 'red',
      'nir', 'swir1', 'swir2']
   )
   .multiply(0.0000275)
   .add(-0.2)
   .updateMask(clear);
 }

 function addAllIndices(img) {

   var green = img.select('green');
   var red = img.select('red');
   var nir = img.select('nir');
   var swir = img.select('swir1');

   return img.addBands([

     nir.subtract(red)
       .divide(nir.add(red))
       .rename('NDVI'),

     green.subtract(nir)
       .divide(green.add(nir))
       .rename('NDWI'),

     swir.subtract(nir)
       .divide(swir.add(nir))
       .rename('NDBI')

   ]);
 }

 var start = TEST_YEAR + '-01-01';
 var end = (TEST_YEAR + 1) + '-01-01';

 var l5 = ee.ImageCollection(
   'LANDSAT/LT05/C02/T1_L2'
 )
 .filterBounds(ROI)
 .filterDate(start, end);

 var l7 = ee.ImageCollection(
   'LANDSAT/LE07/C02/T1_L2'
 )
 .filterBounds(ROI)
 .filterDate(start, end);

 var l8 = ee.ImageCollection(
   'LANDSAT/LC08/C02/T1_L2'
 )
 .filterBounds(ROI)
 .filterDate(start, end);

 var observations = is2015

   ? l8.map(function(im) {
       return addAllIndices(
         prepareSR(im, true)
       );
     })

   : l5.map(function(im) {
       return addAllIndices(
         prepareSR(im, false)
       );
     })
     .merge(
       l7.map(function(im) {
         return addAllIndices(
           prepareSR(im, false)
         );
       })
     );

 // Use saved 2010 nine-band stack.
 // Reconstruct 2015 using its verified 07U2 method.

 var baseline = is2015

   ? addAllIndices(
       observations.select([
         'blue', 'green', 'red',
         'nir', 'swir1', 'swir2'
       ]).median()
     ).select(BASE).clip(ROI)

   : ee.Image(
       ROOT + 'chennai_predictor_stack_2010_L5L7_exp_v1'
     ).select(BASE);

 baseline = baseline.reproject(GRID);

 // ================================================================
 // C. SPATIAL FEATURES — 3x3 PIXEL NEIGHBOURHOOD
 // ================================================================

 var kernel = ee.Kernel.square({
   radius: 1,
   units: 'pixels',
   normalize: false
 });

 var twoIndices = baseline.select([
   'NDVI', 'NDBI'
 ]);

 var spatialMeans = twoIndices.reduceNeighborhood({
   reducer: ee.Reducer.mean(),
   kernel: kernel
 }).rename([
   'NDVI_nb3_mean',
   'NDBI_nb3_mean'
 ]);

 var spatialSD = twoIndices.reduceNeighborhood({
   reducer: ee.Reducer.stdDev(),
   kernel: kernel
 }).rename([
   'NDVI_nb3_sd',
   'NDBI_nb3_sd'
 ]);

 // ================================================================
 // D. TEMPORAL FEATURES — ANNUAL SPECTRAL VARIABILITY
 // ================================================================

 var temporalCollection = observations.select([
   'NDVI', 'NDBI'
 ]);

 var temporalSD = temporalCollection.reduce(
   ee.Reducer.stdDev(),
   4
 ).rename([
   'NDVI_time_sd',
   'NDBI_time_sd'
 ]);

 var obsCount = temporalCollection
   .select('NDVI')
   .count()
   .unmask(0)
   .rename('clear_obs');

 // For rare pixels without enough observations, the temporal
 // standard deviation is set to 0. We separately report the
 // number of poorly observed validation locations.

 var enriched = baseline
   .addBands(spatialMeans)
   .addBands(spatialSD)
   .addBands(temporalSD.unmask(0))
   .addBands(obsCount)
   .select(
     PREDICTORS.concat(['clear_obs'])
   );

 // ================================================================
 // E. RE-EXTRACT TRAINING AND VALIDATION DATA
 // ================================================================

 var train15 = enriched.sampleRegions({
   collection: training,
   properties: ['class_id', 'poly_id'],
   projection: GRID,
   scale: SCALE,
   geometries: false,
   tileScale: 8
 });

 var val15 = enriched.sampleRegions({
   collection: validation,
   properties: ['class_id'],
   projection: GRID,
   scale: SCALE,
   geometries: false,
   tileScale: 8
 });

 // Verify that original spectral predictors have not changed.

 var archiveTest = baseline
   .select(['red', 'NDVI'])
   .sampleRegions({

     collection: training.map(function(f) {
       return f
         .set('arch_red', f.get('red'))
         .set('arch_NDVI', f.get('NDVI'));
     }),

     properties: [
       'arch_red',
       'arch_NDVI'
     ],

     projection: GRID,
     scale: SCALE,
     geometries: false,
     tileScale: 8

   })
   .map(function(f) {

     return f

       .set(
         'red_err',
         ee.Number(f.get('red'))
           .subtract(
             ee.Number(f.get('arch_red'))
           )
           .abs()
       )

       .set(
         'ndvi_err',
         ee.Number(f.get('NDVI'))
           .subtract(
             ee.Number(f.get('arch_NDVI'))
           )
           .abs()
       );

   });

