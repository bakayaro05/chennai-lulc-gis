    projection:
      stackProjection,

    geometries:
      true,

    tileScale:
      4

  });


// ================================================================
// 12. CREATE AUTHORITATIVE PIXEL KEY
// ================================================================

manualSamples =
  manualSamples.map(
    function(feature) {

      var px =
        ee.Number(
          feature.get(
            'auth_px'
          )
        );


      var py =
        ee.Number(
          feature.get(
            'auth_py'
          )
        );


      var key =
        px.format(
          '%.0f'
        )
        .cat(
          '_'
        )
        .cat(
          py.format(
            '%.0f'
          )
        );


      return feature.set(
        'auth_pixel_key',
        key
      );

    }
  );


// ================================================================
// 13. REMOVE DUPLICATES INSIDE MANUAL POLYGONS
// ================================================================
//
// Protects against overlapping polygons or shared raster cells.
//
// ================================================================

var manualSamplesUnique =
  manualSamples.distinct(
    [
      'auth_pixel_key'
    ]
  );


// ================================================================
// 14. BUILD FINAL 2010 TRAINING 30 m EXCLUSION
// ================================================================

var trainingBuffers =
  training2010.map(
    function(feature) {

      return ee.Feature(
        feature
          .geometry()
          .buffer(
            TRAINING_EXCLUSION_METERS
          )
      );

    }
  );


var trainingExclusionGeometry =
  trainingBuffers.geometry();


// ================================================================
// 15. EXISTING AUTOMATIC-VALIDATION PIXEL KEYS
// ================================================================
