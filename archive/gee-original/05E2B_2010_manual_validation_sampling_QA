// Some 05E1 points may not have an auth_pixel_key property.
//
// Therefore create the key fresh from the authoritative 2010 grid.
//
// ================================================================

var existingValidationWithKeys =
  existingEligibleValidation.map(
    function(feature) {

      var xy =
        pixelXY.reduceRegion({

          reducer:
            ee.Reducer.first(),

          geometry:
            feature.geometry(),

          scale:
            SCALE,

          crs:
            stackProjection,

          maxPixels:
            10

        });


      var px =
        ee.Number(
          xy.get(
            'auth_px'
          )
        );


      var py =
        ee.Number(
          xy.get(
            'auth_py'
          )
        );


      var key =
        px.format(
          '%.0f'
        )
        .cat(
          '_'
        )
        .cat(
          py.format(
            '%.0f'
          )
        );


      return feature.set(
        'auth_pixel_key',
        key
      );

    }
  );


var existingValidationKeys =
  ee.List(
    existingValidationWithKeys.aggregate_array(
      'auth_pixel_key'
    )
  );


// ================================================================
// 16. APPLY HARD MANUAL-VALIDATION QA
// ================================================================
//
// Hard requirements:
//
// clear_count >= 2
// outside 30m training exclusion
// not same raster cell as existing accepted validation
//
// NO spectral classifier is used.
//
// ================================================================

var evaluatedManual =
  manualSamplesUnique.map(
    function(feature) {

      var clearCount =
        ee.Number(
          feature.get(
            'clear_count'
          )
        );


      var clearOkay =
        clearCount.gte(
          2
        );


      var trainingExcluded =
        ee.Number(
          ee.Algorithms.If(

            trainingExclusionGeometry.intersects(
              feature.geometry(),
              1
            ),

            1,

            0

          )
        );


      var existingValidationDuplicate =
        ee.Number(
          ee.Algorithms.If(

            existingValidationKeys.contains(
              feature.get(
                'auth_pixel_key'
              )
            ),

            1,

            0

          )
        );


      var eligible =
        clearOkay

          .and(
            trainingExcluded.eq(
              0
            )
          )

          .and(
            existingValidationDuplicate.eq(
              0
            )
          );


      return feature.set({

        flag_clear_ok:
          ee.Number(
            ee.Algorithms.If(
              clearOkay,
              1,
              0
            )
          ),

        training_excluded_30m:
          trainingExcluded,

        duplicate_existing_validation:
          existingValidationDuplicate,

        manual_validation_eligible:
          ee.Number(
            ee.Algorithms.If(
              eligible,
              1,
              0
            )
          )

      });

    }
  );


