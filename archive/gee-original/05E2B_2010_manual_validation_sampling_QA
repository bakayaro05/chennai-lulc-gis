// ================================================================
// 6. HELPER — CONVERT MULTIPOLYGON IMPORT TO FEATURES
// ================================================================
//
// Every separate drawn polygon gets its own manual poly_id.
//
// ID ranges:
//
// Built-up             401+
// Vegetation           411+
// Water                421+
// Agricultural/Open    431+
// Barren/Fallow        441+
//
// ================================================================

function geometryToFeatures(
  geometryImport,
  classId,
  className,
  startingPolyId,
  sourceName
) {

  var parts =
    ee.Geometry(
      geometryImport
    )
    .geometries();


  var n =
    parts.size();


  var indices =
    ee.List.sequence(
      0,
      n.subtract(
        1
      )
    );


  return ee.FeatureCollection(

    indices.map(
      function(index) {

        index =
          ee.Number(
            index
          );


        var geom =
          ee.Geometry(
            parts.get(
              index
            )
          );


        return ee.Feature(
          geom,
          {

            class_id:
              classId,

            class_name:
              className,

            poly_id:
              ee.Number(
                startingPolyId
              )
              .add(
                index
              ),

            manual_polygon_number:
              index.add(
                1
              ),

            validation_source:
              sourceName,

            target_year:
              2010

          }
        );

      }
    )

  );

}


