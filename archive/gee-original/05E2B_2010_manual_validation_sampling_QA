        var polygon =
          ee.Feature(
            allPolygonList.get(
              index
            )
          );


        var polyId =
          polygon.get(
            'poly_id'
          );


        var allPixels =
          evaluatedManual.filter(
            ee.Filter.eq(
              'poly_id',
              polyId
            )
          );


        var eligiblePixels =
          allPixels.filter(
            ee.Filter.eq(
              'manual_validation_eligible',
              1
            )
          );


        return ee.Feature(
          null,
          {

            class_id:
              polygon.get(
                'class_id'
              ),

            class_name:
              polygon.get(
                'class_name'
              ),

            poly_id:
              polyId,

            manual_polygon_number:
              polygon.get(
                'manual_polygon_number'
              ),

            sampled_n:
              allPixels.size(),

            low_clear_n:
              allPixels
                .filter(
                  ee.Filter.eq(
                    'flag_clear_ok',
                    0
                  )
                )
                .size(),

            training_excluded_n:
              allPixels
                .filter(
                  ee.Filter.eq(
                    'training_excluded_30m',
                    1
                  )
                )
                .size(),

            duplicate_existing_validation_n:
              allPixels
                .filter(
                  ee.Filter.eq(
                    'duplicate_existing_validation',
                    1
                  )
                )
                .size(),

            eligible_n:
              eligiblePixels.size(),

            mean_clear_count:
              eligiblePixels.aggregate_mean(
                'clear_count'
              )

          }
        );

      }
    )

  );


