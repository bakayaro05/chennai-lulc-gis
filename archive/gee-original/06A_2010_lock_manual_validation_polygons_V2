// ================================================================
// 2. OUTPUT ASSET
// ================================================================

var OUTPUT_ASSET =
  'projects/assignment-482806/assets/' +
  'chennai_validation_polygons_2010_manual_master';


// ================================================================
// 3. HELPER — MULTIPOLYGON TO FEATURE COLLECTION
// ================================================================

function geometryToFeatures(
  geometryImport,
  classId,
  className,
  startingPolyId
) {

  var parts =
    ee.Geometry(
      geometryImport
    )
    .geometries();


  var count =
    parts.size();


  var indices =
    ee.List.sequence(
      0,
      count.subtract(1)
    );


  return ee.FeatureCollection(

    indices.map(
      function(index) {

        index =
          ee.Number(index);


        var geometry =
          ee.Geometry(
            parts.get(index)
          );


        return ee.Feature(
          geometry,
          {

            class_id:
              classId,

            class_name:
              className,

            val_poly_id:
              ee.Number(
                startingPolyId
              )
              .add(index),

            manual_polygon_number:
              index.add(1),

            reference_year:
              2010,

            source:
              'manual_2010_validation_polygon',

            workflow:
              '2010_manualV2'

          }
        );

      }
    )

  );

}


