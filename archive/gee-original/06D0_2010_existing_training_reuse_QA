// ============================================================================
// 06D0_2010_existing_training_reuse_QA
// ============================================================================
//
// PURPOSE
// -------
// Before drawing any NEW 2010 training polygons, recover and QA legitimate
// TRAINING-SIDE material that already exists from the earlier automated /
// semi-automated 2010 workflow.
//
// IMPORTANT
// ---------
// This script:
//
// 1. Reconstructs the authoritative 06C2 manually-reviewed ACCEPTED pool
//    directly from the materialized 05A transfer QA asset.
//
// 2. Does NOT include:
//      Built-up poly_id 11  -> PARTIAL
//      Barren poly_id 62    -> PARTIAL
//      Barren poly_id 61    -> REJECT
//
// 3. Reuses only TRAINING-SIDE historical assets:
//      05C1 re-QA Pass-B candidates
//      05C2A rescued uncertain candidates
//      05C3A targeted expansion candidates
//      05C4E manual Barren training addition
//
// 4. Does NOT use validation data.
//
// 5. Re-samples every location against the authoritative materialized
//    2010 predictor stack.
//
// 6. Requires clear_count >= 2.
//
// 7. Snaps everything to the authoritative 30 m EPSG:32644 grid.
//
// 8. Removes:
//      same-class duplicates
//      reuse pixels already represented in 06C2
//      cross-class conflicts
//
// 9. Reports what genuine training deficits remain.
//
// 10. CREATES NO EXPORT.
//
// DO NOT BALANCE TO 120/CLASS IN THIS SCRIPT.
// DO NOT START DRAWING NEW POLYGONS UNTIL THIS QA IS REVIEWED.
//
// ============================================================================


// ============================================================================
// 1. LOCKED CONSTANTS
// ============================================================================

var CRS =
  'EPSG:32644';

var SCALE =
  30;

var TARGET_PER_CLASS =
  120;

var PROJ =
  ee.Projection(CRS)
    .atScale(SCALE);

var PREDICTORS = [
  'blue',
  'green',
  'red',
  'nir',
  'swir1',
  'swir2',
  'NDVI',
  'NDWI',
  'NDBI'
];

var CLASS_IDS =
  ee.List.sequence(1, 5);

var CLASS_NAMES =
  ee.Dictionary({
    '1': 'Built-up',
    '2': 'Vegetation',
    '3': 'Water',
    '4': 'Agricultural/Open',
    '5': 'Barren/Fallow'
  });


// ============================================================================
// 2. ASSETS
// ============================================================================

var ROI_ASSET =
  'projects/assignment-482806/assets/chennai_admin_study_area_clean';

var STACK_2010_ASSET =
  'projects/assignment-482806/assets/chennai_predictor_stack_2010';

var QA05A_ASSET =
  'projects/assignment-482806/assets/chennai_transfer_2015_to_2010_QA_05A';

var PASSB_05C1_ASSET =
  'projects/assignment-482806/assets/chennai_2010_passB_reQA_05C1';

var RESCUED_05C2A_ASSET =
  'projects/assignment-482806/assets/chennai_2010_rescued_uncertain_05C2A';

var EXPANSION_05C3A_ASSET =
  'projects/assignment-482806/assets/chennai_2010_targeted_expansion_05C3A';

var MANUAL_BARREN_05C4E_ASSET =
  'projects/assignment-482806/assets/chennai_2010_manual_barren_05C4E';


// ============================================================================
// 3. LOAD MATERIALIZED DATA
// ============================================================================

var studyArea =
  ee.FeatureCollection(
    ROI_ASSET
  );

var roi =
  studyArea.geometry();

var stack2010 =
  ee.Image(
    STACK_2010_ASSET
  );

var qa05A =
  ee.FeatureCollection(
    QA05A_ASSET
  );

var passB05C1 =
  ee.FeatureCollection(
    PASSB_05C1_ASSET
  );

var rescued05C2A =
  ee.FeatureCollection(
    RESCUED_05C2A_ASSET
  );

var expansion05C3A =
  ee.FeatureCollection(
    EXPANSION_05C3A_ASSET
  );

var manualBarren05C4E =
  ee.FeatureCollection(
    MANUAL_BARREN_05C4E_ASSET
  );


// ============================================================================
// 4. AUTHORITATIVE GRID COORDINATES
// ============================================================================
//
// These x/y coordinates define the exact analytical 30 m pixel.
// We use them to generate an authoritative pixel key.
//
// ============================================================================

var pixelCoords =
  ee.Image.pixelCoordinates(
    PROJ
  )
  .rename([
    'px',
    'py'
  ]);

var sampleImage =
  stack2010
    .select(
      PREDICTORS.concat([
        'clear_count'
      ])
    )
    .addBands(
      pixelCoords
    );


// ============================================================================
// 5. HELPERS
// ============================================================================

function classNameFromId(classId) {

  return ee.String(
    CLASS_NAMES.get(
      ee.Number(classId)
        .format('%d')
    )
  );

}


function addSourceKey(feature) {

  feature =
    ee.Feature(feature);

  var classId =
    ee.Number(
      feature.get('class_id')
    )
    .int();

  var polyId =
    ee.Number(
      feature.get('poly_id')
    )
    .int();

  var key =
    classId
      .format('%d')
      .cat('_')
      .cat(
        polyId.format('%d')
      );

  return feature.set({
    class_id:
      classId,

    class_name:
      classNameFromId(classId),

    poly_id:
      polyId,

    class_poly_key:
      key
  });

}


function addPixelKeys(feature) {

  feature =
    ee.Feature(feature);

  var px =
    ee.Number(
      feature.get('px')
    );

  var py =
    ee.Number(
      feature.get('py')
    );

  var classId =
    ee.Number(
      feature.get('class_id')
    )
    .int();

  // ----------------------------------------------------------
  // IMPORTANT:
  //
  // pixelCoordinates() can return floating coordinates such as
  // 48117.5 on this 30 m analytical projection.
  //
  // Therefore DO NOT format px / py using %d.
  //
  // Preserve the authoritative grid coordinate as a decimal
  // string. Six decimals is far more precision than required
  // for distinguishing these grid cells.
  // ----------------------------------------------------------

  var pxString =
    px.format('%.6f');

  var pyString =
    py.format('%.6f');

  var classString =
    classId.format('%d');

  var pixelKey =
    pxString
      .cat('_')
      .cat(
        pyString
      );

  var pixelClassKey =
    classString
      .cat('_')
      .cat(
        pixelKey
      );

  return feature.set({
    auth_pixel_key:
      pixelKey,

    pixel_class_key:
      pixelClassKey
  });

}


function normalizeTrainingAsset(
  collection,
  sourceLabel
) {

  return ee.FeatureCollection(
    collection
  )
  .map(
    function(feature) {

      feature =
        addSourceKey(feature);

      return feature.set(
        'reuse_asset',
        sourceLabel
      );

    }
  );

}


function sampleOnAuthoritativeStack(
  collection
) {

  var sampled =
    sampleImage.sampleRegions({

      collection:
        collection,

      properties: [
        'class_id',
        'class_name',
        'poly_id',
        'class_poly_key',
        'reuse_asset'
      ],

      scale:
        SCALE,

      projection:
        PROJ,

      geometries:
        true,

      tileScale:
        8
    });

  return sampled
    .filter(
      ee.Filter.gte(
        'clear_count',
        2
      )
    )
    .map(
      addPixelKeys
    );

}


// ============================================================================
// 6. FINAL 06B / 06C2 MANUAL DECISION LEDGER
// ============================================================================
//
// These are the CURRENT authoritative ACCEPT decisions.
//
// Built-up:
// ACCEPT = 1,3,4,5,6,7,8,9,12
// PARTIAL = 11
