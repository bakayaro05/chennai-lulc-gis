// ============================================================================
// 11. APPLY NEW 06B MANUAL SOURCE-GROUP DECISIONS
// ============================================================================
//
// Very important:
//
// A historically automated candidate is NOT automatically retained.
//
// It must belong to one of the source groups we now ACCEPTED.
//
// Therefore candidates originating from:
//
// Built-up poly 11 -> excluded
// Barren poly 62   -> excluded
//
// Any rejected source groups are also excluded.
//
// ============================================================================

var automatedReuseApprovedSources =
  automatedReuseRaw.filter(
    ee.Filter.inList(
      'class_poly_key',
      ACCEPTED_SOURCE_KEYS
    )
  );


// ============================================================================
// 12. RE-SAMPLE AUTOMATED REUSE LOCATIONS
// ============================================================================

var automatedReuseEligible =
  sampleOnAuthoritativeStack(
    automatedReuseApprovedSources
  );


// ============================================================================
// 13. PREPARE 05C4E MANUAL BARREN TRAINING ADDITION
// ============================================================================
//
// 05C4E is a TRAINING-SIDE manual addition.
//
// It is NOT one of the transferred 2015 source groups and therefore is
// allowed independently of the 06B source poly_id ledger.
//
// We force:
// class_id = 5
// poly_id  = 304
//
// This keeps its provenance explicit.
//
// ============================================================================

var manualBarrenPrepared =
  manualBarren05C4E.map(
    function(feature) {

      return ee.Feature(feature).set({
        class_id:
          5,

        class_name:
          'Barren/Fallow',

        poly_id:
          304,

        class_poly_key:
          '5_304',

        reuse_asset:
          '05C4E_manual_barren_training'
      });

    }
  );

var manualBarrenEligible =
  sampleOnAuthoritativeStack(
    manualBarrenPrepared
  );


// ============================================================================
// 14. MERGE ALL REUSE CANDIDATES
// ============================================================================

var reuseEligibleRaw =
  automatedReuseEligible
    .merge(
      manualBarrenEligible
    );


// ============================================================================
// 15. REMOVE SAME-CLASS DUPLICATES
// ============================================================================

var reuseDistinctClass =
  reuseEligibleRaw.distinct([
    'pixel_class_key'
  ]);


// ============================================================================
// 16. REMOVE ANY REUSE PIXEL ALREADY PRESENT IN 06C2
// ============================================================================
//
// 06C2 manual-review accepted data have priority.
//
// We remove reuse pixels that occupy the same authoritative pixel,
// regardless of their historical source.
//
// ============================================================================

var samePixelFilter =
  ee.Filter.equals({
    leftField:
      'auth_pixel_key',

    rightField:
      'auth_pixel_key'
  });

var reuseNotAlreadyIn06C2 =
  ee.FeatureCollection(

    ee.Join.inverted().apply(

      reuseDistinctClass,

      base06C2,

      samePixelFilter
    )

  );


// ============================================================================
// 17. DETECT CROSS-CLASS CONFLICTS INSIDE REUSE POOL
// ============================================================================

var reusePixelKeys =
  ee.List(
    reuseNotAlreadyIn06C2
      .aggregate_array(
        'auth_pixel_key'
      )
  )
  .distinct();

var reuseConflictSummary =
  ee.FeatureCollection(

    reusePixelKeys.map(
      function(pixelKey) {

        pixelKey =
          ee.String(pixelKey);

        var atPixel =
          reuseNotAlreadyIn06C2.filter(
            ee.Filter.eq(
              'auth_pixel_key',
              pixelKey
            )
          );

        var classes =
          ee.List(
            atPixel.aggregate_array(
              'class_id'
            )
          )
          .distinct();

        return ee.Feature(
          null,
          {
            auth_pixel_key:
              pixelKey,

            row_n:
              atPixel.size(),

            class_count:
              classes.size(),

            classes:
              classes
          }
        );

      }
    )
  );

var reuseConflicts =
  reuseConflictSummary.filter(
    ee.Filter.gt(
      'class_count',
      1
    )
  );


// ============================================================================
// 18. REMOVE CROSS-CLASS CONFLICTING REUSE PIXELS
// ============================================================================

var reuseClean =
  ee.FeatureCollection(

    ee.Join.inverted().apply(

      reuseNotAlreadyIn06C2,

      reuseConflicts,

      samePixelFilter
    )

  );


// ============================================================================
// 19. BUILD COMPLETE TRAINING CANDIDATE POOL
// ============================================================================
//
// Still NOT balanced.
// Still NOT exported.
//
// ============================================================================

var consolidatedCandidatePool =
  base06C2
    .merge(
      reuseClean
    )
    .distinct([
      'pixel_class_key'
    ]);


// ============================================================================
// 20. FINAL CROSS-CLASS CONFLICT CHECK
// ============================================================================

var finalPixelKeys =
  ee.List(
    consolidatedCandidatePool
      .aggregate_array(
        'auth_pixel_key'
      )
  )
  .distinct();

var finalConflictSummary =
  ee.FeatureCollection(

    finalPixelKeys.map(
      function(pixelKey) {

        pixelKey =
          ee.String(pixelKey);

        var atPixel =
          consolidatedCandidatePool.filter(
            ee.Filter.eq(
              'auth_pixel_key',
              pixelKey
            )
          );

        var classes =
          ee.List(
            atPixel.aggregate_array(
              'class_id'
            )
          )
          .distinct();

        return ee.Feature(
          null,
          {
            auth_pixel_key:
              pixelKey,

            class_count:
              classes.size(),

            classes:
              classes,

            row_n:
              atPixel.size()
          }
        );

      }
    )
  );

var finalConflicts =
  finalConflictSummary.filter(
    ee.Filter.gt(
      'class_count',
      1
    )
  );


