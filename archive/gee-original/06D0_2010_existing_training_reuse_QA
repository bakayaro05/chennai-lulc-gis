  '1_1',
  '1_3',
  '1_4',
  '1_5',
  '1_6',
  '1_7',
  '1_8',
  '1_9',
  '1_12',

  // ----------------------------------------------------------
  // VEGETATION
  // ----------------------------------------------------------

  '2_16',
  '2_17',
  '2_25',
  '2_26',

  // ----------------------------------------------------------
  // WATER
  // ----------------------------------------------------------

  '3_31',
  '3_32',
  '3_35',
  '3_38',
  '3_39',
  '3_201',

  // ----------------------------------------------------------
  // AGRICULTURAL / OPEN
  // ----------------------------------------------------------

  '4_46',
  '4_47',
  '4_48',
  '4_51',
  '4_52',
  '4_53',
  '4_55',
  '4_56',
  '4_57',
  '4_59',
  '4_60',
  '4_202',

