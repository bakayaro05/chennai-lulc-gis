// ============================================================================

var qa05ANormalized =
  qa05A.map(
    addSourceKey
  );

var accepted06C2Source =
  qa05ANormalized
    .filter(
      ee.Filter.inList(
        'class_poly_key',
        ACCEPTED_SOURCE_KEYS
      )
    )
    .map(
      function(feature) {

        return ee.Feature(feature)
          .set(
            'reuse_asset',
            '06C2_manual_review_accepted'
          );

      }
    );

var base06C2 =
  sampleOnAuthoritativeStack(
    accepted06C2Source
  )
  .distinct([
    'pixel_class_key'
  ]);


