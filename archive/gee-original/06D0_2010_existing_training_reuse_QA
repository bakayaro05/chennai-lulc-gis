// ============================================================================
// 26. FINAL TRAINING FEASIBILITY
// ============================================================================

var finalFeasibility =
  ee.FeatureCollection(

    CLASS_IDS.map(
      function(classId) {

        classId =
          ee.Number(classId);

        var classPool =
          consolidatedCandidatePool.filter(
            ee.Filter.eq(
              'class_id',
              classId
            )
          );

        var n =
          classPool.size();

        var deficit =
          ee.Number(
            TARGET_PER_CLASS
          )
          .subtract(n)
          .max(0);

        var surplus =
          ee.Number(n)
            .subtract(
              TARGET_PER_CLASS
            )
            .max(0);

        var polyIds =
          ee.List(
            classPool.aggregate_array(
              'poly_id'
            )
          )
          .distinct()
          .sort();

        return ee.Feature(
          null,
          {
            class_id:
              classId,

            class_name:
              classNameFromId(
                classId
              ),

            available_unique_n:
              n,

            target_n:
              TARGET_PER_CLASS,

            deficit:
              deficit,

            surplus:
              surplus,

            sufficient:
              n.gte(
                TARGET_PER_CLASS
              ),

            distinct_poly_id_n:
              polyIds.size(),

            poly_ids:
              polyIds,

            poly_id_histogram:
              classPool.aggregate_histogram(
                'poly_id'
              )
          }
        );

